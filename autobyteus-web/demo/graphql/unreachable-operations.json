{
  "_comment": "autobyteus-279: GraphQL operations compiled into the demo build (dist-mobile-demo/public) that the phone never sends, each with its reason. The demo build fails on a compiled operation that has neither a demo handler (demo/graphql/operations.ts) nor an entry here (scripts/mobile-build-checks.mjs).",
  "reasons": {
    "settings": "Desktop Settings and notifications (providers, agent runtimes, server settings, updates, embedding, MCP servers, integrations, model routing, app data migrations): the phone has no Settings page for its node (desktopSettings is not a phone feature).",
    "definitions": "Agent, Team and Org definitions, their packages, customization options and problems: edited on the desktop pages /agents, /agent-teams and /agent-orgs only; the phone reads definitions with GetAgentDefinitions, GetAgentTeamDefinitions and GetAgentOrgDefinitions.",
    "skills": "Skills and skill sources: the desktop page /skills only.",
    "applications": "Applications: the desktop pages /applications only.",
    "projects": "Projects and Project Tasks: the desktop pages /projects only; the phone shows a run's Tasks with GetTaskWorkerTasks.",
    "memory": "Memory explorer, search, views, sync and work journals: the desktop page /memory only.",
    "tokenUsage": "Token usage meters, statistics and analytics: desktop only.",
    "peers": "Peer nodes and invites: desktop Settings only; the demo node has no peers.",
    "runAdmin": "Archiving or deleting stored runs and removing a workspace: the phone's run list and run menu have neither.",
    "fileEditing": "Writing, creating, moving, renaming or deleting files: the phone's Files and Artifacts are read-only (DC-011).",
    "teamOrgLaunch": "Starting a Team or Org run: the phone's New run starts an agent run only (DEC-007).",
    "desktopPages": "Desktop-only views: the Tools page and the workspace history panel (RunSectionPanel); the phone reads its history with ListWorkspaceRunHistory.",
    "tracePages": "Earlier trace pages: read only when a projection reports earlier trace events, and the demo's projections never do (hasEarlierActiveTraceEvents: false).",
    "cancelPrepared": "Cancelling a prepared run: only when its first message fails to reach the run; the demo node takes every message.",
    "registeredWorkspace": "A folder's metadata: read only for a folder the node's workspace list lacks; every demo run works in demo-workspace, which the list has.",
    "staticCatalog": "Reloading a provider's catalog: only for discovered providers (Ollama, LM Studio, custom endpoints); the demo's one provider is static."
  },
