generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TokenUsageLedgerEvent {
  id                                   Int       @id @default(autoincrement())
  usageEventId                         String    @unique @map("usage_event_id")
  idempotencyKey                       String    @unique @map("idempotency_key")
  observedAt                           DateTime  @map("observed_at")
  persistedAt                          DateTime  @default(now()) @map("persisted_at")
  runId                                String    @map("run_id")
  turnId                               String?   @map("turn_id")
  llmCallId                            String?   @map("llm_call_id")
  callSequence                         Int?      @map("call_sequence")
  rootTeamRunId                        String?   @map("root_team_run_id")
  teamRunPathJson                      String?   @map("team_run_path_json")
  memberAgentRunId                     String?   @map("member_agent_run_id")
  memberPathJson                       String?   @map("member_path_json")
  memberRouteKey                       String?   @map("member_route_key")
  agentDefinitionId                    String?   @map("agent_definition_id")
  workspaceId                          String?   @map("workspace_id")
  taskAgentInstanceId                  String?   @map("task_agent_instance_id")
  taskAgentRunId                       String?   @map("task_agent_run_id")
  taskId                               String?   @map("task_id")
  teamName                             String?   @map("team_name")
  agentName                            String?   @map("agent_name")
  runSummary                           String?   @map("run_summary")
  runCreatedAt                         DateTime? @map("run_created_at")
  memberName                           String?   @map("member_name")
  runtimeKind                          String    @map("runtime_kind")
  modelProvider                        String?   @map("model_provider")
  modelIdentifier                      String?   @map("model_identifier")
  modelValue                           String?   @map("model_value")
  ingestionKind                        String    @map("ingestion_kind")
  usageScope                           String    @map("usage_scope")
  snapshotSeriesKey                    String?   @map("snapshot_series_key")
  previousSnapshotEventId              String?   @map("previous_snapshot_event_id")
  inputTokenSemantic                   String    @default("unknown") @map("input_token_semantic")
  reportedInputTokens                  Int?      @map("reported_input_tokens")
  reportedOutputTokens                 Int?      @map("reported_output_tokens")
  reportedTotalTokens                  Int?      @map("reported_total_tokens")
  accountingInputTokens                Int?      @map("accounting_input_tokens")
  accountingOutputTokens               Int?      @map("accounting_output_tokens")
  accountingTotalTokens                Int?      @map("accounting_total_tokens")
  standardInputTokens                  Int?      @map("standard_input_tokens")
  cacheMissInputTokens                 Int?      @map("cache_miss_input_tokens")
  cacheReadInputTokens                 Int?      @map("cache_read_input_tokens")
  cacheCreationInputTokens             Int?      @map("cache_creation_input_tokens")
  cacheCreation5mInputTokens           Int?      @map("cache_creation_5m_input_tokens")
  cacheCreation1hInputTokens           Int?      @map("cache_creation_1h_input_tokens")
  cacheState                           String    @default("unknown") @map("cache_state")
  reasoningOutputTokens                Int?      @map("reasoning_output_tokens")
  billableInputTokens                  Int?      @map("billable_input_tokens")
  billableOutputTokens                 Int?      @map("billable_output_tokens")
  rawUsageJson                         String?   @map("raw_usage_json")
  rawEventJson                         String?   @map("raw_event_json")
  qualityFlagsJson                     String?   @map("quality_flags_json")
  costBasis                            String?   @map("cost_basis")
  currency                             String?
  inputPricePerMillion                 Float?    @map("input_price_per_million")
  outputPricePerMillion                Float?    @map("output_price_per_million")
  cachedInputReadPricePerMillion       Float?    @map("cached_input_read_price_per_million")
  cachedInputWritePricePerMillion      Float?    @map("cached_input_write_price_per_million")
  cachedInputWrite5mPricePerMillion    Float?    @map("cached_input_write_5m_price_per_million")
  cachedInputWrite1hPricePerMillion    Float?    @map("cached_input_write_1h_price_per_million")
  pricingSource                        String?   @map("pricing_source")
  pricingStatus                        String    @map("pricing_status")
  pricingMissingReason                 String?   @map("pricing_missing_reason")
  pricingSnapshotJson                  String?   @map("pricing_snapshot_json")
  pricingPolicyKey                     String?   @map("pricing_policy_key")
  selectedPricingTierId                String?   @map("selected_pricing_tier_id")
  missingPriceDimensionsJson           String?   @map("missing_price_dimensions_json")
  estimatedApiInputCost                Float?    @map("estimated_api_input_cost")
  estimatedApiStandardInputCost        Float?    @map("estimated_api_standard_input_cost")
  estimatedApiCacheReadInputCost       Float?    @map("estimated_api_cache_read_input_cost")
  estimatedApiCacheCreationInputCost   Float?    @map("estimated_api_cache_creation_input_cost")
  estimatedApiCacheCreation5mInputCost Float?    @map("estimated_api_cache_creation_5m_input_cost")
  estimatedApiCacheCreation1hInputCost Float?    @map("estimated_api_cache_creation_1h_input_cost")
  estimatedApiOutputCost               Float?    @map("estimated_api_output_cost")
  estimatedApiReasoningOutputCost      Float?    @map("estimated_api_reasoning_output_cost")
  estimatedApiTotalCost                Float?    @map("estimated_api_total_cost")
  apiCostStatus                        String    @map("api_cost_status")
  latestPromptTokens                   Int?      @map("latest_prompt_tokens")
  effectiveContextWindowTokens         Int?      @map("effective_context_window_tokens")
  contextWindowUsagePercent            Float?    @map("context_window_usage_percent")

  @@index([runId, observedAt])
  @@index([rootTeamRunId, observedAt])
  @@index([snapshotSeriesKey, runId, observedAt])
  @@map("token_usage_ledger_events")
}

model AgentArtifact {
  id            Int      @id @default(autoincrement())
  runId         String   @map("agent_id")
  path          String
  type          String
  workspaceRoot String?  @map("workspace_root")
  url           String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([runId])
  @@map("agent_artifacts")
}

model AppDataMigrationRecord {
  id           Int       @id @default(autoincrement())
  migrationId  String    @unique @map("migration_id")
  displayName  String    @map("display_name")
  status       String
  attempts     Int       @default(0)
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  summaryJson  String?   @map("summary_json")
  errorMessage String?   @map("error_message")
  logPath      String?   @map("log_path")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("app_data_migration_records")
}
