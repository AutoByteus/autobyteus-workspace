{
  "name": "autobyteus-server-ts",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare:shared": "pnpm -C .. --filter autobyteus-ts --filter @autobyteus/application-sdk-contracts --filter @autobyteus/application-backend-sdk build",
    "prebuild": "pnpm prepare:shared && pnpm exec prisma generate --schema ./prisma/schema.prisma",
    "build": "pnpm run build:full",
    "build:full": "node ./scripts/clean-build-output.mjs && tsc -p tsconfig.build.json && node ./scripts/copy-build-assets.mjs && node ./scripts/run-sanitized-built-in-agents-bootstrap-smoke.mjs",
    "pretypecheck": "pnpm prepare:shared",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:claude-interrupt-resume-e2e": "pnpm prepare:shared && tsc -p tsconfig.claude-interrupt-resume-e2e.json --noEmit",
    "pretest": "pnpm prepare:shared",
    "test": "vitest",
    "test:unit": "vitest run tests/unit tests/app-data-migrations --exclude \"**/*.integration.test.ts\"",
    "test:integration": "node ./scripts/integration-test-prerequisites.mjs check && vitest run tests/integration .integration.test.ts",
    "test:integration:prepare": "node ./scripts/integration-test-prerequisites.mjs prepare",
    "cleanup:codex-e2e-history": "node ./scripts/cleanup-codex-e2e-run-history.mjs",
    "test:e2e:prisma-engine-discovery:docker": "node tests/e2e/startup/prisma-engine-discovery.docker.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@anthropic-ai/sdk": "0.132.1",
    "@autobyteus/application-sdk-contracts": "workspace:*",
    "@autobyteus/agent-presentation-contracts": "workspace:*",
    "@autobyteus/collaboration-stream-contracts": "workspace:*",
    "@autobyteus/team-stream-contracts": "workspace:*",
    "ajv": "^8.17.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/websocket": "^10.0.1",
    "@huggingface/tokenizers": "0.2.0",
    "@prisma/client": "^5.22.0",
    "autobyteus-ts": "workspace:*",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^4.29.1",
    "fuzzysort": "^2.0.4",
    "graphql": "^16.12.0",
    "graphql-scalars": "^1.25.0",
    "ignore": "^7.0.5",
    "mercurius": "^13.1.0",
    "mime-types": "^3.0.2",
    "onnxruntime-web": "1.30.0",
    "reflect-metadata": "^0.2.2",
    "repository_prisma": "^1.0.10",
    "tar": "7.5.22",
    "type-graphql": "^2.0.0-rc.4",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.0.10",
    "@types/ws": "8.18.1",
    "@vue/compiler-sfc": "^3.5.28",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.1.12",
    "ws": "^8.22.0"
  },
  "license": "AGPL-3.0-only"
}
