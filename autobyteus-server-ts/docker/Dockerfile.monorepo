# syntax=docker/dockerfile:1

# The chrome-vnc base image, pinned by digest. system-level.json lists the digest of each base
# variant; the zh release passes its digest, and check-system-level.mjs keeps this default equal
# to baseImages.default.
ARG BASE_IMAGE_DIGEST=sha256:b2fde77f3bd7c73d412ea59d42e3b65290bae9f39d1ce85b5aaaac5d869596f4
ARG CODEX_CLI_VERSION=latest
ARG CLAUDE_CODE_VERSION=latest

FROM node:22-bookworm AS builder
WORKDIR /app

RUN corepack enable
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PUPPETEER_SKIP_DOWNLOAD=1

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY autobyteus-ts/package.json autobyteus-ts/tsconfig.build.json autobyteus-ts/tsconfig.json ./autobyteus-ts/
COPY autobyteus-ts/scripts ./autobyteus-ts/scripts
COPY autobyteus-application-sdk-contracts/package.json autobyteus-application-sdk-contracts/tsconfig.build.json autobyteus-application-sdk-contracts/tsconfig.json ./autobyteus-application-sdk-contracts/
COPY autobyteus-application-backend-sdk/package.json autobyteus-application-backend-sdk/tsconfig.build.json autobyteus-application-backend-sdk/tsconfig.json ./autobyteus-application-backend-sdk/
COPY autobyteus-agent-presentation-contracts/package.json autobyteus-agent-presentation-contracts/tsconfig.build.json autobyteus-agent-presentation-contracts/tsconfig.json ./autobyteus-agent-presentation-contracts/
COPY autobyteus-collaboration-stream-contracts/package.json autobyteus-collaboration-stream-contracts/tsconfig.build.json autobyteus-collaboration-stream-contracts/tsconfig.json ./autobyteus-collaboration-stream-contracts/
COPY autobyteus-team-stream-contracts/package.json autobyteus-team-stream-contracts/tsconfig.build.json autobyteus-team-stream-contracts/tsconfig.json ./autobyteus-team-stream-contracts/
COPY autobyteus-server-ts/package.json autobyteus-server-ts/tsconfig.json ./autobyteus-server-ts/
COPY autobyteus-web/package.json ./autobyteus-web/

RUN pnpm install --no-frozen-lockfile

COPY autobyteus-ts ./autobyteus-ts
COPY autobyteus-application-sdk-contracts ./autobyteus-application-sdk-contracts
COPY autobyteus-application-backend-sdk ./autobyteus-application-backend-sdk
COPY autobyteus-agent-presentation-contracts ./autobyteus-agent-presentation-contracts
COPY autobyteus-collaboration-stream-contracts ./autobyteus-collaboration-stream-contracts
COPY autobyteus-team-stream-contracts ./autobyteus-team-stream-contracts
COPY autobyteus-server-ts ./autobyteus-server-ts
COPY autobyteus-web ./autobyteus-web

RUN pnpm -C autobyteus-agent-presentation-contracts build
RUN pnpm -C autobyteus-collaboration-stream-contracts build
RUN pnpm -C autobyteus-team-stream-contracts build
RUN pnpm -C autobyteus-server-ts exec prisma generate --schema prisma/schema.prisma
RUN pnpm -C autobyteus-server-ts build
RUN pnpm -C autobyteus-web build:mobile-web

# The server package: the deployed server with its own node_modules (native modules built for this
# Node and architecture), its Prisma client, the mobile web and server-package.json. The image
# carries it as its built-in server package; the release publishes the same folder per architecture.
# The deploy links the server itself into node_modules/.pnpm/node_modules, pointing back at its
# workspace folder outside the package; that link is removed (nothing resolves the server by name).
COPY scripts/server-package ./scripts/server-package
RUN pnpm --filter autobyteus-server-ts deploy /out/server-package --legacy \
  && cd /out/server-package \
  && rm node_modules/.pnpm/node_modules/autobyteus-server-ts \
  && node_modules/.bin/prisma generate --schema prisma/schema.prisma \
  && node /app/autobyteus-web/scripts/onnxruntime-web-packaging.mjs /out/server-package \
  && cp -r /app/autobyteus-web/dist-mobile/public /out/server-package/mobile-web \
  && node /app/scripts/server-package/describe-server-package.mjs package-json \
    --package-dir /out/server-package \
    --version "$(node -p "require('/app/autobyteus-web/package.json').version")" \
    --system-level-file /app/autobyteus-server-ts/docker/system-level.json \
  && node -p "require('/app/autobyteus-server-ts/docker/system-level.json').level" > /out/system-level

FROM scratch AS server-package
COPY --from=builder /out/server-package /

FROM autobyteus/chrome-vnc@${BASE_IMAGE_DIGEST} AS runtime

ARG CODEX_CLI_VERSION
ARG CLAUDE_CODE_VERSION
ARG CLI_INSTALL_CACHE_BUSTER=0

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ripgrep curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Keep provider setup writes out of the persisted runtime home. Verify native
# payloads explicitly: both upstream installers can report success after failures.
# The Antigravity installer is served with Content-Encoding: gzip even without
# Accept-Encoding, so curl must decode it (--compressed) and the saved file must
# be the shell script before it runs.
RUN echo "CLI install cache buster: ${CLI_INSTALL_CACHE_BUSTER}" \
  && npm install -g \
  "@openai/codex@${CODEX_CLI_VERSION}" \
  "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
  && cli_scratch="$(mktemp -d)" \
  && mkdir -p "${cli_scratch}/home" "${cli_scratch}/agy-bin" \
  && GROK_HOME="${cli_scratch}/grok" npm install -g --include=optional --ignore-scripts=false "@xai-official/grok@latest" \
  && curl -fsSL --compressed https://antigravity.google/cli/install.sh -o "${cli_scratch}/agy-install.sh" \
  && test "$(head -c 2 "${cli_scratch}/agy-install.sh")" = '#!' \
  && HOME="${cli_scratch}/home" bash "${cli_scratch}/agy-install.sh" --dir "${cli_scratch}/agy-bin" \
  && test -x "${cli_scratch}/agy-bin/agy" \
  && agy_version="$(HOME="${cli_scratch}/home" timeout 30s "${cli_scratch}/agy-bin/agy" --version)" \
  && printf '%s\n' "$agy_version" | grep -E '[0-9]+\.[0-9]+\.[0-9]+' \
  && install -m 0755 "${cli_scratch}/agy-bin/agy" /usr/local/bin/agy \
  && rm -rf "$cli_scratch" \
  && grok_native="$(readlink -f "$(command -v grok)")" \
  && test "$grok_native" = "$(npm root -g)/@xai-official/grok/bin/grok-native" \
  && test -x "$grok_native" \
  && test "$(od -An -tx1 -N4 "$grok_native" | tr -d ' \n')" = '7f454c46' \
  && test "$(command -v agy)" = /usr/local/bin/agy \
  && probe_home="$(mktemp -d)" \
  && agy_version="$(HOME="$probe_home" timeout 30s agy --version)" \
  && grok_version="$(HOME="$probe_home" timeout 30s grok --version)" \
  && printf 'Installed agy: %s\n' "$agy_version" \
  && printf '%s\n' "$agy_version" | grep -E '[0-9]+\.[0-9]+\.[0-9]+' \
  && printf 'Installed grok: %s\n' "$grok_version" \
  && printf '%s\n' "$grok_version" | grep -E '[0-9]+\.[0-9]+\.[0-9]+' \
  && rm -rf "$probe_home"

# ---- end of the system part (system-level.json) ----

WORKDIR /app

# AutoByteus licence files and OCI licence label.
COPY LICENSE LICENSING.md NOTICE /app/
LABEL org.opencontainers.image.licenses="AGPL-3.0-only"

RUN mkdir -p /home/autobyteus/workspace /home/autobyteus/data /home/autobyteus/server-packages /root

# The starter runs the node's server package (built-in or installed in <node>-server-packages),
# reads what this image provides from /opt/autobyteus/system-level, and accepts only server packages
# whose descriptions are signed for the public key it carries.
COPY --from=server-package / /opt/autobyteus/server-package
COPY --from=builder /out/system-level /opt/autobyteus/system-level
COPY autobyteus-server-ts/docker/starter/*.mjs /opt/autobyteus/starter/
COPY autobyteus-server-ts/docker/server-package-signing-key.pem /opt/autobyteus/starter/server-package-signing-key.pem
COPY autobyteus-server-ts/docker/supervisor-autobyteus-server.conf /etc/supervisor/conf.d/supervisor-autobyteus-server.conf
COPY autobyteus-server-ts/docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY autobyteus-server-ts/docker/open-vnc-browser-url.sh /usr/local/bin/open-vnc-browser-url.sh
COPY autobyteus-server-ts/docker/xdg-open-root-bridge.sh /usr/local/bin/xdg-open
COPY autobyteus-server-ts/docker/exo-open-root-bridge.sh /usr/local/bin/exo-open
RUN chmod +x \
  /usr/local/bin/entrypoint.sh \
  /usr/local/bin/open-vnc-browser-url.sh \
  /usr/local/bin/xdg-open \
  /usr/local/bin/exo-open

ENV NODE_ENV=production \
    BROWSER=/usr/local/bin/open-vnc-browser-url.sh \
    HOME=/root \
    AUTOBYTEUS_BIND_HOST=0.0.0.0 \
    AUTOBYTEUS_SERVER_PORT=8000 \
    AUTOBYTEUS_DATA_DIR=/home/autobyteus/data

EXPOSE 8000 5900 6080 9223

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
