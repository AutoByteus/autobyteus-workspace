{
  "name": "autobyteus-web-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated current-experience UI prototype for AutoByteus Web",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p tsconfig.prototype.json",
    "lint": "eslint prototype/scripts prototype/shared prototype/source-observation plugins/00.prototype-state.client.ts plugins/10.prototype-host-bootstrap.client.ts prototype/tests",
    "test": "vitest run",
    "fixtures:build": "node prototype/scripts/build-runtime-fixtures.mjs",
    "fixtures:capture-source": "node prototype/scripts/dump-source-state.mjs",
    "source-observation:start": "node prototype/source-observation/mock-node.mjs",
    "validate:boundaries": "node prototype/scripts/validate-boundaries.mjs",
    "validate:browser": "node prototype/scripts/validate-browser.mjs",
    "validate:correction-journeys": "node prototype/scripts/validate-correction-journeys.mjs",
    "validate:gap-009": "node prototype/scripts/validate-gap-009.mjs",
    "capture:parity": "node prototype/scripts/capture-parity.mjs",
    "capture:correction": "node prototype/scripts/capture-correction-parity.mjs",
    "capture:correction-matrix": "CORRECTION_MATRIX=1 node prototype/scripts/capture-correction-parity.mjs",
    "capture:matrix": "node prototype/scripts/capture-route-matrix.mjs",
    "capture:final-references": "node prototype/scripts/capture-final-references.mjs",
    "validate:final-package": "node prototype/scripts/validate-final-package.mjs",
    "validate:repository-placement": "node prototype/scripts/validate-repository-placement.mjs",
    "audit:presentation": "node prototype/scripts/audit-presentation-parity.mjs",
    "audit:interactions": "node prototype/scripts/audit-interaction-discovery.mjs",
    "validate:gap-009-package": "node prototype/scripts/validate-gap-009-package.mjs"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@autobyteus/application-sdk-contracts": "file:vendor/autobyteus-application-sdk-contracts",
    "@autobyteus/team-stream-contracts": "file:vendor/autobyteus-team-stream-contracts",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@iconify/vue": "^5.0.0",
    "@mdit/plugin-katex": "^0.23.2",
    "@monaco-editor/loader": "^1.4.0",
    "@novnc/novnc": "1.7.0-g7c36fab",
    "@vue/apollo-composable": "^4.2.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.7.7",
    "chart.js": "^4.4.7",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.2.2",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "katex": "^0.16.25",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.12.2",
    "monaco-editor": "^0.52.2",
    "pinia": "^2.1.7",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.0.3",
    "vue": "^3.5.28",
    "vue-chartjs": "^5.3.2",
    "vue-pdf-embed": "^2.1.3",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify-json/vscode-icons": "^1.2.74",
    "@pinia/nuxt": "^0.5.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/crypto-js": "^4.2.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/prismjs": "^1.26.4",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "happy-dom": "^15.7.4",
    "nuxt": "^3.21.0",
    "playwright-core": "^1.48.0",
    "postcss": "^8.4.39",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.5",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11",
    "ws": "^8.21.3"
  },
  "packageManager": "pnpm@10.15.0"
}
