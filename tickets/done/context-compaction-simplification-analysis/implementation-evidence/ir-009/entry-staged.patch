+  it("applies the same rules to Org trees, including mounted Team member addresses", () => {
+    const org = testAgentOrgExecutionTree({
+      orgRunId: "org-run",
+      members: [
+        testOrgAgentNode("/director", "director-run"),
+        testOrgTeamNode({
