diff --git a/autobyteus-ts/src/utils/context-patch-utils.ts b/autobyteus-ts/src/utils/context-patch-utils.ts
new file mode 100644
index 000000000..412e76023
--- /dev/null
+++ b/autobyteus-ts/src/utils/context-patch-utils.ts
@@ -0,0 +1,178 @@
+export class PatchApplicationError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'PatchApplicationError';
+  }
+}
+
+// Numeric decoration is tolerated as model-output noise, but its coordinates
+// never participate in matching; every accepted hunk uses the same context rule.
+const NUMERIC_HUNK_HEADER_RE = /^@@ -\d+(?:,\d+)? \+\d+(?:,\d+)? @@(?:\s.*)?$/;
+
+function splitLinesKeepEnds(text: string): string[] {
+  const matches = text.match(/.*(?:\n|$)/g) ?? [];
+  if (matches.length > 0 && matches[matches.length - 1] === '') {
+    matches.pop();
+  }
+  return matches;
+}
+
+function linesMatch(
+  actual: string,
+  expected: string,
+  ignoreWhitespace: boolean,
+  allowEofNewlineMismatch: boolean
+): boolean {
+  if (ignoreWhitespace) {
+    return actual.trim() === expected.trim();
+  }
+  if (actual === expected) {
+    return true;
+  }
+  if (allowEofNewlineMismatch) {
+    return actual.replace(/\n$/, '') === expected.replace(/\n$/, '');
+  }
+  return false;
+}
+
+function appendLineRange(target: string[], source: string[], start: number, end = source.length): void {
+  for (let index = start; index < end; index += 1) {
+    target.push(source[index]);
+  }
+}
+
+export function applyContextPatch(
+  originalLines: string[],
+  patch: string,
+  options: { ignoreWhitespace?: boolean } = {}
+): string[] {
+  if (!patch || patch.trim().length === 0) {
+    throw new PatchApplicationError('Patch content is empty; nothing to apply.');
+  }
+
+  const ignoreWhitespace = options.ignoreWhitespace ?? false;
+  const patchedLines: string[] = [];
+  const patchLines = splitLinesKeepEnds(patch);
+  let origIdx = 0;
+  let lineIdx = 0;
+
+  while (lineIdx < patchLines.length) {
+    const headerLine = patchLines[lineIdx];
+    if (headerLine.trim() === '') {
+      lineIdx += 1;
+      continue;
+    }
+    const normalizedHeader = headerLine.trim();
+    const isContextHeader = normalizedHeader === '@@' || NUMERIC_HUNK_HEADER_RE.test(normalizedHeader);
+    if (!isContextHeader) {
+      if (headerLine.startsWith('@@') || headerLine.startsWith('diff --git ') ||
+          headerLine.startsWith('---') || headerLine.startsWith('+++')) {
+        throw new PatchApplicationError(
+          'Unsupported patch header. Use a bare @@ header and identify the target with unchanged/removal context.'
+        );
+      }
+      throw new PatchApplicationError(
+        `Unexpected content outside of bare @@ hunk header: '${headerLine.trim()}'.`
+      );
+    }
+
+    lineIdx += 1;
+    const hunkBody: string[] = [];
+    while (lineIdx < patchLines.length && !patchLines[lineIdx].startsWith('@@')) {
+      hunkBody.push(patchLines[lineIdx]);
+      lineIdx += 1;
+    }
+
+    const expectedOriginal: string[] = [];
+    let hasChange = false;
+    for (let hunkIdx = 0; hunkIdx < hunkBody.length; hunkIdx += 1) {
+      const hunkLine = hunkBody[hunkIdx];
+      if (hunkLine.startsWith(' ') || hunkLine.startsWith('-')) {
+        let content = hunkLine.slice(1);
+        if (hunkIdx + 1 < hunkBody.length && hunkBody[hunkIdx + 1].startsWith('\\ No newline')) {
+          content = content.replace(/\n$/, '');
+        }
+        expectedOriginal.push(content);
+        if (hunkLine.startsWith('-')) hasChange = true;
+        continue;
+      }
+      if (hunkLine.startsWith('+')) {
+        hasChange = true;
+        continue;
+      }
+      if (hunkLine.startsWith('\\')) {
+        continue;
+      }
+      throw new PatchApplicationError(`Unsupported context-patch line: '${hunkLine.trim()}'.`);
+    }
+
+    if (!hasChange) {
+      throw new PatchApplicationError('Context hunk contains no addition or removal.');
+    }
+    if (expectedOriginal.length === 0) {
+      throw new PatchApplicationError(
+        'Context hunk requires at least one unchanged or removal line as a safe location anchor.'
+      );
+    }
+
+    let foundIdx = -1;
+    for (
+      let candidateIdx = origIdx;
+      candidateIdx + expectedOriginal.length <= originalLines.length;
+      candidateIdx += 1
+    ) {
+      let matches = true;
+      for (let expectedIdx = 0; expectedIdx < expectedOriginal.length; expectedIdx += 1) {
+        const isEofLine = candidateIdx + expectedOriginal.length === originalLines.length &&
+          expectedIdx === expectedOriginal.length - 1;
+        if (!linesMatch(
+          originalLines[candidateIdx + expectedIdx],
+          expectedOriginal[expectedIdx],
+          ignoreWhitespace,
+          isEofLine
+        )) {
+          matches = false;
+          break;
+        }
+      }
+      if (!matches) continue;
+      if (foundIdx !== -1) {
+        throw new PatchApplicationError(
+          'Context hunk is ambiguous: matched multiple locations. Include more unchanged context.'
+        );
+      }
+      foundIdx = candidateIdx;
+    }
+
+    if (foundIdx === -1) {
+      throw new PatchApplicationError('Could not find the context hunk in the target file.');
+    }
+    appendLineRange(patchedLines, originalLines, origIdx, foundIdx);
+
+    let matchedOrigOffset = 0;
+    for (let hunkIdx = 0; hunkIdx < hunkBody.length; hunkIdx += 1) {
+      const hunkLine = hunkBody[hunkIdx];
+      if (hunkLine.startsWith(' ')) {
+        patchedLines.push(originalLines[foundIdx + matchedOrigOffset]);
+        matchedOrigOffset += 1;
+        continue;
+      }
+      if (hunkLine.startsWith('-')) {
+        matchedOrigOffset += 1;
+        continue;
+      }
+      if (hunkLine.startsWith('+')) {
+        let content = hunkLine.slice(1);
+        if (hunkIdx + 1 < hunkBody.length && hunkBody[hunkIdx + 1].startsWith('\\ No newline')) {
+          content = content.replace(/\n$/, '');
+        }
+        patchedLines.push(content);
+      }
+    }
+
+    origIdx = foundIdx + expectedOriginal.length;
+  }
+
+  appendLineRange(patchedLines, originalLines, origIdx);
+  return patchedLines;
+}
