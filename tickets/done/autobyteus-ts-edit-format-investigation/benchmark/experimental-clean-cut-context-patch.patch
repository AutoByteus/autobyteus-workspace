+import { describe, it, expect } from 'vitest';
+import fs from 'fs/promises';
+import path from 'path';
+import { applyContextPatch } from '../../../src/utils/context-patch-utils.js';
+
+describe('applyContextPatch (integration)', () => {
+  it('applies patch to file content on disk', async () => {
+    const tmpDir = await fs.mkdtemp(path.join(process.cwd(), 'tmp-context-patch-utils-'));
+    const filePath = path.join(tmpDir, 'sample.txt');
+    await fs.writeFile(filePath, 'line1\nline2\n', 'utf-8');
+
+    const originalLines = (await fs.readFile(filePath, 'utf-8')).split(/(?<=\n)/);
+    const patch = `@@
+-line1
++LINE1
+ line2
+`;
+
+    const patchedLines = applyContextPatch(originalLines, patch);
+    await fs.writeFile(filePath, patchedLines.join(''), 'utf-8');
+
+    const updated = await fs.readFile(filePath, 'utf-8');
+    expect(updated).toBe('LINE1\nline2\n');
+  });
+});
