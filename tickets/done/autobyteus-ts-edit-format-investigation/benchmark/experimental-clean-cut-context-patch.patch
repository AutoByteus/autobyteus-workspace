+import { describe, it, expect } from 'vitest';
+import { applyContextPatch, PatchApplicationError } from '../../../src/utils/context-patch-utils.js';
+
+describe('applyContextPatch', () => {
+  it('applies a uniquely located replacement with a bare @@ header', () => {
+    const original = ['alpha\n', 'target: old\n', 'omega\n'];
+    const patch = `@@
+ alpha
+-target: old
++target: new
+ omega
+`;
+
+    expect(applyContextPatch(original, patch)).toEqual(['alpha\n', 'target: new\n', 'omega\n']);
+  });
+
+  it('can retry matching with whitespace tolerance', () => {
+    const original = ['def foo():\n', '    return True\n'];
+    const patch = `@@
+ def foo():
+-  return True
++  return False
+`;
+
+    expect(() => applyContextPatch(original, patch)).toThrow(PatchApplicationError);
+    expect(applyContextPatch(original, patch, { ignoreWhitespace: true }))
+      .toEqual(['def foo():\n', '  return False\n']);
+  });
+
+  it('rejects an ambiguous hunk instead of selecting an occurrence', () => {
+    const original = ['status: draft\n', 'separator\n', 'status: draft\n'];
+    const patch = `@@
+-status: draft
++status: ready
+`;
+
+    expect(() => applyContextPatch(original, patch)).toThrow(/ambiguous: matched multiple locations/i);
+  });
+
+  it('uses surrounding context to resolve repeated changed text', () => {
+    const original = [
+      'name: alpha\n',
+      'status: draft\n',
+      'name: beta\n',
+      'status: draft\n'
+    ];
+    const patch = `@@
+ name: beta
+-status: draft
++status: ready
+`;
+
+    expect(applyContextPatch(original, patch)).toEqual([
+      'name: alpha\n',
+      'status: draft\n',
+      'name: beta\n',
+      'status: ready\n'
+    ]);
+  });
+
+  it('applies an insertion when unchanged context anchors it', () => {
+    const original = ['alpha\n', 'omega\n'];
+    const patch = `@@
+ alpha
++inserted
+ omega
+`;
+
+    expect(applyContextPatch(original, patch)).toEqual(['alpha\n', 'inserted\n', 'omega\n']);
+  });
+
+  it('rejects a pure insertion with no safe anchor', () => {
+    expect(() => applyContextPatch(['alpha\n'], '@@\n+inserted\n'))
+      .toThrow(/requires at least one unchanged or removal line/i);
+  });
+
+  it('ignores numeric coordinates and locates the hunk by unique context', () => {
+    expect(applyContextPatch(
+      ['prefix\n', 'old\n', 'suffix\n'],
+      '@@ -999,50 +700,80 @@\n-old\n+new\n'
+    )).toEqual(['prefix\n', 'new\n', 'suffix\n']);
+  });
+
+  it('does not use numeric coordinates to resolve ambiguous context', () => {
+    expect(() => applyContextPatch(
+      ['old\n', 'separator\n', 'old\n'],
+      '@@ -1,1 +1,1 @@\n-old\n+new\n'
+    )).toThrow(/ambiguous/i);
+  });
+
+  it('rejects git file headers', () => {
+    expect(() => applyContextPatch(
+      ['old\n'],
+      'diff --git a/file b/file\n--- a/file\n+++ b/file\n@@\n-old\n+new\n'
+    )).toThrow(/unsupported patch header/i);
+  });
+
+  it('applies multiple ordered context hunks', () => {
+    const original = ['alpha: old\n', 'middle\n', 'omega: old\n'];
+    const patch = `@@
+-alpha: old
++alpha: new
+@@
+-omega: old
++omega: new
+`;
+
+    expect(applyContextPatch(original, patch)).toEqual([
+      'alpha: new\n',
+      'middle\n',
+      'omega: new\n'
+    ]);
+  });
+
+  it('preserves a missing newline at EOF', () => {
+    const original = ['line1\n', 'line2'];
+    const patch = `@@
+ line1
+-line2
++LINE2`;
+
+    expect(applyContextPatch(original, patch)).toEqual(['line1\n', 'LINE2']);
+  });
+
+  it('rejects a hunk that has no change', () => {
+    expect(() => applyContextPatch(['alpha\n'], '@@\n alpha\n'))
+      .toThrow(/contains no addition or removal/i);
+  });
+
+  it('applies near the end of a large file without spreading the file onto the call stack', () => {
+    const original = Array.from({ length: 250_000 }, (_, index) => `line-${index}\n`);
+    original[original.length - 2] = 'unique-target: old\n';
+
+    const patched = applyContextPatch(
+      original,
+      '@@\n-unique-target: old\n+unique-target: new\n'
+    );
+
+    expect(patched).toHaveLength(original.length);
+    expect(patched[patched.length - 2]).toBe('unique-target: new\n');
+    expect(patched[patched.length - 1]).toBe(original[original.length - 1]);
+  });
+});
