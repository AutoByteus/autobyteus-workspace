diff --git a/autobyteus-ts/tests/unit/utils/diff-utils-fuzzy.test.ts b/autobyteus-ts/tests/unit/utils/diff-utils-fuzzy.test.ts
index dccbaf8dc..e58d97abf 100644
--- a/autobyteus-ts/tests/unit/utils/diff-utils-fuzzy.test.ts
+++ b/autobyteus-ts/tests/unit/utils/diff-utils-fuzzy.test.ts
@@ -77,4 +77,35 @@ index 1234567..89abcde 100644
     const patched = applyUnifiedDiff(original, patch);
     expect(patched).toEqual(['line1\n', 'LINE2']);
   });
+
+  it('applies a unique context-only hunk emitted with a bare @@ header', () => {
+    const original = ['alpha\n', 'target: old\n', 'omega\n'];
+    const patch = `@@
+ alpha
+-target: old
++target: new
+ omega
+`;
+
+    expect(applyUnifiedDiff(original, patch)).toEqual(['alpha\n', 'target: new\n', 'omega\n']);
+  });
+
+  it('rejects an ambiguous context-only hunk instead of editing the wrong occurrence', () => {
+    const original = ['status: draft\n', 'separator\n', 'status: draft\n'];
+    const patch = `@@
+-status: draft
++status: ready
+`;
+
+    expect(() => applyUnifiedDiff(original, patch)).toThrow(/ambiguous: matched 2 locations/i);
+  });
+
+  it('rejects a context-only pure insertion because it has no safe anchor', () => {
+    const original = ['alpha\n'];
+    const patch = `@@
++inserted
+`;
+
+    expect(() => applyUnifiedDiff(original, patch)).toThrow(/requires at least one context or removal line/i);
+  });
 });
