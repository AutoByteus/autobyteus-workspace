diff --git a/autobyteus-server-ts/docker/Dockerfile.monorepo b/autobyteus-server-ts/docker/Dockerfile.monorepo
index 2f0f1d931..cd807dfe6 100644
--- a/autobyteus-server-ts/docker/Dockerfile.monorepo
+++ b/autobyteus-server-ts/docker/Dockerfile.monorepo
@@ -58,6 +58,9 @@ RUN apt-get update \
 
 # Keep provider setup writes out of the persisted runtime home. Verify native
 # payloads explicitly: both upstream installers can report success after failures.
+# The Antigravity installer is served with Content-Encoding: gzip even without
+# Accept-Encoding, so curl must decode it (--compressed) and the saved file must
+# be the shell script before it runs.
 RUN echo "CLI install cache buster: ${CLI_INSTALL_CACHE_BUSTER}" \
   && npm install -g \
   "@openai/codex@${CODEX_CLI_VERSION}" \
@@ -65,7 +68,8 @@ RUN echo "CLI install cache buster: ${CLI_INSTALL_CACHE_BUSTER}" \
   && cli_scratch="$(mktemp -d)" \
   && mkdir -p "${cli_scratch}/home" "${cli_scratch}/agy-bin" \
   && GROK_HOME="${cli_scratch}/grok" npm install -g --include=optional --ignore-scripts=false "@xai-official/grok@latest" \
-  && curl -fsSL https://antigravity.google/cli/install.sh -o "${cli_scratch}/agy-install.sh" \
+  && curl -fsSL --compressed https://antigravity.google/cli/install.sh -o "${cli_scratch}/agy-install.sh" \
+  && test "$(head -c 2 "${cli_scratch}/agy-install.sh")" = '#!' \
   && HOME="${cli_scratch}/home" bash "${cli_scratch}/agy-install.sh" --dir "${cli_scratch}/agy-bin" \
   && test -x "${cli_scratch}/agy-bin/agy" \
   && agy_version="$(HOME="${cli_scratch}/home" timeout 30s "${cli_scratch}/agy-bin/agy" --version)" \
diff --git a/scripts/tests/test_server_docker_cli_latest_defaults.py b/scripts/tests/test_server_docker_cli_latest_defaults.py
index a65965e44..2549a7553 100644
--- a/scripts/tests/test_server_docker_cli_latest_defaults.py
+++ b/scripts/tests/test_server_docker_cli_latest_defaults.py
@@ -38,10 +38,19 @@ class ServerDockerCliLatestDefaultsTest(unittest.TestCase):
     def test_new_clis_use_official_latest_in_the_cache_busted_layer(self) -> None:
         layer = self.cli_install_layer()
         self.assertIn('npm install -g --include=optional --ignore-scripts=false "@xai-official/grok@latest"', layer)
-        self.assertIn('curl -fsSL https://antigravity.google/cli/install.sh -o ', layer)
+        self.assertIn('curl -fsSL --compressed https://antigravity.google/cli/install.sh -o ', layer)
         self.assertIn('bash "${cli_scratch}/agy-install.sh" --dir "${cli_scratch}/agy-bin"', layer)
         self.assertNotIn("| bash", layer)
 
+    def test_agy_installer_is_decoded_and_checked_before_it_runs(self) -> None:
+        # The installer is served gzip-encoded even without Accept-Encoding; undecoded
+        # bytes made bash fail with "cannot execute binary file" (exit 126).
+        layer = self.cli_install_layer()
+        shebang_check = 'test "$(head -c 2 "${cli_scratch}/agy-install.sh")" = \'#!\''
+        self.assertIn(shebang_check, layer)
+        self.assertLess(layer.index('--compressed https://antigravity.google/cli/install.sh'), layer.index(shebang_check))
+        self.assertLess(layer.index(shebang_check), layer.index('bash "${cli_scratch}/agy-install.sh"'))
+
     def test_installers_use_disposable_state_and_publish_outside_home(self) -> None:
         layer = self.cli_install_layer()
         self.assertIn('cli_scratch="$(mktemp -d)"', layer)
