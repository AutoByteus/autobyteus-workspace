   254	  address: AgentTeamAddress,
   255	): ConfiguredTeamExecutionDto | null => {
   256	  const visit = (members: readonly ConfiguredMemberExecutionDto[]): ConfiguredTeamExecutionDto | null => {
   257	    for (const member of members) {
   258	      if (member.kind !== 'configured_team') continue;
   259	      if (member.address === address) return member;
   260	      const nested = visit(member.members);
   261	      if (nested) return nested;
   262	    }
   263	    return null;
   264	  };
   265	  return visit(tree.root_team.members);
