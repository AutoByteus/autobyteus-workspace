    60	  async rebuild(): Promise<void> {
    61	    this.state.initialized = true;
    62	    this.state.admitted.clear();
    63	    this.state.diagnostics.clear();
    64	    const treeStore = new TeamRunExecutionTreeStore();
    65	    const taskStore = new TaskDelegationRecordsV1Store();
    66	    const messageStore = new TeamCommunicationV1Store();
    67	    let entries: import("node:fs").Dirent[] = [];
    68	    try {
    69	      entries = await fs.readdir(this.layout.getTeamRootDirPath(), { withFileTypes: true });
    70	    } catch (error) {
    71	      if (missing(error)) return;
    72	      throw error;
    73	    }
    74	    for (const entry of entries.filter((item) => item.isDirectory()).sort((a, b) => a.name.localeCompare(b.name))) {
    75	      const rootTeamRunId = entry.name;
    76	      const rootDir = this.layout.getTeamDirPath({ rootTeamRunId, ancestorTeamRunIds: [] });
    77	      try {
    78	        // The predecessor file is the promotion marker: while it remains, the
    79	        // root is migration-owned even if a crash left target files behind.
    80	        await fs.access(path.join(rootDir, "team_run_metadata.json"));
    81	        this.exclude(rootTeamRunId, "Predecessor TeamRun metadata remains pending migration.");
    82	        continue;
    83	      } catch (error) {
    84	        if (!missing(error)) throw error;
    85	      }
    86	      try {
    87	        const [executionTree, taskRecords, communicationMessages] = await Promise.all([
    88	          treeStore.read(rootDir, rootTeamRunId),
    89	          taskStore.read(rootDir, rootTeamRunId),
    90	          messageStore.read(rootDir, rootTeamRunId),
    91	        ]);
    92	        if (!executionTree || !taskRecords || !communicationMessages) {
    93	          this.exclude(rootTeamRunId, "Current TeamRun V1 package is incomplete.");
    94	          continue;
    95	        }
    96	        validateTeamRunStatePackage({ executionTree, taskRecords, communicationMessages });
    97	        this.admit(rootTeamRunId);
    98	      } catch (error) {
    99	        this.exclude(rootTeamRunId, error instanceof Error ? error.message : String(error));
   100	      }
   101	    }
   102	  }
   103	}
