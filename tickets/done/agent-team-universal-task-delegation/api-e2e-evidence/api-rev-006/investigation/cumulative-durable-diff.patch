+    });
+    expect(projected).toEqual({
+      type: "SEGMENT_CONTENT",
+      payload: {
+        change_sequence: 18,
+        agent_run_id: "nested-task-agent-run-001",
+        segment_id: "segment-1",
+        turn_id: "turn-1",
+        segment_type: "text",
+        delta: "hello",
