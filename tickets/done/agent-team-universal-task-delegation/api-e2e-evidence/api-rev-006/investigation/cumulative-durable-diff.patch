+
+const task = (input: {
+  taskId: string;
+  delegatorAgentRunId: string;
+  recipientAddress: AgentTeamAddress;
+  execution: TaskDelegationRecordDto['task_execution'];
+  status?: TaskDelegationRecordDto['status'];
