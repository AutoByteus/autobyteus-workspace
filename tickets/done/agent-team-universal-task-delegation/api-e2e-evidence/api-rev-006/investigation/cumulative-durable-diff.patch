+    expect(projectSequencedTeamRunEvent(root as never, {
+      changeSequence: 21,
+      event: {
+        eventSourceType: TeamRunEventSourceType.MEMBER_INPUT,
+        agentRunId: "task-team-agent-run-qa-lead-001",
