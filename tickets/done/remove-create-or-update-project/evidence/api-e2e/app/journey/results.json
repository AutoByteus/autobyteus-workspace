      "descriptions": {
        "create_project": {
          "description": "Create a Project on the current node: required name, optional description and workspaces (absolute node-local folder paths; registration not required). Returns the saved Project (projectId, name, description, workspaces). Does not delegate work.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Trimmed non-empty Project name.",
                "type": "string"
              },
              "description": {
                "description": "Optional Project description.",
                "type": "string"
              },
              "workspaces": {
                "description": "Optional workspace links. Use absolute folder paths on this node; registration and existence are not required.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "workspace_path": {
                      "description": "Absolute folder path on this node; no shell expansion or registration required.",
                      "type": "string"
                    },
                    "description": {
                      "description": "Optional link description.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "workspace_path"
                  ]
                }
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "update_project": {
          "description": "Update a known Project by its project_id: name, description and/or workspaces. Omitted fields are kept; blank description clears. A supplied workspaces list replaces ALL links ([] unlinks all, folders are not deleted); retained links keep omitted descriptions. Returns the saved Project.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "project_id": {
                "description": "Known Project identity to update. Never resolved by name.",
                "type": "string"
              },
              "name": {
                "description": "Trimmed non-empty Project name; omit to keep.",
                "type": "string"
              },
              "description": {
                "description": "Project description; omit to keep, blank to clear.",
                "type": "string"
              },
              "workspaces": {
                "description": "Complete desired workspace links, not append. Omit to keep; [] unlinks all without deleting folders. Use absolute folder paths on this node; registration and existence are not required.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "workspace_path": {
                      "description": "Absolute folder path on this node; no shell expansion or registration required.",
                      "type": "string"
                    },
                    "description": {
                      "description": "Link description; omit to keep a retained link's description, blank to clear. New links default to blank.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "workspace_path"
                  ]
                }
              }
            },
            "required": [
              "project_id"
            ],
            "additionalProperties": false
          }
        }
      },
