// autobyteus-318 T-50: check the probe output-dir helper in a test-owned temp root.
import { spawnSync } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
const helper = 'file:///Users/normy/autobyteus_org/autobyteus-worktrees/test-and-tooling-hygiene-318/autobyteus-web/tests/e2e/fixtures/probe-output-dir.mjs';
const { probeOutputDir } = await import(helper);
const root = fs.mkdtempSync(path.join(os.tmpdir(), 'h318-probe-dir-'));
const run = (dir) => spawnSync(process.execPath, ['--input-type=module', '-e',
  `import { prepareOutputDir } from '${helper}'; console.log('prepared', prepareOutputDir(${JSON.stringify(dir)}));`], { encoding: 'utf8' });
const results = [];
// 1. default: a fresh per-run folder under test-results, distinct per run
const a = probeOutputDir(root, 'demo', undefined); await new Promise((r) => setTimeout(r, 5)); const b = probeOutputDir(root, 'demo', undefined);
results.push(['default is test-results/<name>-<UTC stamp>', /test-results\/demo-\d{4}-\d\d-\d\dT\d\d-\d\d-\d\d-\d{3}Z$/.test(a) && a !== b, a]);
const r1 = run(a); results.push(['default dir created, exit 0', r1.status === 0 && fs.existsSync(a), r1.stdout.trim()]);
// 2. explicit missing and explicit empty: accepted
const missing = probeOutputDir(root, 'demo', 'explicit-missing'); const r2 = run(missing);
results.push(['explicit missing dir created, exit 0', r2.status === 0 && fs.existsSync(missing), missing]);
const empty = path.join(root, 'explicit-empty'); fs.mkdirSync(empty); const r3 = run(empty);
results.push(['explicit empty dir accepted, exit 0', r3.status === 0, empty]);
// 3. explicit non-empty: refused with a message naming it; contents unchanged
const full = path.join(root, 'explicit-full'); fs.mkdirSync(full); fs.writeFileSync(path.join(full, 'result.json'), '{"earlier":true}');
const before = JSON.stringify(fs.readdirSync(full).map((f) => [f, fs.readFileSync(path.join(full, f), 'utf8')]));
const r4 = run(full);
const after = JSON.stringify(fs.readdirSync(full).map((f) => [f, fs.readFileSync(path.join(full, f), 'utf8')]));
results.push(['explicit non-empty dir refused, exit 1, message names it', r4.status === 1 && r4.stderr.includes(full) && r4.stderr.includes('Refusing'), r4.stderr.trim()]);
results.push(['refused dir unchanged', before === after, after]);
for (const [name, ok, detail] of results) console.log(`${ok ? 'PASS' : 'FAIL'} ${name} :: ${detail}`);
fs.rmSync(root, { recursive: true, force: true });
console.log(`temp root removed: ${!fs.existsSync(root)}`);
process.exitCode = results.every(([, ok]) => ok) ? 0 : 1;

