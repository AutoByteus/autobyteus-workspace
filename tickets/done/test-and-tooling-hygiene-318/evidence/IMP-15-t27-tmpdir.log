===== t27-measure.sh =====
# autobyteus-318 T-27: run each test file with a run-owned empty TMPDIR and list what it leaves behind.
W=/Users/normy/autobyteus_org/autobyteus-worktrees/test-and-tooling-hygiene-318
label=$1
run() { # pkg file
  local T; T="$(cd "$(mktemp -d)" && pwd -P)"; local H; H="$(cd "$(mktemp -d)" && pwd -P)"
  (cd "$W/$1" && env -i PATH="$PATH" HOME="$H" TMPDIR="$T/" npx vitest run "$2" > "/tmp/h318/t27-$label-$(basename "$2").log" 2>&1); local rc=$?
  local left; left=$(ls -A "$T" | grep -v -E '^(vitest|node-compile-cache|tsx-|jiti)' | sort | sed 's/-[A-Za-z0-9]\{6\}$/-XXXXXX/' | uniq -c | tr '\n' ';')
  echo "$label | $1/$2 | exit $rc | $(grep -E 'Tests ' "/tmp/h318/t27-$label-$(basename "$2").log" | tail -1 | sed 's/\x1b\[[0-9;]*m//g' | tr -s ' ') | left in TMPDIR: ${left:-nothing}"
  rm -rf "$T" "$H"
}
run autobyteus-ts tests/unit/prompt/prompt-builder.test.ts
for f in tests/unit/runtime-management/grok/grok-usage-limits-acp.test.ts tests/unit/runtime-management/grok/grok-build-launch-profile.test.ts tests/unit/runtime-management/grok/grok-build-capability.test.ts tests/unit/runtime-management/acp/acp-client-connection.test.ts tests/unit/runtime-management/acp/acp-agent-capabilities.test.ts tests/unit/agent-execution/backends/grok/grok-build-session-profile.test.ts tests/unit/agent-execution/backends/grok/grok-build-compaction.test.ts tests/unit/agent-execution/backends/workspace-skill-link-regression.test.ts tests/unit/agent-execution/backends/acp/acp-tool-list-reopen.test.ts tests/unit/agent-execution/backends/acp/acp-agent-run-backend-factory.test.ts; do run autobyteus-server-ts "$f"; done

