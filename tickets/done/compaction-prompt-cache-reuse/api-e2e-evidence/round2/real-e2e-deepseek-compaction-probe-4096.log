e: store.stepConfirmed[3] ? 'done' : store.evalStep >= 3 ? 'warn' : 'locked',\\n  },\\n  {\\n    id: 'risks', kind: 'risks', icon: '🛡️', label: 'PMS-/Risikoabgleich', meta: 'ISO 14971 · Vorfälle vs. Risiken',\\n    state: store.stepConfirmed[4] ? 'done' : store.evalStep >= 4 ? 'warn' : 'locked',\\n  },\\n  {\\n    id: 'conclusion', kind: 'conclusion', icon: '✍️', label: 'Schlussfolgerung & Freigabe', meta: 'Zusammenfassung · Signatur',\\n    state: store.released ? 'done' : store.stepConfirmed[4] ? 'warn' : 'locked',\\n  },\\n])\\n\\nconst initialMessages = computed(() => {\\n  const msgs = [\\n    { role: 'agent', text: 'Ich habe die Recherche-Ergebnisse. Ich bereite die 4 Bewertungsschritte vor – Sie entscheiden.' },\\n    { role: 'agent', text: 'Tool-Vorschlag: 4 Studien einschließen; Claims 2 & 3 sind nur teilweise gestützt (Evidenzlücke).' },\\n  ]\\n  if (store.released) msgs.push({ role: 'agent', text: `✅ CER freigegeben durch ${store.signer}.` })\\n  return msgs\\n})\\n\\nfunction onSend() {\\n  if (store.released) return 'Das CER ist freigegeben. Artefakt „Schlussfolgerung & Freigabe\\\" zeigt die Signatur.'\\n  const step = store.evalStep\\n  if (step === 1) return 'Öffnen Sie die Artefakte rechts – beginnen Sie mit der Literaturauswahl (Schritt 1 läuft bereits in der Auswahl).'\\n  if (step >= 2 && step <= 4) return `Schritt ${step - 1} ist bestätigt. Öffnen Sie das nächste Artefakt und bestätigen Sie Ihr Urteil.`\\n  if (step === 5) return 'Alle vier Schritte sind bestätigt. Die Freigabe wartet auf Ihre Signatur.'\\n  return 'Ich bereite die nächste Bewertungsstufe vor.'\\n}\\n</script>\\n\\n<template>\\n  <AgentWorkspace\\n    :agent=\\\"agent\\\"\\n    :actions=\\\"[]\\\"\\n    :artifacts=\\\"artifacts\\\"\\n    :initial-messages=\\\"initialMessages\\\"\\n    :on-send=\\\"onSend\\\"\\n  />\\n</template>\\n\"\n}","toolError":null},"provenance":{"kind":"single","rawTraceIds":["rt_1791704900099_turn_0002_call_00_26IQjpildT3xcydu1K5L6187_result"],"turnId":