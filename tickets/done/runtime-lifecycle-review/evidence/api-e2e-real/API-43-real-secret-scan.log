# positive control (planted fake values in a temp file) → patterns hit: ['api-key-like', 'device-code', 'email', 'oauth-params', 'openai-auth-url', 'tokens', 'xai-auth-url']
----- scanner
import os, re, sys, json
roots = sys.argv[1:]
patterns = {
  "openai-auth-url": re.compile(rb"auth\.openai\.com", re.I),
  "xai-auth-url": re.compile(rb"accounts\.x\.ai|auth\.x\.ai", re.I),
  "oauth-params": re.compile(rb"code_challenge|code_verifier|[?&]state=|[?&]code=", re.I),
  "device-code": re.compile(rb"device[_ -]?code|user[_ -]?code", re.I),
  "tokens": re.compile(rb"access_token|refresh_token|id_token|Bearer\s+[A-Za-z0-9._-]{12,}", re.I),
  "api-key-like": re.compile(rb"\bsk-[A-Za-z0-9_-]{16,}|\bxai-[A-Za-z0-9]{16,}"),
  "email": re.compile(rb"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"),
}
files = 0; hits = []
for root in roots:
  paths = [root] if os.path.isfile(root) else [os.path.join(d, f) for d, _, fs in os.walk(root) for f in fs]
  for p in paths:
    try: data = open(p, "rb").read()
    except Exception: continue
    files += 1
    for name, rx in patterns.items():
      n = len(rx.findall(data))
      if n: hits.append((p, name, n))
print(json.dumps({"filesScanned": files, "hits": [{"file": h[0], "pattern": h[1], "count": h[2]} for h in hits]}, indent=1))
