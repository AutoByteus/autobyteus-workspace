----- probe source
/**
 * TEMPORARY probe (API-12, ticket runtime-lifecycle-review; not committed): the Agent Runtimes API on a real studio
 * server against the REAL installed runtime CLIs found by the unchanged resolvers on PATH, in an empty HOME and an
 * empty CODEX_HOME (so every runtime is signed out and no account is touched), with the REAL vendor sources.
 * Read-only: only `checkAgentRuntimes` and `agentRuntimes`; no Update, no Sign in.
 * Command: env -i PATH="$PATH" HOME="$(cd "$(mktemp -d)" && pwd -P)" TMPDIR="$TMPDIR" CODEX_HOME="$HOME/.codex" \
 *   pnpm -C autobyteus-server-ts exec vitest run tests/e2e/runtime/tmp-rlr-real-cli-signed-out.e2e.test.ts --no-watch
 */
import "reflect-metadata";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { afterAll, beforeAll, describe, expect, it } from "vitest";
import type { FastifyInstance } from "fastify";
import { appConfigProvider } from "../../../src/config/app-config-provider.js";
import { startStudioE2eRuntimeServer } from "../helpers/studio-runtime-test-server.js";
import { createGraphqlClient, type AgentRuntimeRow } from "../helpers/agent-runtimes-e2e-harness.js";
import { until } from "../helpers/agy-runtime-error-fixture.js";

const versionOf = (command: string): string => {
  const result = spawnSync(command, ["--version"], { encoding: "utf8", timeout: 10_000 });
  return (`${result.stdout}`.match(/\d+\.\d+\.\d+/) ?? [""])[0]!;
};

describe("TEMP real CLIs signed out + real vendor sources", () => {
  let fastify: FastifyInstance;
  let client: ReturnType<typeof createGraphqlClient>;
  const dataDir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "rlr-real-cli-")));

  beforeAll(async () => {
    expect(process.env.HOME).not.toBe(os.userInfo().homedir);
    for (const key of ["CODEX_APP_SERVER_COMMAND", "CLAUDE_CODE_EXECUTABLE_PATH", "ANTIGRAVITY_CLI_COMMAND", "GROK_BUILD_COMMAND"]) expect(process.env[key]).toBeUndefined();
    fs.mkdirSync(process.env.CODEX_HOME!, { recursive: true });
    fs.writeFileSync(path.join(dataDir, ".env"), "AUTOBYTEUS_SERVER_HOST=http://localhost:8000\nAPP_ENV=test\n");
    appConfigProvider.config.setCustomAppDataDir(dataDir);
    const started = await startStudioE2eRuntimeServer();
    fastify = started.fastify;
    client = createGraphqlClient(started.mainUrl, globalThis.fetch);
  }, 120_000);

  afterAll(async () => {
    await fastify?.close();
    fs.rmSync(dataDir, { recursive: true, force: true });
  }, 60_000);

  it("reads the real installs: versions as their own --version, all signed out, real sources answer", async () => {
    const expected = { codex_app_server: versionOf("codex"), claude_agent_sdk: versionOf("claude"), antigravity_cli: versionOf("agy"), grok_build: versionOf("grok") };
    console.info("[API-12] own --version", JSON.stringify(expected));
    expect(await client.mutate("checkAgentRuntimes")).toEqual({ data: { checkAgentRuntimes: true } });
    let rows: Record<string, AgentRuntimeRow> = {};
    await until(async () => {
      rows = await client.rows();
      return Object.values(rows).every((row) => row.updates.state !== "CHECKING" && row.account.state !== "CHECKING");
    }, "all four checked", 60_000);
    for (const row of Object.values(rows)) {
      console.info(`[API-12] ${row.runtimeKind} installed=${row.installed} version=${row.installedVersion} updates=${row.updates.state}/${row.updates.latestVersion} account=${row.account.state}`);
    }
    for (const [kind, version] of Object.entries(expected)) {
      expect(rows[kind]).toMatchObject({ installed: true, installedVersion: version });
      expect(rows[kind]!.account.state, `${kind} in an empty HOME`).toBe("SIGNED_OUT");
      expect(["UP_TO_DATE", "UPDATE_AVAILABLE"], `${kind} source answered`).toContain(rows[kind]!.updates.state);
    }
  }, 120_000);
});
