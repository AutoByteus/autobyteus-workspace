----- probe-real-shapes.mjs
// Read-only probes of the real runtime CLIs in an empty temporary HOME (signed out, no user data).
import { spawn } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
const home = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "rlr-shapes-")));
fs.mkdirSync(path.join(home, ".codex"));
const env = { PATH: process.env.PATH, HOME: home, TMPDIR: os.tmpdir(), CODEX_HOME: path.join(home, ".codex") };
const run = (cmd, args, input, ms = 20000) => new Promise((resolve) => {
  const child = spawn(cmd, args, { env, cwd: home, stdio: ["pipe", "pipe", "pipe"] });
  let out = "", err = "";
  child.stdout.on("data", (c) => out += c); child.stderr.on("data", (c) => err += c);
  const t = setTimeout(() => child.kill("SIGKILL"), ms);
  if (input) { for (const l of input) child.stdin.write(l + "\n"); } else child.stdin.end();
  child.on("close", (code, sig) => { clearTimeout(t); resolve({ code, sig, out, err }); });
});
const show = (label, r) => console.log(`== ${label}\nEXIT=${r.code} SIGNAL=${r.sig}\nSTDOUT=${JSON.stringify(r.out)}\nSTDERR=${JSON.stringify(r.err.slice(0, 600))}\n`);
show("codex --version", await run("codex", ["--version"]));
show("grok --version", await run("grok", ["--version"]));
show("grok models (empty HOME)", await run("grok", ["models"]));
show("grok update --check --json (empty HOME)", await run("grok", ["update", "--check", "--json"]));
show("agy --version", await run("agy", ["--version"]));
show("agy models (empty HOME)", await run("agy", ["models"]));
show("claude --version", await run("claude", ["--version"]));
show("claude auth status --json (empty HOME)", await run("claude", ["auth", "status", "--json"]));
show("codex app-server initialize + account/read (empty CODEX_HOME)", await run("codex", ["app-server"], [
  JSON.stringify({ id: 1, method: "initialize", params: { clientInfo: { name: "probe", version: "0" } } }),
  JSON.stringify({ method: "initialized" }),
  JSON.stringify({ id: 2, method: "account/read", params: { refreshToken: false } }),
], 8000));
fs.rmSync(home, { recursive: true, force: true });
console.log("temporary HOME removed:", !fs.existsSync(home));
----- probe-codex-model-list.mjs
import { spawn } from "node:child_process";
import fs from "node:fs"; import os from "node:os"; import path from "node:path";
const home = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "rlr-codex-ml-"))); fs.mkdirSync(path.join(home, ".codex"));
const child = spawn("codex", ["app-server"], { env: { PATH: process.env.PATH, HOME: home, TMPDIR: os.tmpdir(), CODEX_HOME: path.join(home, ".codex") }, cwd: home });
let out = ""; child.stdout.on("data", (c) => out += c);
for (const m of [{ id: 1, method: "initialize", params: { clientInfo: { name: "probe", version: "0" } } }, { method: "initialized" }, { id: 2, method: "model/list", params: {} }]) child.stdin.write(JSON.stringify(m) + "\n");
setTimeout(() => { child.kill("SIGKILL"); const line = out.split("\n").find((l) => l.startsWith('{"id":2')); const r = JSON.parse(line); console.log("rows:", r.result?.data?.length, "first row keys:", Object.keys(r.result?.data?.[0] ?? {}).join(",")); console.log(JSON.stringify(r.result?.data?.[0]).slice(0, 900)); console.log("nextCursor:", r.result?.nextCursor); fs.rmSync(home, { recursive: true, force: true }); }, 6000);
