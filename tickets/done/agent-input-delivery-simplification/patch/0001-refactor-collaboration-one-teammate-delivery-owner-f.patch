+import { buildOrg, cleanupDirectories as cleanupOrgDirectories } from "../agent-org-execution/helpers/org-collaborator-harness.js";
+import { ROOT as TEAM_ROOT, cleanupDirectories as cleanupTeamDirectories, harness as teamHarness } from "../agent-team-execution/helpers/team-root-collaborator-harness.js";
+import { HOST, buildManager, directories as standaloneDirectories } from "../standalone-agent-run-root/helpers/standalone-root-harness.js";
+
+/**
+ * Teammate delivery through each real root (standalone, AgentOrg, Team): its port, its real
+ * persistence coordinator and its on-disk message store. A Task copy delegated by the root's
+ * first agent is the recipient; its reservation is the test's own so each step is visible.
+ */
+type MessageStore = Readonly<{ prototype: object; method: string }>;
+type RootSubject = Readonly<{
+  codes: Readonly<{ conflict: Readonly<{ code: string; message: string }>; historyFailed: string; indeterminate: string }>;
+  messageStore: MessageStore;
+  resources: InMemoryTaskAgentResources;
+  copyRunId: string;
+  order: string[];
+  copyHandle: { reserveInput: ReturnType<typeof vi.fn> };
+  send(content: string): Promise<AgentOperationResult>;
+  sendLater(): Promise<AgentOperationResult>;
+  failStop: ReturnType<typeof vi.fn>;
+  isActive(): boolean;
+  snapshotContents(): string[];
+  persistedContents(): Promise<string[]>;
+}>;
+
+const standalone = async (): Promise<RootSubject> => {
+  const resources = new InMemoryTaskAgentResources();
+  resources.addTask("A");
+  const f = await buildManager(resources);
+  const root = (await f.manager.resolveRoot(HOST))!;
+  const order: string[] = [];
+  root.subscribeToEvents(({ event }) => {
+    if (event.kind === "communication") order.push("history");
+    if (event.kind === "agent_presentation" && event.message.type === "MEMBER_INPUT_MESSAGE") order.push("presentation");
+  });
+  const assigned = await root.delegateTask({ identity: f.hostIdentity }, { recipient_address: "/code_reviewer", task_id: "A" });
+  await flushMicrotasks();
+  const copyRunId = assigned.target_agent_run_id!;
+  const dir = new AgentMemoryLayout(f.memoryDir).getAgentRunCollaborationDirPath(HOST);
+  return {
+    codes: {
+      conflict: { code: "AGENT_ROOT_MESSAGE_COMMIT_CONFLICT", message: "Message append conflicts with the current Agent root state." },
+      historyFailed: "AGENT_ROOT_MESSAGE_HISTORY_COMMIT_FAILED",
+      indeterminate: "RootTaskPersistenceFinalizationIndeterminateError",
+    },
+    messageStore: { prototype: StandaloneRootPackageStore.prototype, method: "writeMessages" },
+    resources, copyRunId, order,
+    copyHandle: f.handles.get(copyRunId)!.handle as never,
+    send: (content) => root.deliverExactAgentMessage({
+      sender: { kind: "agent", identity: f.hostIdentity, displayName: "research_assistant" }, targetAgentRunId: copyRunId, content,
+    }),
+    sendLater: () => root.deliverLogicalMessage(f.hostIdentity, { recipientAddress: "/lead" as never, content: "Later work" }),
+    failStop: vi.spyOn(root, "enterPersistenceFailStop") as never,
+    isActive: () => root.isActive(),
+    snapshotContents: () => root.getCommunicationSnapshot().messages.map((message) => message.content),
+    persistedContents: async () => ((await new StandaloneRootPackageStore().readMessages(dir, HOST))?.messages ?? []).map((message) => message.content),
+  };
+};
+
+const org = async (): Promise<RootSubject> => {
+  const resources = new InMemoryTaskAgentResources();
+  resources.addTask("A");
+  const o = await buildOrg({ taskAgentResources: resources });
+  const order: string[] = [];
+  o.publisher.subscribe(({ event }) => {
+    if (event.kind === "communication") order.push("history");
+    if (event.kind === "agent_presentation" && event.message.type === "MEMBER_INPUT_MESSAGE") order.push("presentation");
+  });
+  const director = createCollaborationMemberExecutionIdentity({ root: o.root, memberAddress: "/director", agentRunId: "director" });
+  const assigned = await o.owner.delegateTask({ identity: director }, { recipient_address: "/code_reviewer", task_id: "A" });
+  await flushMicrotasks();
+  const copyRunId = assigned.target_agent_run_id!;
+  const sender = { kind: "agent" as const, identity: director, displayName: "director" };
+  return {
+    codes: {
+      conflict: { code: "AGENT_ORG_MESSAGE_COMMIT_CONFLICT", message: "Message append conflicts with current AgentOrg state." },
+      historyFailed: "AGENT_ORG_MESSAGE_HISTORY_COMMIT_FAILED",
+      indeterminate: "RootTaskPersistenceFinalizationIndeterminateError",
+    },
+    messageStore: { prototype: AgentOrgCommunicationMessagesV1Store.prototype, method: "write" },
+    resources, copyRunId, order,
+    copyHandle: o.handles.get(copyRunId)!.handle as never,
+    send: (content) => o.owner.deliverExactAgentMessage({ sender, targetAgentRunId: copyRunId, content }),
+    sendLater: () => o.owner.deliverExactAgentMessage({ sender, targetAgentRunId: "configured-lead", content: "Later work" }),
+    failStop: o.enterPersistenceFailStop,
+    isActive: () => o.owner.isActive(),
+    snapshotContents: () => o.owner.getCommunicationSnapshot().messages.map((message) => message.content),
+    persistedContents: async () => ((await new AgentOrgCommunicationMessagesV1Store().read(o.orgMemoryDir, o.root.rootRunId))?.messages ?? [])
+      .map((message) => message.content),
+  };
+};
+
+const team = async (): Promise<RootSubject> => {
+  const h = await teamHarness();
+  const resources = h.dependencies.taskAgentResources;
+  resources.addTask("A");
+  const order: string[] = [];
+  h.root.subscribeToEvents(({ event }) => {
+    if (event.eventSourceType === TeamRunEventSourceType.COMMUNICATION) order.push("history");
+    if (event.eventSourceType === TeamRunEventSourceType.MEMBER_INPUT) order.push("presentation");
+  });
+  const coordinator = h.identity("/coordinator", "run-coordinator");
+  const assigned = await h.root.delegateTask({ identity: coordinator }, { recipient_address: "/code_reviewer", task_id: "A" });
+  await flushMicrotasks();
+  const copyRunId = assigned.target_agent_run_id!;
+  return {
+    codes: {
+      conflict: { code: "TEAM_MESSAGE_COMMIT_CONFLICT", message: "Message append conflicts with current root state." },
+      historyFailed: "TEAM_MESSAGE_HISTORY_COMMIT_FAILED",
+      indeterminate: "TeamRunPersistenceFinalizationIndeterminateError",
+    },
+    messageStore: { prototype: TeamCommunicationV1Store.prototype, method: "write" },
+    resources, copyRunId, order,
+    copyHandle: h.handles.get(copyRunId)!.handle as never,
+    send: (content) => h.root.deliverExactAgentMessage({
+      sender: { kind: "agent", identity: coordinator, displayName: "coordinator" }, targetAgentRunId: copyRunId, content,
+    }),
+    sendLater: () => h.message(coordinator, "/lead", "Later work"),
+    failStop: vi.spyOn(h.root, "enterPersistenceFailStop") as never,
+    isActive: () => h.root.isActive(),
+    snapshotContents: () => h.root.getCommunicationSnapshot().messages.map((message) => message.content),
+    persistedContents: async () => ((await new TeamCommunicationV1Store().read(h.teamMemoryDir, TEAM_ROOT))?.messages ?? [])
+      .map((message) => message.content),
+  };
+};
+
+/** The copy's next held slot, recorded into the subject's step order. */
+const trackNextReservation = (subject: RootSubject, commitError?: Error) => {
+  const release = vi.fn(() => { subject.order.push("release"); });
+  const reservation = {
+    agentRunId: subject.copyRunId,
+    release,
+    cancel: vi.fn(() => { subject.order.push("cancel"); }),
+    commit: vi.fn(() => {
+      if (commitError) throw commitError;
+      subject.order.push("commit");
+      return { release };
+    }),
+  };
+  subject.copyHandle.reserveInput.mockImplementationOnce(async () => ({ reserved: true as const, reservation }));
+  return reservation;
+};
+
+const spyMessageWrite = (store: MessageStore) => {
+  const target = store.prototype as Record<string, (...args: unknown[]) => Promise<RunPackageFileWriteResult>>;
+  const original = target[store.method]!;
+  return { spy: vi.spyOn(target, store.method), original };
+};
+
+/** Holds the next message-history write open until `finish`; the file is then really written. */
+const holdNextMessageWrite = (store: MessageStore) => {
+  const { spy, original } = spyMessageWrite(store);
+  let started!: () => void;
+  let finish!: () => void;
+  const writeStarted = new Promise<void>((resolve) => { started = resolve; });
+  const gate = new Promise<void>((resolve) => { finish = resolve; });
+  spy.mockImplementationOnce(async function (this: unknown, ...args: unknown[]) {
+    started();
+    await gate;
+    return original.apply(this, args);
+  });
+  return { writeStarted, finish: () => finish() };
+};
+
+const failNextMessageWrite = (store: MessageStore, result: RunPackageFileWriteResult) => {
+  spyMessageWrite(store).spy.mockImplementationOnce(async () => result);
+};
+
+afterEach(async () => {
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+  await Promise.all([
+    ...standaloneDirectories.splice(0).map((dir) => import("node:fs/promises").then((fs) => fs.rm(dir, { recursive: true, force: true }))),
+    cleanupOrgDirectories(),
+    cleanupTeamDirectories(),
+  ]);
+});
+
+describe.each([
+  ["standalone Agent root", standalone],
+  ["AgentOrg root", org],
+  ["Team root", team],
+] as const)("teammate delivery through the %s", (_label, build) => {
+  it("saves the message, publishes it, then commits, presents and releases the recipient input", async () => {
+    const s = await build();
+    const reservation = trackNextReservation(s);
+    await expect(s.send("Please review.")).resolves.toMatchObject({ accepted: true, agentRunId: s.copyRunId });
+    expect(s.order).toEqual(["history", "commit", "presentation", "release"]);
+    expect(reservation.cancel).not.toHaveBeenCalled();
+    expect(s.snapshotContents()).toEqual(["Please review."]);
+    expect(await s.persistedContents()).toEqual(["Please review."]);
+  });
+
+  it("keeps the root's own conflict and history-failure codes; neither saves nor delivers", async () => {
+    vi.useFakeTimers({ toFake: ["Date"] });
+    vi.setSystemTime(new Date("2026-10-08T10:00:00.000Z"));
+    const s = await build();
+    trackNextReservation(s);
+    await expect(s.send("Same words.")).resolves.toMatchObject({ accepted: true });
+    const duplicate = trackNextReservation(s);
+    await expect(s.send("Same words.")).resolves.toEqual({ accepted: false, ...s.codes.conflict });
+    expect(duplicate.cancel).toHaveBeenCalledOnce();
+
+    const failed = trackNextReservation(s);
+    failNextMessageWrite(s.messageStore, { outcome: "not_renamed", file: "communication_messages", stage: "write_temp", cause: new Error("disk full") });
+    await expect(s.send("Lost words.")).resolves.toEqual({ accepted: false, code: s.codes.historyFailed, message: "disk full" });
+    expect(failed.cancel).toHaveBeenCalledOnce();
+    expect(failed.commit).not.toHaveBeenCalled();
+    expect(s.snapshotContents()).toEqual(["Same words."]);
+    expect(await s.persistedContents()).toEqual(["Same words."]);
+  });
+
+  it("REQ-012: a Task closed during the history write keeps the saved record, never delivers it, and keeps the root working", async () => {
+    const s = await build();
+    const reservation = trackNextReservation(s);
+    const write = holdNextMessageWrite(s.messageStore);
+    const delivery = s.send("Final report.");
+    await write.writeStarted;
+    s.resources.close("A");
+    write.finish();
+
+    await expect(delivery).rejects.toSatisfy((error: unknown) =>
+      error instanceof TaskDelegationError && error.code === "TASK_AGENT_RESOURCE_CLOSED");
+    expect(s.failStop).not.toHaveBeenCalled();
+    expect(s.isActive()).toBe(true);
+    expect(reservation.commit).not.toHaveBeenCalled();
+    expect(reservation.release).not.toHaveBeenCalled();
+    expect(s.order).toEqual(["history", "cancel"]);
+    expect(s.snapshotContents()).toEqual(["Final report."]);
+    expect(await s.persistedContents()).toEqual(["Final report."]);
+
+    await expect(s.sendLater()).resolves.toMatchObject({ accepted: true });
+    expect(await s.persistedContents()).toEqual(["Final report.", "Later work"]);
+    expect(s.failStop).not.toHaveBeenCalled();
+  });
+
+  it("REQ-012: a recipient that stopped accepting input during the write gets AGENT_RUN_NOT_ACCEPTING_INPUT, not a fail-stop", async () => {
+    const s = await build();
+    const reservation = trackNextReservation(s, new Error("AgentRun input reservation '1' cannot be committed."));
+    await expect(s.send("Final report.")).resolves.toEqual({
+      accepted: false, code: "AGENT_RUN_NOT_ACCEPTING_INPUT", message: "AgentRun is not accepting input.",
+    });
+    expect(s.failStop).not.toHaveBeenCalled();
+    expect(s.isActive()).toBe(true);
+    expect(reservation.cancel).toHaveBeenCalledOnce();
+    expect(s.order).toEqual(["history", "cancel"]);
+    expect(await s.persistedContents()).toEqual(["Final report."]);
+  });
+
+  it("throws an indeterminate history write, fail-stops the root and cancels the held slot", async () => {
+    const s = await build();
+    const reservation = trackNextReservation(s);
+    failNextMessageWrite(s.messageStore, {
+      outcome: "renamed_finalization_indeterminate", file: "communication_messages", stage: "sync_directory", cause: new Error("fsync"),
+    });
+    await expect(s.send("Unsure words.")).rejects.toMatchObject({ name: s.codes.indeterminate });
+    expect(s.failStop).toHaveBeenCalledOnce();
+    expect(reservation.cancel).toHaveBeenCalledOnce();
+    expect(reservation.commit).not.toHaveBeenCalled();
+    expect(s.order).toEqual(["cancel"]);
+  });
+});
