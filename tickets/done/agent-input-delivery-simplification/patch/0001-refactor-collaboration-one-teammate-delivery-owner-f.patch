@@ -0,0 +1,233 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { AgentInputUserMessage } from "autobyteus-ts/agent/message/agent-input-user-message.js";
+import { SenderType } from "autobyteus-ts/agent/sender-type.js";
+import { RootCommunicationEngine } from "../../../src/agent-collaboration/execution/communication/root-communication-engine.js";
+import type { RootCommunicationPort } from "../../../src/agent-collaboration/execution/communication/root-communication-port.js";
+import { TaskDelegationError } from "../../../src/agent-collaboration/execution/task/task-delegation-command.js";
+import {
+  createAgentRootExecutionIdentity,
+  createCollaborationMemberExecutionIdentity,
+} from "../../../src/agent-collaboration/execution/domain/root-execution-identity.js";
+import {
+  StandaloneRootPersistenceCoordinator,
+  StandaloneRootPersistenceFailStoppedError,
+} from "../../../src/standalone-agent-run-root/services/standalone-root-persistence-coordinator.js";
+import type { RunPackageFileWriteResult } from "../../../src/run-history/store/atomic-run-package-file-commit-writer.js";
+
+/**
+ * RootCommunicationEngine protocol (DS-002) against a real root persistence coordinator. The
+ * port is a double; per-root wiring is covered through the real roots in
+ * root-communication-roots.test.ts.
+ */
+const hostRunId = "host-run";
+const root = createAgentRootExecutionIdentity(hostRunId);
+const sender = createCollaborationMemberExecutionIdentity({ root, memberAddress: "/host", agentRunId: "host-run" });
+const helper = createCollaborationMemberExecutionIdentity({ root, memberAddress: "/helper", agentRunId: "helper-run" });
+const reviewer = createCollaborationMemberExecutionIdentity({ root, memberAddress: "/reviewer", agentRunId: "reviewer-run" });
+const committed = { outcome: "committed" as const, file: "communication_messages" };
+const closed = () => new TaskDelegationError("TASK_AGENT_RESOURCE_CLOSED", "The Task work for this agent run is closed (its Task is DONE or CANCELLED).");
+
+const subject = () => {
+  const order: string[] = [];
+  const closedReceivers = new Set<string>();
+  const reservations: Array<{ agentRunId: string; commit: ReturnType<typeof vi.fn>; cancel: ReturnType<typeof vi.fn>; release: ReturnType<typeof vi.fn> }> = [];
+  let commitFailure: Error | null = null;
+  const writes: Array<() => Promise<RunPackageFileWriteResult>> = [];
+  const store = {
+    writeMessages: vi.fn(async (_dir: string, file: { messages: readonly unknown[] }) => {
+      order.push(`write:${file.messages.length}`);
+      return (writes.shift() ?? (async () => committed))();
+    }),
+  };
+  const enterPersistenceFailStop = vi.fn();
+  const persistence = new StandaloneRootPersistenceCoordinator({
+    hostRunId, collaborationDir: "/memory/collaboration", store: store as never, packageExists: true,
+    getMessages: () => ({ schemaVersion: 1, subjectKind: "agent", hostRunId, messages: [] }),
+    onPackageCreated: async () => undefined, enterPersistenceFailStop,
+  });
+  let open = true;
+  const port: RootCommunicationPort = {
+    root,
+    initialMessages: [],
+    rejections: {
+      notAccepting: { code: "ROOT_CLOSED", message: "Root closed." },
+      commitConflict: { code: "ROOT_COMMIT_CONFLICT", message: "Append conflicts." },
+      historyCommitFailedCode: "ROOT_HISTORY_COMMIT_FAILED",
+    },
+    isOpen: () => open,
+    isCurrentAgent: () => true,
+    assertDeliveryAllowed: (_from, to) => { if (closedReceivers.has(to.agentRunId)) throw closed(); },
+    buildRecipientInput: ({ message }) => new AgentInputUserMessage(message.content, SenderType.AGENT),
+    reserveRecipientInput: vi.fn(async (agentRunId: string) => {
+      const release = vi.fn(() => { order.push("release"); });
+      const reservation = {
+        agentRunId,
+        release,
+        cancel: vi.fn(() => { order.push("cancel"); }),
+        commit: vi.fn(() => {
+          if (commitFailure) throw commitFailure;
+          order.push("reservation_commit");
+          return { release };
+        }),
+      };
+      reservations.push(reservation);
+      return { reserved: true as const, reservation };
+    }),
+    commitMessageAppend: (append) => persistence.commitMessageAppend(append),
+    publishMessage: vi.fn(() => { order.push("history_event"); }),
+    presentRecipientInput: vi.fn(() => { order.push("presentation"); }),
+  };
+  const engine = new RootCommunicationEngine(port);
+  const send = (receiver = helper, content = "Final report") => engine.deliver({
+    senderIdentity: sender, senderDisplayName: "host", receiverIdentity: receiver, receiverDisplayName: "helper", content,
+  });
+  /** Holds the next history write open until `finish` is called. */
+  const holdNextWrite = () => {
+    let finish!: (result?: RunPackageFileWriteResult) => void;
+    let started!: () => void;
+    const writeStarted = new Promise<void>((resolve) => { started = resolve; });
+    writes.push(() => new Promise((resolve) => { started(); finish = (result = committed) => resolve(result); }));
+    return { writeStarted, finish: (result?: RunPackageFileWriteResult) => finish(result) };
+  };
+  return {
+    engine, port, persistence, store, order, reservations, enterPersistenceFailStop, send, holdNextWrite,
+    closeTaskOf: (receiver: { agentRunId: string }) => closedReceivers.add(receiver.agentRunId),
+    stopRecipient: () => { commitFailure = new Error("AgentRun input reservation '1' cannot be committed."); },
+    failNextWrite: (result: RunPackageFileWriteResult) => writes.push(async () => result),
+    closeRootOpenness: () => { open = false; },
+  };
+};
+
+afterEach(() => { vi.useRealTimers(); });
+
+describe("RootCommunicationEngine", () => {
+  it("saves the message, then publishes it, commits, presents and releases the held slot", async () => {
+    const s = subject();
+    await expect(s.send()).resolves.toEqual({ accepted: true, agentRunId: "helper-run", displayName: "helper" });
+    expect(s.order).toEqual(["write:1", "history_event", "reservation_commit", "presentation", "release"]);
+    expect(s.engine.getMessages()).toMatchObject([{ senderAgentRunId: "host-run", receiverAgentRunId: "helper-run", content: "Final report" }]);
+  });
+
+  it("rejects with the port's not-accepting rejection before reserving", async () => {
+    const s = subject();
+    s.engine.closeAdmission();
+    await expect(s.send()).resolves.toEqual({ accepted: false, code: "ROOT_CLOSED", message: "Root closed." });
+    const other = subject();
+    other.closeRootOpenness();
+    await expect(other.send()).resolves.toMatchObject({ accepted: false, code: "ROOT_CLOSED" });
+    expect(s.port.reserveRecipientInput).not.toHaveBeenCalled();
+    expect(other.port.reserveRecipientInput).not.toHaveBeenCalled();
+  });
+
+  it("throws the scope error before reserving when the Task is already closed", async () => {
+    const s = subject();
+    s.closeTaskOf(helper);
+    await expect(s.send()).rejects.toMatchObject({ name: "TaskDelegationError", code: "TASK_AGENT_RESOURCE_CLOSED" });
+    expect(s.port.reserveRecipientInput).not.toHaveBeenCalled();
+    expect(s.store.writeMessages).not.toHaveBeenCalled();
+  });
+
+  it("checks scope under the history lock: a Task closed while waiting writes nothing and cancels the held slot", async () => {
+    const s = subject();
+    const first = s.holdNextWrite();
+    const toReviewer = s.send(reviewer, "first");
+    await first.writeStarted;
+    const toHelper = s.send(helper, "second");
+    await vi.waitFor(() => expect(s.reservations).toHaveLength(2));
+    s.closeTaskOf(helper);
+    first.finish();
+    await expect(toReviewer).resolves.toMatchObject({ accepted: true });
+    await expect(toHelper).rejects.toMatchObject({ code: "TASK_AGENT_RESOURCE_CLOSED" });
+    expect(s.store.writeMessages).toHaveBeenCalledTimes(1);
+    expect(s.reservations[1]!.cancel).toHaveBeenCalledOnce();
+    expect(s.reservations[1]!.commit).not.toHaveBeenCalled();
+    expect(s.engine.getMessages().map((message) => message.content)).toEqual(["first"]);
+  });
+
+  it("returns the commit conflict for a duplicate message or a root closed while waiting for the lock", async () => {
+    vi.useFakeTimers({ toFake: ["Date"] });
+    vi.setSystemTime(new Date("2026-10-08T10:00:00.000Z"));
+    const s = subject();
+    await expect(s.send()).resolves.toMatchObject({ accepted: true });
+    await expect(s.send()).resolves.toEqual({ accepted: false, code: "ROOT_COMMIT_CONFLICT", message: "Append conflicts." });
+    expect(s.reservations[1]!.cancel).toHaveBeenCalledOnce();
+    expect(s.store.writeMessages).toHaveBeenCalledTimes(1);
+
+    const closing = subject();
+    const first = closing.holdNextWrite();
+    const pending = closing.send(reviewer, "first");
+    await first.writeStarted;
+    const queued = closing.send(helper, "second");
+    await vi.waitFor(() => expect(closing.reservations).toHaveLength(2));
+    closing.engine.closeAdmission();
+    first.finish();
+    await pending;
+    await expect(queued).resolves.toMatchObject({ accepted: false, code: "ROOT_COMMIT_CONFLICT" });
+    expect(closing.reservations[1]!.cancel).toHaveBeenCalledOnce();
+  });
+
+  it("returns the history-commit failure with the write's message when the file was not renamed", async () => {
+    const s = subject();
+    s.failNextWrite({ outcome: "not_renamed", file: "communication_messages", stage: "write_temp", cause: new Error("disk full") });
+    await expect(s.send()).resolves.toEqual({ accepted: false, code: "ROOT_HISTORY_COMMIT_FAILED", message: "disk full" });
+    expect(s.order).toEqual(["write:1", "cancel"]);
+    expect(s.engine.getMessages()).toEqual([]);
+    expect(s.port.publishMessage).not.toHaveBeenCalled();
+  });
+
+  it("throws an indeterminate write, fail-stops the root and cancels the held slot", async () => {
+    const s = subject();
+    s.failNextWrite({ outcome: "renamed_finalization_indeterminate", file: "communication_messages", stage: "sync_directory", cause: new Error("fsync") });
+    await expect(s.send()).rejects.toMatchObject({ name: "RootTaskPersistenceFinalizationIndeterminateError", stage: "sync_directory" });
+    expect(s.enterPersistenceFailStop).toHaveBeenCalledOnce();
+    expect(s.reservations[0]!.cancel).toHaveBeenCalledOnce();
+    expect(s.reservations[0]!.commit).not.toHaveBeenCalled();
+    // A fail-stopped coordinator never runs the next append; the engine abandons it.
+    await expect(s.send(reviewer)).rejects.toBeInstanceOf(StandaloneRootPersistenceFailStoppedError);
+    expect(s.reservations[1]!.cancel).toHaveBeenCalledOnce();
+  });
+
+  it("REQ-012: a Task closed during the write keeps the record, publishes it, never delivers, and does not fail-stop", async () => {
+    const s = subject();
+    const write = s.holdNextWrite();
+    const delivery = s.send();
+    await write.writeStarted;
+    s.closeTaskOf(helper);
+    write.finish();
+    await expect(delivery).rejects.toSatisfy((error: unknown) =>
+      error instanceof TaskDelegationError && error.code === "TASK_AGENT_RESOURCE_CLOSED");
+    expect(s.enterPersistenceFailStop).not.toHaveBeenCalled();
+    expect(s.order).toEqual(["write:1", "history_event", "cancel"]);
+    expect(s.reservations[0]!.commit).not.toHaveBeenCalled();
+    expect(s.reservations[0]!.release).not.toHaveBeenCalled();
+    expect(s.engine.getMessages()).toHaveLength(1);
+    await expect(s.send(reviewer, "later")).resolves.toMatchObject({ accepted: true });
+    expect(s.engine.getMessages()).toHaveLength(2);
+  });
+
+  it("REQ-012: a recipient that stopped accepting input during the write is a rejection, not a fail-stop", async () => {
+    const s = subject();
+    const write = s.holdNextWrite();
+    const delivery = s.send();
+    await write.writeStarted;
+    s.stopRecipient();
+    write.finish();
+    await expect(delivery).resolves.toEqual({ accepted: false, code: "AGENT_RUN_NOT_ACCEPTING_INPUT", message: "AgentRun is not accepting input." });
+    expect(s.enterPersistenceFailStop).not.toHaveBeenCalled();
+    expect(s.order).toEqual(["write:1", "history_event", "cancel"]);
+    expect(s.port.presentRecipientInput).not.toHaveBeenCalled();
+    expect(s.engine.getMessages()).toHaveLength(1);
+  });
+
+  it("still releases committed input and fail-stops when presentation throws after durability", async () => {
+    const s = subject();
+    vi.mocked(s.port.presentRecipientInput).mockImplementationOnce(() => { throw new Error("presentation failed"); });
+    await expect(s.send()).rejects.toMatchObject({
+      name: "RootTaskPersistenceFinalizationIndeterminateError",
+      stage: "post_durability_publication",
+    });
+    expect(s.order).toEqual(["write:1", "history_event", "reservation_commit", "release"]);
+    expect(s.reservations[0]!.cancel).not.toHaveBeenCalled();
+    expect(s.enterPersistenceFailStop).toHaveBeenCalledOnce();
+  });
+});
