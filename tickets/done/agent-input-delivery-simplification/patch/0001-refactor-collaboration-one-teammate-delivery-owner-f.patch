+import type {
+  AgentRunInputReservation,
+  CommittedAgentRunInput,
+} from "../../../agent-execution/input/agent-run-input-contract.js";
+import { validateCollaborationCommunicationMessageArrayV1 } from "./collaboration-communication-message-v1-schema.js";
+import type { CollaborationCommunicationMessageV1 } from "./collaboration-communication-message-v1.js";
+
+export type RootMessageAppendPreparation =
+  | Readonly<{ kind: "append"; messages: readonly CollaborationCommunicationMessageV1[] }>
+  | Readonly<{ kind: "conflict" }>;
+
+/** A coordinator's result for one append. An indeterminate write is thrown, never returned. */
+export type RootMessageAppendResult =
+  | Readonly<{ outcome: "committed" }>
+  | Readonly<{ outcome: "conflict" }>
+  | Readonly<{ outcome: "not_committed"; cause: Error }>;
+
+/**
+ * One message append, run once by a root persistence coordinator under its history lock
+ * (DS-002): `prepare`, write, then `cancelBeforeDurability` or `commitAfterDurability`.
+ * Built only by RootCommunicationEngine; the coordinator never touches the reservation.
+ */
+export type RootMessageAppend = Readonly<{
+  /** Open, duplicate and scope checks against the current list. A scope error is thrown with nothing changed. */
+  prepare(): RootMessageAppendPreparation;
+  cancelBeforeDurability(): void;
+  /** Throws only on a genuine local failure (list update, publication), which fail-stops the root. */
+  commitAfterDurability(): void;
+}>;
+
+export type RootMessageAppendControl = Readonly<{
+  append: RootMessageAppend;
+  /** Cancels the held slot when the coordinator threw before finishing the append. */
+  abandon(): void;
+  /** The closure found after the durable write (Task closed or recipient stopped), if any. */
+  closureAfterDurability(): Readonly<{ error: unknown }> | null;
+}>;
+
+type AppendState = "sealed" | "prepared" | "cancelled" | "committed" | "closed_after_durability";
+
+export const createRootMessageAppend = (input: Readonly<{
+  message: CollaborationCommunicationMessageV1;
+  reservation: AgentRunInputReservation;
+  isOpen(): boolean;
+  getMessages(): readonly CollaborationCommunicationMessageV1[];
+  setMessages(messages: readonly CollaborationCommunicationMessageV1[]): void;
+  assertDeliveryAllowed(): void;
+  publishMessage(): void;
+  presentRecipientInput(): void;
+}>): RootMessageAppendControl => {
+  let state: AppendState = "sealed";
+  let next: readonly CollaborationCommunicationMessageV1[] = [];
+  let closure: Readonly<{ error: unknown }> | null = null;
+  const cancel = () => {
+    state = "cancelled";
+    input.reservation.cancel();
+  };
+
+  const append: RootMessageAppend = Object.freeze({
+    prepare: () => {
+      if (state !== "sealed") throw new Error(`Root message append '${input.message.messageId}' is not sealed.`);
+      const current = input.getMessages();
+      if (!input.isOpen() || current.some((row) => row.messageId === input.message.messageId)) {
+        cancel();
+        return Object.freeze({ kind: "conflict" as const });
+      }
+      input.assertDeliveryAllowed();
+      next = validateCollaborationCommunicationMessageArrayV1([...current, input.message]);
+      state = "prepared";
+      return Object.freeze({ kind: "append" as const, messages: next });
+    },
+    cancelBeforeDurability: () => {
+      if (state === "prepared") cancel();
+    },
+    commitAfterDurability: () => {
+      if (state !== "prepared") return;
+      input.setMessages(next);
+      input.publishMessage();
+      let committed: CommittedAgentRunInput;
+      try {
+        input.assertDeliveryAllowed();
+        committed = input.reservation.commit();
+      } catch (error) {
+        // REQ-012: the history record stays; the recipient never gets the input. Not a fail-stop.
+        state = "closed_after_durability";
+        closure = Object.freeze({ error });
+        try { input.reservation.cancel(); } catch { /* the recipient already dropped the slot */ }
+        return;
+      }
+      state = "committed";
+      try {
+        input.presentRecipientInput();
+      } finally {
+        committed.release();
+      }
+    },
+  });
+
+  return Object.freeze({
+    append,
+    abandon: () => {
+      if (state === "sealed" || state === "prepared") cancel();
+    },
+    closureAfterDurability: () => closure,
+  });
+};
