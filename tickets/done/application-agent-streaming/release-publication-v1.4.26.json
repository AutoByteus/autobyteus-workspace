smo","label":"","name":"latest-linux.yml","size":413,"state":"uploaded","updatedAt":"2026-07-22T12:30:20Z","url":"https://github.com/AutoByteus/autobyteus-workspace/releases/download/v1.4.26/latest-linux.yml"},{"apiUrl":"https://api.github.com/repos/AutoByteus/autobyteus-workspace/releases/assets/485935532","contentType":"text/yaml","createdAt":"2026-07-22T12:30:20Z","digest":"sha256:15c3ff6ff997659453b37c0f8d50c4568a1cbc72b54ca3646e322f7dcd5a7040","downloadCount":0,"id":"RA_kwDORZKejM4c9sms","label":"","name":"latest-mac.yml","size":897,"state":"uploaded","updatedAt":"2026-07-22T12:30:20Z","url":"https://github.com/AutoByteus/autobyteus-workspace/releases/download/v1.4.26/latest-mac.yml"},{"apiUrl":"https://api.github.com/repos/AutoByteus/autobyteus-workspace/releases/assets/485935542","contentType":"text/yaml","createdAt":"2026-07-22T12:30:20Z","digest":"sha256:11f26fbfabe3123ecb28941122022db9a06793a65cd27e857871eefa5d3cae94","downloadCount":0,"id":"RA_kwDORZKejM4c9sm2","label":"","name":"latest.yml","size":354,"state":"uploaded","updatedAt":"2026-07-22T12:30:20Z","url":"https://github.com/AutoByteus/autobyteus-workspace/releases/download/v1.4.26/latest.yml"},{"apiUrl":"https://api.github.com/repos/AutoByteus/autobyteus-workspace/releases/assets/485925685","contentType":"application/json","createdAt":"2026-07-22T12:18:33Z","digest":"sha256:16a173f7b6ef23da20c69e4f22aea70c2da16b6c8cd0a157bd70f1ec17e5aaa1","downloadCount":0,"id":"RA_kwDORZKejM4c9qM1","label":"","name":"release-manifest.json","size":904,"state":"uploaded","updatedAt":"2026-07-22T12:18:33Z","url":"https://github.com/AutoByteus/autobyteus-workspace/releases/download/v1.4.26/release-manifest.json"}],"body":"# Release Notes — Application Agent Streaming And Socratic Live Tutor\n\n## What's New\n\n- Added a standard application-facing live agent stream for bound agents, whole teams, and selected static team members.\n- Added backend SDK helpers for constructing all three supported application agent target addresses.\n- Updated Socratic Math Teacher to stream tutor text live and reconcile it with the saved lesson transcript.\n\n## Improvements\n\n- Kept the public live stream intentionally provider-neutral with clear turn-start, text-delta, completion, interruption, and safe-error events.\n- Preserved durable published artifacts as the authoritative path for complete structured application results.\n- Prevented overlapping Socratic follow-up and hint actions while a tutor turn is still resolving.\n\n## Fixes\n\n- Fixed Socratic lesson closing so late background refreshes cannot reopen a lesson after it has closed.\n- Ensured the first live tutor response is observed by waiting for the application connection to be ready before sending input.\n","isDraft":false,"isPrerelease":false,"name":"v1.4.26","publishedAt":"2026-07-22T12:18:36Z","tagName":"v1.4.26","targetCommitish":"d043eb931ee0e7e584c8b2325f4ed1403178a3af","url":"https://github.com/AutoByteus/autobyteus-workspace/releases/tag/v1.4.26"}
