{
  "runtime": "antigravity_cli (scripted CLI), skillScope ALL_INSTALLED",
  "probe": {
    "result": {
      "apiHttp": "200",
      "gitStatus": 0,
      "psStatus": 0,
      "psEnvStatus": 0
    },
    "address": "http://127.0.0.1:59173/r/rp_<pass>/github/api",
    "gitConfig": [
      [
        "url.http://127.0.0.1:59173/r/rp_<pass>/github/git/.insteadOf",
        "https://github.com/"
      ]
    ],
    "terminalPrompt": "0",
    "issueNumber": 1,
    "lsRemoteHead": true,
    "tokenInShellOutputs": []
  },
  "statuses": {
    "skillDisabled": {
      "status": 403,
      "error": "INTEGRATION_NOT_ALLOWED"
    },
    "skillEnabledAgain": {
      "status": 200,
      "error": null
    },
    "stopped": {
      "status": 403,
      "error": "RUN_PASS_INVALID"
    }
  },
  "scan": {
    "onWire": false,
    "filesInDataDir": [],
    "filesInCodexHome": "not scanned (not a temp CODEX_HOME)"
  }
}