+      requests: [{ kind: "expose-resolved", skill: s.f.catalog.getSkill("writer")! }], workspaceCollisionPolicy: "fail",
+      onAcquired: receipt => owned.push(receipt), assertAccepting: () => { if (closed) throw Error("Task admission closed"); } });
+    const rejected = expect(preparing).rejects.toThrow("Task admission closed");
