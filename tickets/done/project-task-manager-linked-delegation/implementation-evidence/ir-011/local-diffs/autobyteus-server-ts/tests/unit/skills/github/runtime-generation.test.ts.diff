+  it("closes managed preparation before publication without changing a borrowed holder", async () => {
+    let block = false, closed = false;
+    let entered!: () => void, release!: () => void;
+    const waiting = new Promise<void>(resolve => { entered = resolve; });
+    const gate = new Promise<void>(resolve => { release = resolve; });
+    const s = await setup({ fileSystem: { stat: (async (...args: Parameters<typeof import("node:fs/promises").stat>) => {
+      if (block) { entered(); await gate; }
+      return fs.promises.stat(...args);
+    }) as typeof fs.promises.stat } });
+    const a = await s.run(); await s.update(); block = true;
+    const owned: any[] = [];
