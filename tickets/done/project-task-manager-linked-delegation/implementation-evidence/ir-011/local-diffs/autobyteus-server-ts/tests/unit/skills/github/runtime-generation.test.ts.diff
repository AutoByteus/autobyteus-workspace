+    const s = await setup({ fileSystem: {
+      stat: (async (...args: Parameters<typeof import("node:fs/promises").stat>) => {
+        if (block) { entered(); await gate; }
+        return fs.promises.stat(...args);
+      }) as typeof fs.promises.stat,
+      unlink: (async target => { if (fail) throw Error("unlink denied"); await fs.promises.unlink(target); }) as typeof fs.promises.unlink,
+    }, syncFileSystem: { renameSync: (old, next) => { if (fail) throw Error("transfer denied"); fs.renameSync(old, next); } } });
+    const a = await s.run(); await s.update(); block = true; fail = true;
