===== TEMP-001 missing IMAGE_REF fallback probe =====
from pathlib import Path
from scripts.tests.test_public_docker_launcher_shared_workspace import (
    fake_docker_environment,
    read_call_records,
    read_state_image_ref,
    run_launcher,
)

with fake_docker_environment() as env:
    run_launcher(env, "new-container", "--image", "autobyteus/test", "--tag", "latest-zh")
    state_file = Path(env["AUTOBYTEUS_DOCKER_STATE_DIR"]) / "nodes" / "autobyteus-server-0.env"
    state_lines = [line for line in state_file.read_text(encoding="utf-8").splitlines() if not line.startswith("IMAGE_REF=")]
    state_file.write_text("\n".join(state_lines) + "\n", encoding="utf-8")
    call_count_before_upgrade = len(read_call_records(env))
    result = run_launcher(env, "upgrade", "--all")
    target_image = read_state_image_ref(env, "autobyteus-server-0")
    upgrade_pulls = [
        record
        for record in read_call_records(env)[call_count_before_upgrade:]
        if record[:1] == ["pull"]
    ]
    assert target_image == "autobyteus/autobyteus-server:latest", target_image
    assert upgrade_pulls == [["pull", "autobyteus/autobyteus-server:latest"]], upgrade_pulls
    assert "Checking image autobyteus/autobyteus-server:latest" in result.stdout, result.stdout
    print("missing IMAGE_REF fallback ok", target_image, upgrade_pulls)
