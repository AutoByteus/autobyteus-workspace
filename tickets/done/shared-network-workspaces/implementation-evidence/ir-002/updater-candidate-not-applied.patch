@@ -55,0 +56,11 @@ describe('classifyAppUpdateError', () => {
+  it('does not classify a stack-frame path as a network failure', () => {
+    const error = new Error('disk write failed');
+    error.stack = 'Error: disk write failed\n    at /project/shared-network-workspaces/appUpdateErrorClassifier.ts:1:1';
+    const result = classifyAppUpdateError(error, {
+      operation: 'download',
+      fallbackMessage: 'Failed to download update.',
