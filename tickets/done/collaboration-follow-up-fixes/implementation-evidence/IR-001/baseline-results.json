    ],
    "exit": 1
  },
  {
    "name": "before-selection",
    "command": [
      "pnpm",
      "-C",
      "autobyteus-web",
      "test:nuxt",
      "stores/__tests__/workspaceSelectionComposition.spec.ts",
      "-t",
      "late prior Team success"
    ],
    "exit": 1
  },
  {
    "name": "baseline-web-typecheck",
    "command": [
      "pnpm",
      "--package=typescript@5.9.3",
