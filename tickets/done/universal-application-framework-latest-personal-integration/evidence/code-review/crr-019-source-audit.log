   205	  private validateRootInheritedSkillAccess(
   206	    teamConfigs: ReadonlyMap<AgentTeamAddress, TeamScopeLaunchInput>,
   207	    memberConfigs: ReadonlyMap<AgentTeamAddress, TeamAgentLaunchInput>,
   208	  ): void {
   209	    const rootMode = teamConfigs.get("/" as AgentTeamAddress)!.skillAccessMode;
   210	    const divergentTeam = [...teamConfigs.entries()].find(([, config]) => config.skillAccessMode !== rootMode);
   211	    if (divergentTeam) throw new Error(`Team '${divergentTeam[0]}' cannot override root skillAccessMode.`);
   212	    const divergentAgent = [...memberConfigs.entries()].find(([, config]) => config.skillAccessMode !== rootMode);
   213	    if (divergentAgent) throw new Error(`Agent '${divergentAgent[0]}' cannot override root skillAccessMode.`);
   214	  }
