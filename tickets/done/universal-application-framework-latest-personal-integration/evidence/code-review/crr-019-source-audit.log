   160	  private validateTeamConfigs(
   161	    values: readonly TeamScopeLaunchInput[],
   162	    index: GraphIndex,
   163	  ): ReadonlyMap<AgentTeamAddress, TeamScopeLaunchInput> {
   164	    const result = new Map<AgentTeamAddress, TeamScopeLaunchInput>();
   165	    for (const value of values) {
   166	      const address = assertAgentTeamAddress(value.teamAddress);
   167	      if (result.has(address)) throw new Error(`Duplicate Team launch settings for '${address}'.`);
   168	      if (index.agents.has(address)) throw new Error(`Team launch settings reference Agent placement '${address}'.`);
   169	      if (!index.teams.has(address)) throw new Error(`Team launch settings reference unknown Team '${address}'.`);
   170	      result.set(address, Object.freeze({
   171	        ...value,
   172	        ...cloneAgentLaunchConfiguration(value, `defaultLaunchConfiguration at '${address}'`),
   173	      }));
   174	    }
   175	    const missing = [...index.teams.keys()].find((address) => !result.has(address));
   176	    if (missing) throw new Error(`Launch settings for Team '${missing}' were not provided.`);
   177	    return result;
   178	  }
   179
   180	  private validateMemberConfigs(
   181	    values: readonly TeamAgentLaunchInput[],
   182	    index: GraphIndex,
   183	  ): ReadonlyMap<AgentTeamAddress, TeamAgentLaunchInput> {
   184	    const result = new Map<AgentTeamAddress, TeamAgentLaunchInput>();
   185	    for (const value of values) {
   186	      const address = assertAgentTeamAddress(value.memberAddress);
   187	      if (address === "/") throw new Error("Agent launch settings cannot reference root Team '/'.");
   188	      if (result.has(address)) throw new Error(`Duplicate Agent launch settings for '${address}'.`);
   189	      if (index.teams.has(address)) throw new Error(`Agent launch settings reference Team placement '${address}'.`);
   190	      const member = index.agents.get(address);
   191	      if (!member) throw new Error(`Agent launch settings reference unknown Team member '${address}'.`);
   192	      if (value.agentDefinitionId && value.agentDefinitionId !== member.agentDefinitionId) {
   193	        throw new Error(`Launch settings for '${address}' reference the wrong Agent definition.`);
   194	      }
   195	      result.set(address, Object.freeze({
   196	        ...value,
   197	        ...cloneAgentLaunchConfiguration(value, `launchConfiguration at '${address}'`),
   198	      }));
   199	    }
   200	    const missing = [...index.agents.keys()].find((address) => !result.has(address));
   201	    if (missing) throw new Error(`Launch settings for Team member '${missing}' were not provided.`);
   202	    return result;
   203	  }
