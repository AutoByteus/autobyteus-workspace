    22	export class TeamMemberRunViewProjectionService {
    23	  private readonly agentViews: AgentRunViewProjectionService;
    24	  private readonly locations: TeamRunExecutionTreeLocationService;
    25
    26	  constructor(options: {
    27	    memoryDir?: string;
    28	    agentRunViewProjectionService?: AgentRunViewProjectionService;
    29	    locations?: TeamRunExecutionTreeLocationService;
    30	  } = {}) {
    31	    const memoryDir = options.memoryDir ?? appConfigProvider.config.getMemoryDir();
    32	    this.agentViews = options.agentRunViewProjectionService ?? new AgentRunViewProjectionService(memoryDir);
    33	    this.locations = options.locations ?? new TeamRunExecutionTreeLocationService({ memoryDir });
    34	  }
    35
    36	  async getProjection(rootTeamRunId: string, agentRunId: string): Promise<TeamMemberRunProjection> {
    37	    const location = await this.requireLocation(rootTeamRunId, agentRunId);
    38	    const projection = await this.agentViews.getProjectionFromMetadata({
    39	      runId: location.agentRunId,
    40	      metadata: metadataFor(location),
    41	    });
    42	    return {
    43	      agentRunId: projection.runId,
    44	      conversation: projection.conversation,
    45	      activities: projection.activities,
    46	      summary: projection.summary,
    47	      lastActivityAt: projection.lastActivityAt,
    48	      hasEarlierActiveTraceEvents: projection.hasEarlierActiveTraceEvents,
    49	    };
    50	  }
    51
    52	  async getActiveTracePage(
    53	    rootTeamRunId: string,
    54	    agentRunId: string,
    55	    beforeCursor?: string | null,
    56	  ): Promise<EventMonitorActiveTracePage> {
    57	    const location = await this.requireLocation(rootTeamRunId, agentRunId);
    58	    return this.agentViews.getActiveTracePageFromMetadata({
    59	      runId: location.agentRunId,
    60	      metadata: metadataFor(location),
    61	      beforeCursor,
    62	      canonicalSubject: `team:${location.rootTeamRunId}:agent:${location.agentRunId}`,
    63	    });
    64	  }
    65
    66	  private async requireLocation(rootTeamRunId: string, agentRunId: string) {
    67	    const root = required(rootTeamRunId, "rootTeamRunId");
    68	    const run = required(agentRunId, "agentRunId");
    69	    const location = await this.locations.findAgent({ agentRunId: run });
    70	    if (!location || location.rootTeamRunId !== root) {
    71	      throw new Error(`AgentRun '${run}' was not found in root TeamRun '${root}'.`);
    72	    }
    73	    if (!location.configuredPlacement) {
    74	      throw new Error(`AgentRun '${run}' has no configured launch placement.`);
    75	    }
    76	    return location;

