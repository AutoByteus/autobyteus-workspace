### Runner runMigration invokes only the selected definition and validates prerequisites
    81	  async runMigration(migrationId: string): Promise<AppDataMigrationStatusSnapshot> {
    82	    const definition = this.registry.getDefinition(migrationId);
    83	    if (!definition) {
    84	      throw new Error(`Unknown app data migration '${migrationId}'.`);
    85	    }
    86	    if (definition.executionPolicy === "STARTUP_ONLY") {
    87	      throw new AppDataMigrationRestartRequiredError(definition.id);
    88	    }
    89	    const record = await this.runDefinition(definition);
    90	    return this.toStatusSnapshot(definition, record);
    91	  }
    92
    93	  private async runDefinition(
    94	    definition: AppDataMigrationDefinition,
    95	  ): Promise<AppDataMigrationRecordSnapshot> {
    96	    if (this.inFlight.has(definition.id)) {
    97	      throw new AppDataMigrationDuplicateRunError(definition.id);
    98	    }
    99
   100	    const runPromise = this.runDefinitionWithRecordLock(definition);
   101	    this.inFlight.set(definition.id, runPromise);
   102	    try {
   103	      return await runPromise;
   104	    } finally {
   105	      this.inFlight.delete(definition.id);
   106	    }
   107	  }
   108
   109	  private async runDefinitionWithRecordLock(
   110	    definition: AppDataMigrationDefinition,
   111	  ): Promise<AppDataMigrationRecordSnapshot> {
   112	    const existingRecord = await this.repository.getRecord(definition.id);
   113	    if (this.isCurrentlyRunning(existingRecord)) {
   114	      throw new AppDataMigrationDuplicateRunError(definition.id);
   115	    }
   116	    await this.assertPrerequisites(definition);
   117
   118	    return this.executeDefinition(definition);
   119	  }
   120
   121	  private async assertPrerequisites(definition: AppDataMigrationDefinition): Promise<void> {
   122	    const statuses = await Promise.all(
   123	      (definition.prerequisiteMigrationIds ?? []).map(async (migrationId) => ({
   124	        migrationId,
   125	        status: (await this.repository.getRecord(migrationId))?.status ?? "NOT_RUN" as const,
   126	      })),
   127	    );
   128	    const incomplete = statuses.filter(
   129	      ({ status }) => status !== "SUCCEEDED" && status !== "SUCCEEDED_WITH_WARNINGS",
   130	    );
   131	    if (incomplete.length > 0) {
   132	      throw new AppDataMigrationPrerequisiteError(definition.id, incomplete);
   133	    }
   134	  }

