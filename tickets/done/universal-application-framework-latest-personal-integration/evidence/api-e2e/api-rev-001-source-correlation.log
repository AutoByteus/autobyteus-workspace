APIE2E-F001 Socratic exact target source correlation
6. Current SDK requires exact agentRunId and validates membership.
    56	export const createApplicationAgentTeamMemberTargetAddress = (
    57	  binding: ApplicationAgentTeamBinding,
    58	  agentRunId: string,
    59	): ApplicationAgentTargetAddress => {
    60	  const bindingId = requireBindingId(binding);
    61	  requireRuntimeSubject(binding, "TEAM_RUN");
    62	
    63	  const normalizedAgentRunId = typeof agentRunId === "string" ? agentRunId.trim() : "";
    64	  if (!normalizedAgentRunId) {
    65	    throw new Error("Application agent-team member target requires agentRunId.");
    66	  }
    67	
    68	  const members = Array.isArray(binding.runtime.members) ? binding.runtime.members : [];
    69	  if (!members.some((member) => member?.agentRunId === normalizedAgentRunId)) {
    70	    throw new Error(
    71	      `Application agent-team binding '${bindingId}' does not contain agentRunId '${normalizedAgentRunId}'.`,
    72	    );
    73	  }
    74	
    75	  return {
    76	    bindingId,
    77	    target: {
    78	      kind: "AGENT_TEAM_MEMBER",
    79	      agentRunId: normalizedAgentRunId,
    80	    },
    81	  };
    82	};

7. Socratic production passes the feature-era route/member token "tutor" rather than binding.runtime.members[*].agentRunId.
    37	export const deriveTutorTargetAddress = (lesson: Pick<
    38	  LessonSummary,
    39	  "status" | "latestBindingId" | "latestBindingStatus"
    40	>, binding: ApplicationAgentBinding | ApplicationAgentTeamBinding | null): ApplicationAgentTargetAddress | null => {
    41	  if (lesson.status !== "active" || !lesson.latestBindingId || (
    42	    lesson.latestBindingStatus
    43	    && UNUSABLE_BINDING_STATUSES.has(lesson.latestBindingStatus)
    44	  ) || !binding || binding.status !== "ATTACHED") {
    45	    return null;
    46	  }
    47	
    48	  if (!isApplicationAgentTeamBinding(binding)) {
    49	    throw new Error("Socratic tutor binding must be an agent-team binding.");
    50	  }
    51	  return createApplicationAgentTeamMemberTargetAddress(binding, "tutor");
    52	};
