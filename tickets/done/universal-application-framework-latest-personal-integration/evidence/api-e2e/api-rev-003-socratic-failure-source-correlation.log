application-orchestration-host-service exact addressed target dispatch:
   437	  private async postAddressedRunInputInternal(
   438	    binding: ApplicationAgentBindingRecord,
   439	    address: ApplicationAgentTargetAddress,
   440	    input: ApplicationAgentInput,
   441	  ): Promise<void> {
   442	    rejectUnsupportedApplicationAgentInput(input);
   443	    const message = buildRuntimeInputMessage(input);
   444	    if (binding.runtime.subject === "AGENT_RUN") {
   445	      if (address.target.kind !== "AGENT_RUN") {
   446	        throw new Error("Application agent input target does not match the bound runtime.");
   447	      }
   448	      const run = await this.agentRunService.resolveAgentRun(binding.runtime.agentRunId);
   449	      if (!run) throw new Error(`Application runtime '${binding.runtime.agentRunId}' is not available.`);
   450	      const result = await run.postUserMessage(message);
   451	      if (!result.accepted) throw new Error(result.message ?? "Application runtime rejected the input.");
   452	      return;
   453	    }
   454	    if (address.target.kind === "AGENT_RUN") {
   455	      throw new Error("Application agent input target does not match the bound runtime.");
   456	    }
   457	    const run = await this.teamRunService.resolveActiveTeamRun(binding.runtime.teamRunId);
   458	    if (!run) throw new Error(`Application runtime '${binding.runtime.teamRunId}' is not available.`);
   459	    const targetAgentRunId = address.target.kind === "AGENT_TEAM_MEMBER" ? address.target.agentRunId : null;
   460	    const targetMember = targetAgentRunId
   461	      ? binding.runtime.members.find((member) => member.agentRunId === targetAgentRunId) ?? null
   462	      : null;
   463	    if (address.target.kind === "AGENT_TEAM_MEMBER" && !targetMember) {
   464	      throw new Error("Application agent input target does not belong to the bound team runtime.");
   465	    }
   466	    const targetMemberAddress = targetMember ? assertAgentTeamAddress(targetMember.memberAddress) : null;
   467	    const result = await run.postMessage(message, targetMemberAddress);
   468	    if (!result.accepted) throw new Error(result.message ?? "Application runtime rejected the input.");
   469	  }
   470	}

