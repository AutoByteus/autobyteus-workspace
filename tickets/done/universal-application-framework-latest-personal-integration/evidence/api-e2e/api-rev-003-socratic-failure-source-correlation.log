   235	  private async initializeReady(markRetrySafe: () => void): Promise<AgentRun> {
   236	    this.unsubscribe?.();
   237	    this.unsubscribe = null;
   238	    let candidate: AgentRunActivationCandidate | null = null;
   239	    try {
   240	      const config = await this.buildAgentRunConfig();
   241	      const plan = this.resolveActivationPlan(config);
   242	      candidate = await this.prepareCandidate(plan, config);
   243	      const binding = this.createExternalBinding(candidate);
   244	      if (binding) {
   245	        await this.options.acceptPlatformBinding(binding);
   246	        this.context.adoptPlatformAgentRunId(binding.platformAgentRunId);
   247	      }
   248	      const run = candidate.commitPublication();
   249	      this.bindEvents(run);
   250	      this.agentRun = run;
   251	      return run;
   252	    } catch (error) {
   253	      let cleanupConfirmed = candidate === null;
   254	      let failure = error;
   255	      if (candidate) {
   256	        const cleanup = await candidate.abort();
   257	        cleanupConfirmed = cleanup.kind === "aborted";
   258	        if (cleanup.kind === "quarantined") failure = this.cleanupError(candidate.runId, cleanup.error);
   259	      }
   260	      if (
   261	        cleanupConfirmed &&
   262	        !(failure instanceof TeamAgentPlatformBindingError && failure.indeterminate) &&
   263	        !isAgentRunActivationQuarantineError(failure)
   264	      ) markRetrySafe();
   265	      this.publishReadinessFailure(failure);
   266	      throw failure;
   267	    }
   268	  }
   269	
   270	  private resolveActivationPlan(config: AgentRunConfig): MixedAgentActivationPlan {
   271	    const external = isExternalProviderRuntimeKind(config.runtimeKind);
   272	    if (this.options.activationMode === "fresh") {
   273	      if (external) this.assertNoPriorConversationActivity(config);
   274	      return Object.freeze({ kind: "new" });
   275	    }

