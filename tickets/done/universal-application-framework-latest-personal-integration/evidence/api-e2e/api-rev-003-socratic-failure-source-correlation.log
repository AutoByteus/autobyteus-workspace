    94	  async postMessage(message: AgentInputUserMessage): Promise<AgentOperationResult> {
    95	    this.publishCommandStatus("initializing");
    96	    try {
    97	      const run = await this.ensureReady();
    98	      const result = await run.postUserMessage(message);
    99	      if (result.accepted) {
