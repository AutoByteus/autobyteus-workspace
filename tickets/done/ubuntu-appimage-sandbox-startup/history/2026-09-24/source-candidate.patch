+import assert from 'node:assert/strict'
+import { execFileSync } from 'node:child_process'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+const appImage = process.argv[2]
+if (!appImage) throw new Error('Usage: verify-linux-appimage-layout.mjs <AppImage>')
+const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'autobyteus-appimage-layout-'))
+try {
+  execFileSync(path.resolve(appImage), ['--appimage-extract'], {
+    cwd: tempDir,
+    // A full AppImage prints every extracted path, which exceeds Node's
+    // default captured-output buffer before the layout assertions can run.
+    stdio: ['ignore', 'ignore', 'pipe'],
+    timeout: 120_000,
+  })
+  const root = path.join(tempDir, 'squashfs-root')
+  const desktopFiles = fs.readdirSync(root).filter((name) => name.endsWith('.desktop'))
+  assert.equal(desktopFiles.length, 1, 'expected one embedded desktop entry')
+  const desktop = fs.readFileSync(path.join(root, desktopFiles[0]), 'utf8')
+  assert.match(desktop, /^Exec=AppRun --autobyteus-appimage-desktop-entry %U$/m)
+  assert.doesNotMatch(desktop, /^Exec=.*--no-sandbox/m)
+
+  const executable = fs.readdirSync(root).find((name) =>
+    name === 'autobyteus' && fs.statSync(path.join(root, name)).isFile())
+  assert.ok(executable, 'expected autobyteus package launcher')
+  const launcherPath = path.join(root, executable)
+  const realPath = `${launcherPath}-real`
+  assert.ok(fs.statSync(launcherPath).mode & 0o111, 'launcher must be executable')
+  assert.ok(fs.statSync(realPath).mode & 0o111, 'real Electron must be executable')
+  assert.match(fs.readFileSync(launcherPath, 'utf8'), /^#!\/bin\/bash/)
+  const fd = fs.openSync(realPath, 'r')
+  try {
+    const magic = Buffer.alloc(4)
+    assert.equal(fs.readSync(fd, magic, 0, 4, 0), 4)
+    assert.equal(magic.toString('hex'), '7f454c46')
+  } finally {
+    fs.closeSync(fd)
+  }
+  console.log(`Verified AppImage launcher, real ELF and desktop marker: ${appImage}`)
+} finally {
+  fs.rmSync(tempDir, { recursive: true, force: true })
+}
