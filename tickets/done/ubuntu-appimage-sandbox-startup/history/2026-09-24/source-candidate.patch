new file mode 100644
index 000000000..3678f3ce5
--- /dev/null
+++ b/autobyteus-web/build/appimage/launcher.sh
@@ -0,0 +1,121 @@
+#!/bin/bash
+# AppImage-only GUI launch boundary. A failed namespace probe is never a reason
+# to disable Chromium's sandbox without the real ELF's observed startup fatal.
+desktop_marker=--autobyteus-appimage-desktop-entry
+real="${0}-real"
+
+if [[ ! -x "$real" ]]; then
+  printf 'AutoByteus AppImage: real executable missing: %s\n' "$real" >&2
+  exit 127
+fi
+
+if [[ "${1-}" == "$desktop_marker" ]]; then
+  shift
+fi
+
+if [[ "${ELECTRON_RUN_AS_NODE-}" == 1 ]]; then
+  exec "$real" "$@"
+fi
+
+for argument in "$@"; do
+  if [[ "$argument" == --no-sandbox ]]; then
+    exec "$real" "$@"
+  fi
+done
+
+# Success is a fast-path hint only. All failure modes, including a missing
+# utility, must first try the actual Electron binary with the sandbox intact.
+if [[ -x /usr/bin/unshare && -x /usr/bin/timeout ]] &&
+    /usr/bin/env -u LD_LIBRARY_PATH LC_ALL=C /usr/bin/timeout 2s /usr/bin/unshare -Ur true >/dev/null 2>&1; then
+  exec "$real" "$@"
+fi
+
+capture_dir=$(mktemp -d "${TMPDIR:-/tmp}/autobyteus-sandbox.XXXXXXXX") || exit 1
+fifo="$capture_dir/stderr"
+fatal_marker="$capture_dir/fatal"
+mkfifo -m 600 "$fifo" || { rmdir "$capture_dir"; exit 1; }
+child_pid=
+drainer_pid=
+cleanup() {
+  if [[ -n "$drainer_pid" ]]; then
+    kill "$drainer_pid" 2>/dev/null || true
+    wait "$drainer_pid" 2>/dev/null || true
+  fi
+  rm -rf -- "$capture_dir"
+}
+trap cleanup EXIT
+forward_signal() {
+  local signal="$1"
+  if [[ -n "$child_pid" ]]; then
+    kill -s "$signal" "$child_pid" 2>/dev/null || true
+  fi
+}
+trap 'forward_signal HUP' HUP
+trap 'forward_signal INT' INT
+trap 'forward_signal TERM' TERM
+
+# Read at most 4096 bytes per turn. The rolling match buffer is bounded;
+# application stderr is immediately forwarded rather than spooled to disk.
+(
+  window=
+  fatal_regex="FATAL:sandbox/linux/suid/client/setuid_sandbox_host\\.cc:[0-9]+\\].*Rather than run without sandboxing I'm aborting now\\."
+  while true; do
+    chunk=
+    IFS= read -r -n 4096 chunk
+    read_status=$?
+    if [[ -z "$chunk" && "$read_status" -ne 0 ]]; then
+      break
+    fi
+    if [[ "$read_status" -eq 0 && ${#chunk} -lt 4096 ]]; then
+      printf '%s\n' "$chunk" >&2
+    else
+      printf '%s' "$chunk" >&2
+    fi
+    window="${window}${chunk}"
+    if [[ "$window" =~ $fatal_regex ]]; then
+      : > "$fatal_marker"
+    fi
+    if [[ "$read_status" -eq 0 && ${#chunk} -lt 4096 ]]; then
+      window=
+    elif (( ${#window} > 1024 )); then
+      window="${window: -1024}"
+    fi
+  done < "$fifo"
+) &
+drainer_pid=$!
+
+started_ns=$(/usr/bin/date +%s%N)
+"$real" "$@" 2> "$fifo" &
+child_pid=$!
+while true; do
+  wait "$child_pid"
+  child_status=$?
+  if ! kill -0 "$child_pid" 2>/dev/null; then
+    break
+  fi
+done
+finished_ns=$(/usr/bin/date +%s%N)
+
+# The ELF has exited. Give its drainer a bounded opportunity to flush; a
+# descendant that inherited stderr must not hold the wrapper forever.
+for ((attempt = 0; attempt < 20; attempt++)); do
+  if ! kill -0 "$drainer_pid" 2>/dev/null; then
+    break
+  fi
+  sleep 0.1
+done
+if kill -0 "$drainer_pid" 2>/dev/null; then
+  kill "$drainer_pid" 2>/dev/null || true
+fi
+wait "$drainer_pid" 2>/dev/null || true
+drainer_pid=
+
+if [[ "$child_status" -eq 133 && -f "$fatal_marker" ]] &&
+    (( finished_ns - started_ns <= 30000000000 )); then
+  printf 'AutoByteus AppImage: Chromium sandbox initialization failed; retrying this GUI launch with --no-sandbox (reduced process isolation).\n' >&2
+  cleanup
+  trap - EXIT
+  exec "$real" --no-sandbox "$@"
+fi
+
+exit "$child_status"
