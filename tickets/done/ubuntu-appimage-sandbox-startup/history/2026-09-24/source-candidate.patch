+test('positive probe: normal GUI exec remains sandboxed', () => {
+  const f = fixture('positive')
+  try {
+    let result = run(f, ['--autobyteus-appimage-desktop-entry', 'two words'])
+    assert.equal(result.status, 0)
+    assert.equal(fs.readFileSync(f.env.EVENT_FILE, 'utf8').trim(), 'two words')
+    assert.deepEqual(fs.readFileSync(f.env.ARGS_FILE).toString().split('\0').filter(Boolean), ['two words'])
+    result = run(f, ['two words'], { TEST_MODE: 'fatal' })
+    assert.equal(result.status, 133, 'positive probe directly execs the unmodified ELF')
+    assert.doesNotMatch(result.stderr, /retrying this GUI launch/)
+    assert.equal(fs.readFileSync(f.env.EVENT_FILE, 'utf8'), 'two words\ntwo words\n')
+    assert.equal(fs.readFileSync(f.env.PROBE_EVENT_FILE, 'utf8'), '-Ur true\n-Ur true\n')
+  } finally { f.dispose() }
+})
+
+test('missing probe: successful sandboxed ELF stays unmodified, fatal retries only after confirmation', () => {
+  const f = fixture('missing')
+  try {
+    let result = run(f, ['two words'])
+    assert.equal(result.status, 0)
+    assert.deepEqual(fs.readFileSync(f.env.ARGS_FILE).toString().split('\0').filter(Boolean), ['two words'])
+    assert.doesNotMatch(result.stderr, /retrying this GUI launch/)
+    result = run(f, ['two words'], { TEST_MODE: 'fatal' })
+    assert.equal(result.status, 0)
+    assert.match(result.stderr, /retrying this GUI launch with --no-sandbox/)
+    assert.deepEqual(fs.readFileSync(f.env.ARGS_FILE).toString().split('\0').filter(Boolean), ['--no-sandbox', 'two words'])
+    assert.equal(fs.readFileSync(f.env.EVENT_FILE, 'utf8'), 'two words\ntwo words\n--no-sandbox two words\n')
+    assert.ok(!fs.existsSync(f.env.PROBE_EVENT_FILE))
+  } finally { f.dispose() }
+})
+
+test('ambiguous probe failure cannot itself downgrade a successful sandboxed ELF', () => {
+  const f = fixture('ambiguous')
+  try {
+    const result = run(f, ['two words'])
+    assert.equal(result.status, 0)
+    assert.doesNotMatch(result.stderr, /retrying this GUI launch/)
+    assert.deepEqual(fs.readFileSync(f.env.ARGS_FILE).toString().split('\0').filter(Boolean), ['two words'])
+    assert.equal(fs.readFileSync(f.env.PROBE_EVENT_FILE, 'utf8'), '-Ur true\n')
+  } finally { f.dispose() }
+})
+
+test('negative probe: wrapper forwards TERM to supervised child', async () => {
+  const f = fixture()
+  try {
+    const child = spawn(f.launcher, [], { env: { ...f.env, TEST_MODE: 'signal' }, stdio: ['ignore', 'ignore', 'pipe'] })
+    let stderr = ''
+    child.stderr.setEncoding('utf8')
+    child.stderr.on('data', (chunk) => { stderr += chunk })
+    const deadline = Date.now() + 5000
+    while ((!fs.existsSync(f.env.READY_FILE) || !stderr.includes('live stderr')) && Date.now() < deadline) {
+      await new Promise((resolve) => setTimeout(resolve, 25))
+    }
+    assert.ok(fs.existsSync(f.env.READY_FILE), 'child started')
+    assert.match(stderr, /live stderr/, 'stderr is streamed while Electron is still running')
+    child.kill('SIGTERM')
+    const exit = await new Promise((resolve) => child.on('exit', (code, signal) => resolve({ code, signal })))
+    assert.deepEqual(exit, { code: 143, signal: null })
+    assert.equal(fs.readFileSync(f.env.SIGNAL_FILE, 'utf8'), 'terminated')
+  } finally { f.dispose() }
+})
diff --git a/autobyteus-web/scripts/verify-linux-appimage-layout.mjs b/autobyteus-web/scripts/verify-linux-appimage-layout.mjs
