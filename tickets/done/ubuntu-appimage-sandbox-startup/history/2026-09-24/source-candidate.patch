diff --git a/autobyteus-web/build/scripts/linuxAppImageLauncher.ts b/autobyteus-web/build/scripts/linuxAppImageLauncher.ts
new file mode 100644
index 000000000..1ca4b4892
--- /dev/null
+++ b/autobyteus-web/build/scripts/linuxAppImageLauncher.ts
@@ -0,0 +1,50 @@
+import * as fs from 'fs'
+import * as path from 'path'
+import { AfterPackContext } from 'electron-builder'
+
+export const APPIMAGE_DESKTOP_MARKER = '--autobyteus-appimage-desktop-entry'
+const REAL_EXECUTABLE_SUFFIX = '-real'
+
+export function installLinuxAppImageLauncher(context: AfterPackContext): void {
+  // LinuxPackager owns this field in builder 25.1.8 but its base hook type omits it.
+  const executableName = (context.packager as typeof context.packager & { executableName: string }).executableName
+  if (!executableName || path.basename(executableName) !== executableName) {
+    throw new Error(`Unexpected AppImage executable name: ${executableName}`)
+  }
+  const launcherPath = path.join(context.appOutDir, executableName)
+  const realPath = `${launcherPath}${REAL_EXECUTABLE_SUFFIX}`
+  const sourcePath = path.resolve(__dirname, '..', 'appimage', 'launcher.sh')
+
+  if (!fs.existsSync(sourcePath)) throw new Error(`AppImage launcher source missing: ${sourcePath}`)
+  const launcherSource = fs.readFileSync(sourcePath, 'utf8')
+  if (!launcherSource.includes(`desktop_marker=${APPIMAGE_DESKTOP_MARKER}`)) {
+    throw new Error('AppImage desktop marker does not match launcher source')
+  }
+  if (fs.existsSync(realPath)) throw new Error(`AppImage real executable already exists: ${realPath}`)
+  if (!fs.existsSync(launcherPath) || !fs.statSync(launcherPath).isFile()) {
+    throw new Error(`Expected AppImage ELF not found: ${launcherPath}`)
+  }
+  if ((fs.statSync(launcherPath).mode & 0o111) === 0) {
+    throw new Error(`Expected executable AppImage ELF: ${launcherPath}`)
+  }
+  const fd = fs.openSync(launcherPath, 'r')
+  try {
+    const magic = Buffer.alloc(4)
+    if (fs.readSync(fd, magic, 0, 4, 0) !== 4 || magic.toString('hex') !== '7f454c46') {
+      throw new Error(`Expected AppImage ELF magic at: ${launcherPath}`)
+    }
+  } finally {
+    fs.closeSync(fd)
+  }
+
+  fs.renameSync(launcherPath, realPath)
+  try {
+    fs.copyFileSync(sourcePath, launcherPath, fs.constants.COPYFILE_EXCL)
+    fs.chmodSync(launcherPath, 0o755)
+  } catch (error) {
+    fs.rmSync(launcherPath, { force: true })
+    fs.renameSync(realPath, launcherPath)
+    throw error
+  }
+  console.log(`  Installed AppImage launcher: ${launcherPath} -> ${realPath}`)
+}
diff --git a/autobyteus-web/build/scripts/macNativeResourceModes.ts b/autobyteus-web/build/scripts/macNativeResourceModes.ts
new file mode 100644
index 000000000..814a7da28
--- /dev/null
+++ b/autobyteus-web/build/scripts/macNativeResourceModes.ts
@@ -0,0 +1,48 @@
+import * as path from 'path'
+import * as fs from 'fs'
+import { AfterPackContext } from 'electron-builder'
+
+function getAllFiles(dirPath: string, files: string[] = []): string[] {
+  if (!fs.existsSync(dirPath)) return files
+
+  const entries = fs.readdirSync(dirPath, { withFileTypes: true })
+  for (const entry of entries) {
+    const fullPath = path.join(dirPath, entry.name)
+    if (entry.isDirectory()) {
+      getAllFiles(fullPath, files)
+    } else if (entry.isFile()) {
+      files.push(fullPath)
+    }
+  }
+
+  return files
+}
+
+function normalizeNodePtySpawnHelpers(resourcesPath: string): void {
+  const nodeModulesPath = path.join(resourcesPath, 'node_modules')
+  const scanRoot = fs.existsSync(nodeModulesPath) ? nodeModulesPath : resourcesPath
+  const helpers = getAllFiles(scanRoot).filter((filePath) => (
+    path.basename(filePath) === 'spawn-helper' &&
+    filePath.split(path.sep).includes('node-pty')
+  ))
+
+  for (const helper of helpers) {
+    const currentMode = fs.statSync(helper).mode & 0o777
+    fs.chmodSync(helper, currentMode | 0o111)
+  }
+
+  console.log(`  Normalized execute bits on ${helpers.length} node-pty spawn-helper file(s)`)
+}
+
+export function normalizeMacNativeResourceModes(context: AfterPackContext): void {
+  const appPath = path.join(context.appOutDir, `${context.packager.appInfo.productFilename}.app`)
+  const resourcesPath = path.join(appPath, 'Contents', 'Resources', 'server')
+
+  if (!fs.existsSync(resourcesPath)) {
+    console.log(`  Server resources not found at ${resourcesPath}, skipping`)
+    return
+  }
+
+  console.log('\nNormalizing packaged terminal native resources...')
+  normalizeNodePtySpawnHelpers(resourcesPath)
+}
