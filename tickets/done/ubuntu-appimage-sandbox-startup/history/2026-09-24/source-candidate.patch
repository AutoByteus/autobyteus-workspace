diff --git a/autobyteus-web/scripts/test-appimage-launcher.mjs b/autobyteus-web/scripts/test-appimage-launcher.mjs
new file mode 100644
index 000000000..050c7de20
--- /dev/null
+++ b/autobyteus-web/scripts/test-appimage-launcher.mjs
@@ -0,0 +1,213 @@
+import assert from 'node:assert/strict'
+import { spawn, spawnSync } from 'node:child_process'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import test from 'node:test'
+
+const webRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const launcherSource = path.join(webRoot, 'build/appimage/launcher.sh')
+const { installLinuxAppImageLauncher } = await import('../build/dist/linuxAppImageLauncher.js')
+const afterPack = (await import('../build/dist/afterPack.js')).default.default
+const productionLauncher = fs.readFileSync(launcherSource, 'utf8')
+// Patch only each test-owned copy. The shipped launcher retains its two fixed,
+// trusted /usr/bin/unshare references and has no runtime probe override.
+assert.equal((productionLauncher.match(/\/usr\/bin\/unshare/g) ?? []).length, 2)
+assert.ok(fs.statSync('/usr/bin/timeout').mode & 0o111)
+const fatalLine = "[123:0924/114230.900112:FATAL:sandbox/linux/suid/client/setuid_sandbox_host.cc:166] The SUID sandbox helper binary was found, but is not configured correctly. Rather than run without sandboxing I'm aborting now."
+
+function fixture(probeOutcome = 'negative') {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'autobyteus-launcher-test-'))
+  const launcher = path.join(dir, 'autobyteus')
+  const probe = path.join(dir, 'unshare-stub')
+  fs.writeFileSync(launcher, productionLauncher.replaceAll('/usr/bin/unshare', probe))
+  fs.chmodSync(launcher, 0o755)
+  if (probeOutcome !== 'missing') {
+    fs.writeFileSync(probe, `#!/bin/bash
+printf '%s\\n' "$*" >> "$PROBE_EVENT_FILE"
+case "$PROBE_OUTCOME" in
+  positive) exit 0 ;;
+  negative) printf 'unshare: permission denied\\n' >&2; exit 1 ;;
+  ambiguous) printf 'unshare: unexpected utility failure\\n' >&2; exit 124 ;;
+esac
+exit 99
+`)
+    fs.chmodSync(probe, 0o755)
+  }
+  fs.writeFileSync(`${launcher}-real`, `#!/bin/bash
+printf '%s\\n' "$*" >> "$EVENT_FILE"
+printf '%s\\0' "$@" > "$ARGS_FILE"
+if [[ "\${TEST_MODE-}" == fatal && "\${ELECTRON_RUN_AS_NODE-}" != 1 && " $* " != *" --no-sandbox "* ]]; then
+  printf '%s\\n' "$FATAL_LINE" >&2
+  exit "\${FATAL_STATUS:-133}"
+fi
+if [[ "\${TEST_MODE-}" == unrelated ]]; then
+  printf 'unrelated crash\\n' >&2
+  exit 133
+fi
+if [[ "\${TEST_MODE-}" == signal ]]; then
+  trap 'printf terminated > "$SIGNAL_FILE"; exit 143' TERM
+  printf 'live stderr\\n' >&2
+  printf ready > "$READY_FILE"
+  while true; do sleep 0.1; done
+fi
+printf 'live stderr\\n' >&2
+exit 0
+`)
+  fs.chmodSync(`${launcher}-real`, 0o755)
+  const { ELECTRON_RUN_AS_NODE: _ignoredNodeMode, ...baseEnv } = process.env
+  const env = {
+    ...baseEnv,
+    EVENT_FILE: path.join(dir, 'events'),
+    ARGS_FILE: path.join(dir, 'args'),
+    SIGNAL_FILE: path.join(dir, 'signal'),
+    READY_FILE: path.join(dir, 'ready'),
+    PROBE_EVENT_FILE: path.join(dir, 'probe-events'),
+    PROBE_OUTCOME: probeOutcome,
+    FATAL_LINE: fatalLine,
+  }
+  return { dir, launcher, env, dispose: () => fs.rmSync(dir, { recursive: true, force: true }) }
+}
+
+function run(f, args = [], extraEnv = {}) {
+  return spawnSync(f.launcher, args, { env: { ...f.env, ...extraEnv }, encoding: 'utf8', timeout: 10_000 })
+}
+
+test('build hook installs an executable wrapper and preserves a real ELF; fails on duplicate or wrong layout', async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'autobyteus-hook-test-'))
+  try {
+    const elf = path.join(dir, 'autobyteus')
+    fs.copyFileSync('/bin/true', elf)
+    const context = { appOutDir: dir, packager: { executableName: 'autobyteus' }, electronPlatformName: 'linux', targets: [{ name: 'appImage' }] }
+    installLinuxAppImageLauncher(context)
+    assert.equal(fs.readFileSync(`${elf}-real`).subarray(0, 4).toString('hex'), '7f454c46')
+    assert.match(fs.readFileSync(elf, 'utf8'), /^#!\/bin\/bash/)
+    assert.ok(fs.statSync(elf).mode & 0o111)
+    assert.throws(() => installLinuxAppImageLauncher(context), /already exists/)
+    const other = fs.mkdtempSync(path.join(os.tmpdir(), 'autobyteus-hook-other-'))
+    try {
+      const nonAppImage = { ...context, appOutDir: other, targets: [{ name: 'deb' }] }
+      await afterPack(nonAppImage)
+      assert.deepEqual(fs.readdirSync(other), [])
+      fs.writeFileSync(path.join(other, 'autobyteus'), 'not ELF')
+      fs.chmodSync(path.join(other, 'autobyteus'), 0o755)
+      assert.throws(() => installLinuxAppImageLauncher({ ...context, appOutDir: other }), /ELF magic/)
+    } finally {
+      fs.rmSync(other, { recursive: true, force: true })
+    }
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+test('Node mode and explicit no-sandbox preserve argv and bypass GUI decision', () => {
+  const f = fixture()
+  try {
+    let result = run(f, ['--autobyteus-appimage-desktop-entry', 'two words'], { ELECTRON_RUN_AS_NODE: '1', TEST_MODE: 'fatal' })
+    assert.equal(result.status, 0)
+    assert.deepEqual(fs.readFileSync(f.env.ARGS_FILE).toString().split('\0').filter(Boolean), ['two words'])
+    result = run(f, ['--no-sandbox', 'two words'], { TEST_MODE: 'fatal' })
+    assert.equal(result.status, 0)
+    assert.deepEqual(fs.readFileSync(f.env.ARGS_FILE).toString().split('\0').filter(Boolean), ['--no-sandbox', 'two words'])
+    assert.ok(!fs.existsSync(f.env.PROBE_EVENT_FILE), 'Node and explicit-flag launches bypass the probe')
+  } finally { f.dispose() }
+})
+
+test('negative probe: sandboxed success remains sandboxed; exact startup fatal retries once', () => {
+  const f = fixture()
+  try {
+    let result = run(f, ['--autobyteus-appimage-desktop-entry', 'two words'])
+    assert.equal(result.status, 0)
+    assert.match(result.stderr, /live stderr/)
+    assert.equal(fs.readFileSync(f.env.EVENT_FILE, 'utf8').trim(), 'two words')
+    result = run(f, ['two words'], { TEST_MODE: 'fatal' })
+    assert.equal(result.status, 0)
+    assert.match(result.stderr, /retrying this GUI launch with --no-sandbox/)
+    assert.equal(fs.readFileSync(f.env.EVENT_FILE, 'utf8').trim().split('\n').length, 3)
+    assert.equal(fs.readFileSync(f.env.PROBE_EVENT_FILE, 'utf8'), '-Ur true\n-Ur true\n')
+    assert.deepEqual(fs.readFileSync(f.env.ARGS_FILE).toString().split('\0').filter(Boolean), ['--no-sandbox', 'two words'])
+  } finally { f.dispose() }
+})
+
+test('negative probe: unrelated exit 133 is propagated without downgrade', () => {
+  const f = fixture()
+  try {
+    const result = run(f, [], { TEST_MODE: 'unrelated' })
+    assert.equal(result.status, 133)
+    assert.doesNotMatch(result.stderr, /retrying this GUI launch/)
+    assert.equal(fs.readFileSync(f.env.EVENT_FILE, 'utf8'), '\n')
+  } finally { f.dispose() }
+})
+
+test('negative probe: fatal signature without status 133 cannot downgrade', () => {
+  const f = fixture()
+  try {
+    const result = run(f, [], { TEST_MODE: 'fatal', FATAL_STATUS: '1' })
+    assert.equal(result.status, 1)
+    assert.doesNotMatch(result.stderr, /retrying this GUI launch/)
+    assert.equal(fs.readFileSync(f.env.EVENT_FILE, 'utf8'), '\n')
