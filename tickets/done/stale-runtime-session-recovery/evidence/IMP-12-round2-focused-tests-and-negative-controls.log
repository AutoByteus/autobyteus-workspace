## The script
#!/bin/bash
# IMP-12: round-2 focused tests on HEAD, then one negative control per wiring piece (each edit reverted right after).
cd "$1/autobyteus-server-ts" || exit 1
FILES="tests/unit/application-platform/application-scope-session-renewal.test.ts tests/unit/application-platform/application-execution-scope-kernel-builder.test.ts tests/unit/standalone-application-host/host-session-renewal-wiring.test.ts tests/unit/standalone-application-host/standalone-application-host-lifecycle.test.ts tests/unit/agent-execution/domain/runtime-switch-session-renewal.test.ts tests/unit/agent-execution/backends/codex/thread/codex-thread-manager.test.ts"
run() { for f in $FILES; do pnpm exec vitest run $f 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -E "Tests +[0-9]" | sed "s|^|$(basename $f): |"; done; }
echo "## Focused files"; echo "$FILES" | tr ' ' '\n'
echo; echo "## Baseline (unchanged source)"; run
control() {
  cp "$2" /tmp/599-ev/bak; python3 -I -c "import sys;p,o,n=sys.argv[1:4];s=open(p).read();assert s.count(o)==1,o;open(p,'w').write(s.replace(o,n))" "$2" "$3" "$4" || { echo "CONTROL EDIT FAILED: $1"; return; }
  echo; echo "## $1"; echo "edit: $2: '$3' -> '$4'"; run; cp /tmp/599-ev/bak "$2"
}
K=src/application-platform/execution/application-execution-scope-kernel-builder.ts
H=src/standalone-application-host/start-standalone-application-host.ts
G=src/agent-execution/runtime/general-process-run-supervisor.ts
control "NC-R2-01 Application scope: no input preface" $K '      inputPreface: platformInputNotices,
' ''
control "NC-R2-02a Application scope: run manager without the lifecycle observer" $K '      lifecycleObserver: platformInputNotices,
    });
    const metadataService' '    });
    const metadataService'
control "NC-R2-02b Application scope: resource manager without the lifecycle observer" $K '      lifecycleObserver: platformInputNotices,
      mcpServerInstances' '      mcpServerInstances'
control "NC-R2-03 Application scope: no switch memory" $K '      switching: { memory: getDefaultRuntimeSwitchMemory() },
' ''
control "NC-R2-04 Host: no runtimeSwitching" $H '        runtimeSwitching: { memory: new RuntimeSwitchRecorder() },
' ''
control "NC-R2-05 Host: hand-over notice last, not first" $H '          new RuntimeHandoverNoticeService({ journals: getWorkJournalService(), readPending: readPendingRuntimeHandover }),
          ...platformNotices.sources,' '          ...platformNotices.sources,
          new RuntimeHandoverNoticeService({ journals: getWorkJournalService(), readPending: readPendingRuntimeHandover }),'
control "NC-R2-06 Host: no hand-over notice" $H '          new RuntimeHandoverNoticeService({ journals: getWorkJournalService(), readPending: readPendingRuntimeHandover }),
' ''
control "NC-R2-07 Supervisor: no input preface" $G '        inputPreface: input.platformInputNotices ?? null,
' ''
control "NC-R2-08 Supervisor: lifecycle without the switch port" $G '        switching: input.runtimeSwitching ?? null,' '        switching: null,'
echo; echo "## After the controls"; git status --short src
