+/**
+ * The identified turn one ordered consumer of a run's event stream considers active, and the
+ * turns it has seen end. Two kinds of evidence feed it:
+ * - stream evidence (a turn's own start/terminal events, an accepted command): ordered with the
+ *   events being projected, so a newer stream start supersedes and retires the previous turn;
+ * - runtime-snapshot evidence (the runtime's live current turn): possibly ahead of the queued
+ *   events, so it only names a turn while the stream has none, never retires one, and is
+ *   replaced without retirement when the stream reports a turn.
+ */
+export class AgentTurnIdentity {
+  private active: { turnId: string; evidence: "stream" | "runtime_snapshot" } | null = null;
+  private readonly retired = new Set<string>();
+
+  get activeTurnId(): string | null {
+    return this.active?.turnId ?? null;
+  }
+
+  isRetired(turnId: string): boolean {
+    return this.retired.has(turnId);
+  }
+
+  /** Returns the turn this start superseded and retired, if any. */
+  observeStreamStart(turnId: string): string | null {
+    if (this.retired.has(turnId)) return null;
+    const previous = this.active;
+    this.active = { turnId, evidence: "stream" };
+    if (previous && previous.turnId !== turnId && previous.evidence === "stream") {
+      this.retired.add(previous.turnId);
+      return previous.turnId;
+    }
+    return null;
+  }
+
+  /** Returns whether the snapshot turn is now the active turn. */
+  observeRuntimeSnapshotTurn(turnId: string): boolean {
+    if (this.retired.has(turnId)) return false;
+    if (this.active?.evidence === "stream") return this.active.turnId === turnId;
+    this.active = { turnId, evidence: "runtime_snapshot" };
+    return true;
+  }
+
+  /** The turn ended (its own terminal, a turn-terminal error). */
+  retire(turnId: string): void {
+    this.retired.add(turnId);
+    if (this.active?.turnId === turnId) this.active = null;
+  }
+
+  /** Ends the active turn (runtime-global failure, termination). */
+  retireActive(): string | null {
+    const turnId = this.active?.turnId ?? null;
+    if (turnId) this.retire(turnId);
+    return turnId;
+  }
+
+  /** Forgets the active turn without ending it (the run released its runtime). */
+  clearActive(): void {
+    this.active = null;
+  }
+}
