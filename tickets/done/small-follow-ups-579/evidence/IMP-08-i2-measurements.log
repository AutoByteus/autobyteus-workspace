== phase reporter ==
// Logs each hook and each test with its duration (autobyteus-579 I-2 measurement; not committed).
const started = new Map();
const name = (entity) => (entity.fullName ?? entity.name ?? entity.moduleId ?? "?");
export default class PhaseReporter {
  onUserConsoleLog(log) { if (String(log.content).includes("PHASE")) process.stdout.write(String(log.content)); }
  onHookStart(hook) { started.set(hook, Date.now()); }
  onHookEnd(hook) {
    const ms = Date.now() - (started.get(hook) ?? Date.now());
    const owner = hook.entity?.type === "module" ? "file" : name(hook.entity ?? {});
    console.log(`PHASE hook ${hook.name} ${ms} ms :: ${String(owner).slice(0, 100)}`);
  }
  onTestCaseResult(test) {
    const d = test.diagnostic?.();
    console.log(`PHASE test ${Math.round(d?.duration ?? 0)} ms ${test.result().state} :: ${test.name.slice(0, 100)}`);
  }
  onTestModuleEnd(module) {
    const d = module.diagnostic?.();
    console.log(`PHASE module total ${Math.round(d?.duration ?? 0)} ms, setup ${Math.round(d?.setupDuration ?? 0)}, collect ${Math.round(d?.collectDuration ?? 0)}, prepare ${Math.round(d?.prepareDuration ?? 0)}, environment ${Math.round(d?.environmentSetupDuration ?? 0)} :: ${module.moduleId.split('/').pop()}`);
  }
}

