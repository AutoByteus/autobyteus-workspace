#!/bin/bash
# start: launches CPU spinners and file churners, writing their pids to /tmp/579-tools/stress.pids; stop: ends them.
case "$1" in
  start)
    : > /tmp/579-tools/stress.pids
    for i in $(seq 1 ${CPU:-12}); do (while :; do :; done) & echo $! >> /tmp/579-tools/stress.pids; done
    for i in $(seq 1 ${CHURN:-4}); do node /tmp/579-tools/churn.mjs & echo $! >> /tmp/579-tools/stress.pids; done
    ;;
  stop)
    while read pid; do kill $pid 2>/dev/null; done < /tmp/579-tools/stress.pids; sleep 1
    while read pid; do kill -9 $pid 2>/dev/null; done < /tmp/579-tools/stress.pids
    rm -rf ${TMPDIR:-/tmp}/579-churn-* 2>/dev/null; : > /tmp/579-tools/stress.pids
    ;;
esac

// File-event churn to load fseventsd (autobyteus-579 I-2 measurement only): writes, renames and deletes files in its own temp tree.
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
const root = fs.mkdtempSync(path.join(os.tmpdir(), "579-churn-"));
process.on("SIGTERM", () => { fs.rmSync(root, { recursive: true, force: true }); process.exit(0); });
let i = 0;
for (;;) {
  const dir = path.join(root, `d${i % 200}`);
  fs.mkdirSync(dir, { recursive: true });
  const file = path.join(dir, `f${i}.txt`);
  fs.writeFileSync(file, "x".repeat(512));
  fs.renameSync(file, `${file}.r`);
  fs.rmSync(`${file}.r`);
  i++;
  if (i % 5000 === 0) await new Promise((r) => setImmediate(r));
}

// How long creating and closing a recursive fs.watch blocks the main thread (TESTING.md "File watching on a busy Mac").
import fs from "node:fs"; import os from "node:os"; import path from "node:path";
const root = fs.mkdtempSync(path.join(os.tmpdir(), "579-watchclose-"));
for (let i = 0; i < 50; i++) { fs.mkdirSync(path.join(root, `d${i}`)); fs.writeFileSync(path.join(root, `d${i}`, "f.txt"), "x"); }
const results = [];
for (let r = 0; r < 3; r++) {
  let t = performance.now(); const w = fs.watch(root, { recursive: true }, () => {}); const open = performance.now() - t;
  const ev = await new Promise((resolve) => { const s = performance.now(); const w2 = fs.watch(root, { recursive: true }, () => { w2.close(); resolve(performance.now() - s); }); fs.writeFileSync(path.join(root, `probe${r}.txt`), "p"); setTimeout(() => { w2.close(); resolve(-1); }, 20000); });
  t = performance.now(); w.close(); const close = performance.now() - t;
  results.push({ open: Math.round(open), eventMs: Math.round(ev), close: Math.round(close) });
}
fs.rmSync(root, { recursive: true, force: true });
console.log(JSON.stringify(results));

