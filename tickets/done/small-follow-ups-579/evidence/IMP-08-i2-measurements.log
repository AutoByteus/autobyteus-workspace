# Temporary I-2 instrumentation (autobyteus-579): wraps each hook body with a timer and logs fetch calls over 200 ms.
import sys, re
p=sys.argv[1]
s=open(p).read()
def close_of(s, i):
    depth=0; q=None; j=i
    while j < len(s):
        c=s[j]
        if q:
            if c=='\\': j+=2; continue
            if c==q: q=None
        elif c in '"\'`': q=c
        elif c=='(': depth+=1
        elif c==')':
            depth-=1
            if depth==0: return j
        j+=1
    raise Exception('no close')
out=s; pos=0; n=0
while True:
    m=re.compile(r'\b(beforeAll|afterAll|beforeEach|afterEach)\((async )?\(').search(out, pos)
    if not m: break
    open_paren=out.index('(', m.start())
    fn_start=open_paren+1
    # the function argument ends at the first top-level comma or the closing paren of the hook call
    close=close_of(out, open_paren)
    # find end of function argument: scan from fn_start tracking depth
    depth=0; q=None; j=fn_start; fn_end=None
    while j<close:
        c=out[j]
        if q:
            if c=='\\': j+=2; continue
            if c==q: q=None
        elif c in '"\'`': q=c
        elif c in '({[': depth+=1
        elif c in ')}]': depth-=1
        elif c==',' and depth==0: fn_end=j; break
        j+=1
    if fn_end is None: fn_end=close
    label=m.group(1)
    out=out[:fn_start]+f'__timed("{label}", '+out[fn_start:fn_end]+')'+out[fn_end:]
    pos=fn_end+len(f'__timed("{label}", ')+1; n+=1
head='''const __timed = (name: string, fn: () => any) => async () => { const t = Date.now(); try { return await fn(); } finally { console.log(`PHASE hook ${name} ${Date.now() - t} ms`); } };
{ const f = globalThis.fetch; globalThis.fetch = (async (...a: any[]) => { const t = Date.now(); try { return await (f as any)(...a); } finally { const ms = Date.now() - t; if (ms > 200) console.log(`PHASE fetch ${ms} ms ${String(a[0]).slice(0, 120)}`); } }) as any; }
'''
open(p,'w').write(head+out)
print('wrapped', n)

