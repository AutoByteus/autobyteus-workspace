#!/bin/bash
# IMP-xx (autobyteus-579): one negative control per change; each edit is reverted right after its run.
cd "$1/autobyteus-server-ts" || exit 1
run() { pnpm exec vitest run "$@" --no-watch 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -E "Tests +[0-9]|^ +× |^(Error|AssertionError)|ENVIRONMENT:|INCONCLUSIVE:" | head -8; }
control() { # label file old new test-files...
  local label="$1" file="$2" old="$3" new="$4"; shift 4
  cp "$file" /tmp/579-tools/bak; python3 -I -c "import sys;p,o,n=sys.argv[1:4];s=open(p).read();assert s.count(o)==1,o;open(p,'w').write(s.replace(o,n))" "$file" "$old" "$new" || { echo "CONTROL EDIT FAILED: $label"; return; }
  echo; echo "## $label"; echo "edit: $file"; run "$@"; cp /tmp/579-tools/bak "$file"
}
R=src/api/graphql/types/file-explorer.ts
control "NC-I1 fileContent answers a missing file as JSON text again" $R \
  'if (lower.includes("file not found")) throw fileContentRefusal(message, "FILE_NOT_FOUND");' \
  'if (lower.includes("file not found")) return jsonError(message);' \
  tests/e2e/file-explorer/file-operations-graphql.e2e.test.ts
control "NC-I1b a workspace access refusal loses its code" $R \
  'if (error instanceof WorkspaceAccessError) throw fileContentRefusal(message, error.code);' \
  'if (error instanceof WorkspaceAccessError) throw fileContentRefusal(message, "FILE_READ_FAILED");' \
  tests/unit/api/semantic-memory-workspace-access.test.ts
P=tests/helpers/os-file-event-probe.ts
control "NC-I3 the probe labels a silent OS INCONCLUSIVE (labels swapped)" $P \
  'return new Error(`${await osDeliversFileEvents(options) ? INCONCLUSIVE_LABEL : ENVIRONMENT_LABEL}\n${detail}`);' \
  'return new Error(`${await osDeliversFileEvents(options) ? ENVIRONMENT_LABEL : INCONCLUSIVE_LABEL}\n${detail}`);' \
  tests/unit/e2e-helpers/os-file-event-probe.test.ts
C=tests/unit/file-explorer/watcher/chokidar-watcher-runtime-links.test.ts
control "NC-I3b a chokidar wait that is never met fails with the probe's label (wiring)" $C \
  'await waitFor(() => rawPaths().some((p) => p.endsWith("notes.md")), 15_000, "the notes.md event");' \
  'await waitFor(() => rawPaths().some((p) => p.endsWith("never-written.md")), 3_000, "the never-written.md event");' \
  $C
Q=tests/e2e/remote-access/request-origin-and-phone-routes.e2e.test.ts
control "NC-I2 a refused origin among the accepted ones still fails the concurrent check" $Q \
  '      ["configured origin", { Origin: CONFIGURED_ORIGIN }],' \
  '      ["configured origin", { Origin: CONFIGURED_ORIGIN }],
      ["a near miss", { Origin: "https://desktop.tail.ts.net.evil.example", Host: "desktop.tail.ts.net" }],' \
  $Q
echo; echo "## After the controls"; git status --short src tests
