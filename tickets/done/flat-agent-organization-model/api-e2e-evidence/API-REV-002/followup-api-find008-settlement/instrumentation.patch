+++ b/autobyteus-server-ts/src/api-e2e-probe/correlation-probe.ts
@@ -0,0 +1,59 @@
+import { appendFileSync } from "node:fs";
+import { AsyncLocalStorage } from "node:async_hooks";
+
+type ProbeContext = Readonly<Record<string, unknown>>;
+
+const contextStorage = new AsyncLocalStorage<ProbeContext>();
+
+export const withApiE2eProbeContext = <T>(
+  context: ProbeContext,
+  operation: () => T,
+): T => contextStorage.run(Object.freeze({ ...context }), operation);
+
+export const getApiE2eProbeContext = (): ProbeContext | null =>
+  contextStorage.getStore() ?? null;
+
+export const apiE2eProbe = (
+  stage: string,
+  fields: Readonly<Record<string, unknown>> = {},
+): void => {
+  const file = process.env.AUTOBYTEUS_API_E2E_PROBE_LOG?.trim();
+  if (!file) return;
+  const record = {
+    probeSchemaVersion: 1,
+    ts: new Date().toISOString(),
+    monotonicNs: process.hrtime.bigint().toString(),
+    pid: process.pid,
+    stage,
+    context: getApiE2eProbeContext(),
+    ...fields,
+  };
+  appendFileSync(file, `${JSON.stringify(record)}\n`, "utf8");
+};
+
+export const serializeApiE2eError = (
+  value: unknown,
+  seen = new Set<unknown>(),
+): unknown => {
+  if (!(value instanceof Error)) return { type: typeof value, value: String(value) };
+  if (seen.has(value)) return { name: value.name, message: value.message, circular: true };
+  seen.add(value);
+  const error = value as Error & {
+    code?: unknown;
+    cause?: unknown;
+    errors?: unknown;
+  };
+  const errors = error instanceof AggregateError
+    ? Array.from(error.errors, (item) => serializeApiE2eError(item, seen))
+    : Array.isArray(error.errors)
+      ? error.errors.map((item) => serializeApiE2eError(item, seen))
+      : undefined;
+  return {
+    name: error.name,
+    message: error.message,
+    ...(error.code !== undefined ? { code: error.code } : {}),
+    ...(error.stack ? { stack: error.stack } : {}),
+    ...(error.cause !== undefined ? { cause: serializeApiE2eError(error.cause, seen) } : {}),
+    ...(errors ? { errors } : {}),
+  };
+};
