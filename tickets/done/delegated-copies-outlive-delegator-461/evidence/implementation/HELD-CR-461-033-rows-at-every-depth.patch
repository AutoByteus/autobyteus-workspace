+/**
+ * How a view's rows nest (autobyteus-461 CR-461-033): its rows are its open subtree, and a row whose delegator is an
+ * agent of another row (an agent row's run, a team row's member) is under that row; the others are at the top. Each
+ * level keeps the order the rows were delegated in. A nested row's delegator address is its owner's agent address.
+ */
+export const nestedRows = (children: readonly DelegatedChildRun[]) => {
+  const owners = new Map<string, Readonly<{ row: DelegatedChildRun; address: string }>>()
+  for (const child of children) {
+    if (child.kind === 'agent') owners.set(child.runId, { row: child, address: child.address })
+    else child.members.forEach((member) => owners.set(member.agentRunId, { row: child, address: member.address }))
+  }
+  const under = new Map<string, DelegatedChildRun[]>()
+  const top: DelegatedChildRun[] = []
+  for (const child of children) {
+    const owner = child.delegatorAgentRunId ? owners.get(child.delegatorAgentRunId) : undefined
+    if (!owner || owner.row === child) { top.push(child); continue }
+    under.set(child.delegatorAgentRunId!, [...under.get(child.delegatorAgentRunId!) ?? [], child])
+  }
+  return Object.freeze({
+    top,
+    /** The rows an agent of a row delegated, under it. */
+    delegatedBy: (agentRunId: string): readonly DelegatedChildRun[] => under.get(agentRunId) ?? [],
+    /** A nested row's delegator address (its owner's agent); `null` for a row at the top. */
+    delegatorAddressOf: (agentRunId: string): string | null => owners.get(agentRunId)?.address ?? null,
+  })
+}
+
