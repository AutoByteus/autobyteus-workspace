+    expect(cleanup.privateRootAndAuthRemoved).toBe(true); expect(cleanup.sourceAuthUnchanged).toBe(true); expect(cleanup.sourceConfigUnchanged).toBe(true);
+  }
+  if (failure) throw failure;
+}, 480_000);
