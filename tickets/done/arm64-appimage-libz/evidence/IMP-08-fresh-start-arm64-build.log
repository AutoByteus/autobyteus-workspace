#!/usr/bin/env bash
# Fresh-start arm64 build of commit $1 (TESTING.md "Fresh-start build"), following build-linux-arm64's step order.
set -euo pipefail
C="$1"; F=/tmp/ab28/fresh; rm -rf "$F"
export PATH=/tmp/ab28/go1.27.4/go/bin:/tmp/sm-bin:$PATH
git clone -q --no-local /home/autobyteus/workspace/.codex/worktrees/arm64-appimage-libz "$F"
cd "$F" && git checkout -q "$C" && git submodule update --init --recursive -q || true
echo "== HEAD $(git rev-parse HEAD)"; go version
echo "== pnpm install --frozen-lockfile"; pnpm install --frozen-lockfile 2>&1 | tail -1
echo "== prepare build-only trust"; node scripts/desktop-package/prepare-build-trust.mjs build-only /tmp/ab28/fresh-trust
export AUTOBYTEUS_DESKTOP_PUBLIC_KEY_FILE=/tmp/ab28/fresh-trust/desktop-public.pem AUTOBYTEUS_DESKTOP_TEST_KEY_FILE=/tmp/ab28/fresh-trust/desktop-test-private.pem
echo "== unit checks"; node --test scripts/desktop-package/*.test.mjs 2>&1 | grep -E "^# (pass|fail)" || true
(cd autobyteus-web/linux-install && go test ./... 2>&1 | tail -5)
echo "== build:electron:linux:arm64"; (cd autobyteus-web && AUTOBYTEUS_BUILD_FLAVOR=personal GITHUB_REPOSITORY=AutoByteus/autobyteus-workspace pnpm build:electron:linux:arm64 > /tmp/ab28/fresh-build.log 2>&1); echo build-exit=$?
V="$(node -p "require('./autobyteus-web/package.json').version")"; IMG="autobyteus-web/electron-dist/AutoByteus_personal_linux-arm64-$V.AppImage"
echo "== sign build-only"; cp -p "$IMG" /tmp/ab28/fresh-signed.AppImage; node scripts/desktop-package/sign-release.mjs /tmp/ab28/fresh-signed.AppImage "$V" arm64 "$AUTOBYTEUS_DESKTOP_TEST_KEY_FILE" "$AUTOBYTEUS_DESKTOP_PUBLIC_KEY_FILE" 2>&1 | tail -1 || true
echo "== verify layout + metadata"; APPIMAGE="$(find autobyteus-web/electron-dist -maxdepth 1 -type f -name '*linux-arm64*.AppImage' -print -quit)"
node scripts/desktop-package/verify-layout.mjs "$APPIMAGE" "$AUTOBYTEUS_DESKTOP_PUBLIC_KEY_FILE"; file "$APPIMAGE" | grep -Eq 'ARM aarch64|aarch64|ARM64' && echo arch-ok
python3 scripts/validate_linux_updater_metadata.py --metadata autobyteus-web/electron-dist/latest-linux-arm64.yml --arch-token linux-arm64 --image "$APPIMAGE"
echo "== clean image (docker-chroot-shim)"; PATH=$PWD/tickets/in-progress/arm64-appimage-libz/evidence/docker-chroot-shim:$PATH UBUNTU_BASE_TARBALL=/tmp/fu004-dl/ubuntu-base/ubuntu-base-24.04.5-base-arm64.tar.gz node scripts/desktop-package/verify-clean-image-runtime.mjs "$APPIMAGE"
echo "== prisma engines"; ENGINES_DIR="$(find autobyteus-web/resources/server/node_modules -maxdepth 6 -type d -path '*/@prisma/engines' | head -n1)"; test -f "$ENGINES_DIR/schema-engine-linux-arm64-openssl-3.0.x" && test -f "$ENGINES_DIR/libquery_engine-linux-arm64-openssl-3.0.x.so.node" && echo engines-ok
CLIENT_DIR="$(find autobyteus-web/resources/server/node_modules -maxdepth 10 -type d -path '*/node_modules/.prisma/client' | head -n1)"; test -f "$CLIENT_DIR/libquery_engine-linux-arm64-openssl-3.0.x.so.node" && echo client-ok
echo "== packaged server startup"; U=autobyteus-web/electron-dist/linux-arm64-unpacked; node autobyteus-web/scripts/verify-packaged-server-startup.mjs --server-root "$U/resources/server" --runtime-executable "$U/autobyteus" 2>&1 | tail -1
echo "== runtime facts"; node /tmp/ab28/appimage-facts.mjs "$APPIMAGE"; sha256sum "$U/resources/app.asar"
echo FRESH-START-DONE
