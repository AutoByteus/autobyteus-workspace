# script:
"""Compares every assertion statement (expect...;) of each test file changed or moved since BASE with its BASE version."""
import subprocess,re,sys
base=sys.argv[1]
out=subprocess.run(['git','diff','-M','--name-status',base,'HEAD','--','autobyteus-server-ts/tests','autobyteus-ts/tests'],capture_output=True,text=True).stdout
pairs=[]
for line in out.splitlines():
    p=line.split('\t')
    if p[0].startswith('R'): pairs.append((p[1],p[2]))
    elif p[0]=='M': pairs.append((p[1],p[1]))
ex=lambda t:[re.sub(r'\s+',' ',s) for s in re.findall(r'expect(?:\.\w+)?\((?:[^;]|\n)*?;',t)]
n=0
for old,new in pairs:
    if not new.endswith('.test.ts'): continue
    n+=1
    a=ex(subprocess.run(['git','show',f'{base}:{old}'],capture_output=True,text=True).stdout); b=ex(open(new).read())
    rem=[x for x in a if x not in b]; add=[x for x in b if x not in a]
    if rem or add:
        print(f'== {old} -> {new}: {len(rem)} removed, {len(add)} added')
        for x in rem: print('   -',x[:200])
print(f'{n} changed or moved test files compared with {base}')
