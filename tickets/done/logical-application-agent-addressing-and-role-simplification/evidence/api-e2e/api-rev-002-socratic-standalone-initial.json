t through the platform-owned application backend stream.\n\nlesson.response_received\n26.8.2026, 19:23:35\n{\n  \"lessonId\": \"lesson-8ff5489f-63c0-490c-b0a6-4f3f2882c703\",\n  \"bindingId\": \"bac669f7-7365-461a-b9b1-db137e28ae51\",\n  \"revisionId\": \"974e52c2-eb8f-418c-9a77-cf8381c4fb9d\",\n  \"runId\": \"socratic_math_tutor_750d92c8bb8542638aa8454a604ea8fd\"\n}\nlesson.started\n26.8.2026, 19:23:13\n{\n  \"lessonId\": \"lesson-8ff5489f-63c0-490c-b0a6-4f3f2882c703\",\n  \"bindingId\": \"bac669f7-7365-461a-b9b1-db137e28ae51\",\n  \"runId\": \"socratic_math_team_5426adc069044652bba000fda0288af7\",\n  \"createdAt\": \"2026-08-26T17:23:13.168Z\"\n}"
