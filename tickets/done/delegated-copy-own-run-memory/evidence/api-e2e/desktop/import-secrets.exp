#!/usr/bin/expect -f
# Imports the user's local .env into an isolated instance's test vault through `pnpm secrets:import`, answering its TTY
# confirmation with the phrase the CLI asks for. Prints secret ids and statuses only, never values.
# Usage: import-secrets.exp <worktree> <source .env> <absolute sqlite path>
set timeout 600
set worktree [lindex $argv 0]
set source [lindex $argv 1]
set db [lindex $argv 2]
cd $worktree
spawn pnpm secrets:import -- --source $source --database-url "file:$db"
expect {
  -re {Type (\S+) to continue: } { send -- "$expect_out(1,string)\r"; exp_continue }
  eof
}
catch wait result
exit [lindex $result 3]
