// One-off (autobyteus-328 AC-001): the base read_file and the new one give byte-identical results for every tracked text file.
import { execSync } from 'node:child_process';
import path from 'node:path';
import { expect, it } from 'vitest';
import { readFile as baseRead } from '../../Users/normy/autobyteus_org/autobyteus-worktrees/read-file-media-merge/autobyteus-ts/src/tools/file/zz-read-file-base.js';
import { readFile as newRead } from '../../Users/normy/autobyteus_org/autobyteus-worktrees/read-file-media-merge/autobyteus-ts/src/tools/file/read-file.js';
import { getMediaFileKindFromPath } from '../../Users/normy/autobyteus_org/autobyteus-worktrees/read-file-media-merge/autobyteus-ts/src/utils/media-file-kind.js';
import fs from 'node:fs';

it('text reads are byte-identical', async () => {
  const root = '/Users/normy/autobyteus_org/autobyteus-worktrees/read-file-media-merge';
  const files = execSync('git ls-files', { cwd: root, maxBuffer: 1 << 28 }).toString().split('\n').filter(Boolean)
    .map((f) => path.join(root, f)).filter((f) => fs.existsSync(f) && fs.statSync(f).isFile() && !getMediaFileKindFromPath(f));
  const ctx = { agentId: 'cmp', workspaceRootPath: null };
  let text = 0, binary = 0, compared = 0;
  for (const f of files) {
    const bytes = fs.readFileSync(f);
    if (bytes.subarray(0, 8000).includes(0)) { binary += 1; await expect(newRead(ctx, f)).rejects.toThrow('is a binary file'); continue; }
    text += 1;
    for (const args of [[undefined, undefined, true], [undefined, undefined, false], [2, 5, true]] as const) {
      expect(await newRead(ctx, f, null, args[0], args[1], args[2])).toBe(await baseRead(ctx, f, null, args[0], args[1], args[2]));
      compared += 1;
    }
  }
  console.log(`files ${files.length}: text ${text} (comparisons ${compared}), binary ${binary}`);
}, 600000);

