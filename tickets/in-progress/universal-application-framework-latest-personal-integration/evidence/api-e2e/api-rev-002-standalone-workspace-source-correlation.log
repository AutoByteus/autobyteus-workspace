    75	  private cachePreparation(
    76	    applicationId: string,
    77	    cache: Map<string, Promise<ApplicationStorageLayout>>,
    78	    prepare: () => Promise<ApplicationStorageLayout>,
    79	  ): Promise<ApplicationStorageLayout> {
    80	    const cached = cache.get(applicationId);
    81	    if (cached) {
    82	      return cached;
    83	    }
    84	
    85	    const promise = prepare().finally(() => {
    86	      cache.delete(applicationId);
    87	    });
    88	    cache.set(applicationId, promise);
    89	    return promise;
    90	  }
