    46	export const buildApplicationStorageLayout = (
    47	  appConfig: ApplicationStoragePathConfig,
    48	  applicationId: string,
    49	): ApplicationStorageLayout => {
    50	  const rootPath = path.join(
    51	    appConfig.getAppDataDir(),
    52	    "applications",
    53	    buildApplicationStorageKey(applicationId),
    54	  );
    55	  const dbDir = path.join(rootPath, "db");
    56	  const logsDir = path.join(rootPath, "logs");
    57	  const runtimeDir = path.join(rootPath, "runtime");
    58	
    59	  return {
    60	    applicationId,
    61	    rootPath,
    62	    dbDir,
    63	    appDatabasePath: path.join(dbDir, "app.sqlite"),
    64	    platformDatabasePath: path.join(dbDir, "platform.sqlite"),
    65	    logsDir,
    66	    workerStdoutLogPath: path.join(logsDir, "worker.stdout.log"),
    67	    workerStderrLogPath: path.join(logsDir, "worker.stderr.log"),
    68	    runtimeDir,
    69	    engineLockPath: path.join(runtimeDir, "engine.lock"),
    70	    engineStatusPath: path.join(runtimeDir, "engine-status.json"),
    71	  };
    72	};
    73	
    74	export const ensureApplicationStorageDirectories = (layout: ApplicationStorageLayout): void => {
