    91	  async getReadiness(input: {
    92	    runtimeKind: RuntimeKind;
    93	    model: ModelInfo;
    94	    workspaceRootPath: string;
    95	  }): Promise<ApplicationProviderCredentialReadiness> {
    96	    switch (input.runtimeKind) {
    97	      case RuntimeKind.CODEX_APP_SERVER:
    98	        return this.readCodexReadiness(input.workspaceRootPath);
    99	      case RuntimeKind.CLAUDE_AGENT_SDK:
   100	        return this.readClaudeReadiness();
   101	      case RuntimeKind.AUTOBYTEUS:
   102	        return this.readAutobyteusReadiness(input.model);
   103	    }
   104	  }
   105	
   106	  private async readCodexReadiness(
   107	    workspaceRootPath: string,
   108	  ): Promise<ApplicationProviderCredentialReadiness> {
   109	    try {
   110	      const client = await this.dependencies.codexClientManager
   111	        .acquireClient(workspaceRootPath);
   112	      try {
   113	        const response = await client.request<{
   114	          account?: unknown;
   115	          requiresOpenaiAuth?: unknown;
   116	        }>("account/read", { refreshToken: false });
   117	        const configured = response.requiresOpenaiAuth !== true || response.account != null;
   118	        return configured
   119	          ? { configured: true, reason: null }
   120	          : {
   121	              configured: false,
   122	              reason: "Codex authentication is unavailable: no logged-in account.",
   123	            };
   124	      } finally {
   125	        await this.dependencies.codexClientManager.releaseClient(workspaceRootPath);
   126	      }
   127	    } catch (error) {
   128	      return {
   129	        configured: false,
   130	        reason: `Codex authentication is unavailable: ${
   131	          error instanceof Error ? error.message : String(error)
   132	        }`,
   133	      };
   134	    }
   135	  }

