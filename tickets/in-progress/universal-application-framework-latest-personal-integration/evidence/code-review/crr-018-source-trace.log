   165	  constructor(
   166	    private readonly memoryDir: string,
   167	    private readonly writer: TeamRunFileCommitWriter = getTeamRunFileCommitWriter(),
   168	  ) {
   169	    this.layout = new AgentMemoryLayout(memoryDir);
   170	  }
