     9	import type { AgentDefinitionService } from "../../agent-definition/services/agent-definition-service.js";
    10	import type { AgentTeamDefinitionService } from "../../agent-team-definition/services/agent-team-definition-service.js";
    11	import {
    12	  buildScopedMemberResolutionContext,
    13	  resolveScopedAgentMemberRef,
    14	  resolveScopedTeamMemberRef,
    15	} from "../../agent-team-definition/utils/scoped-team-member-resolution.js";
    16	import type { DefaultLaunchConfig } from "../../launch-preferences/default-launch-config.js";
    17	import { createAgentTeamAddress } from "../../agent-collaboration/domain/agent-team-address.js";
    18	import type { ApplicationExecutionResourceResolver } from "../../application-orchestration/services/application-execution-resource-resolver.js";
    19
    20	type LaunchLayer = {
    21	  config: DefaultLaunchConfig | null;
    22	  source: ApplicationLaunchDefinitionValueSource;
    23	};
    24
    25	const definitionValueSource = (input: {
    26	  provenance: "PACKAGE" | "SELECTED_RESOURCE";
    27	  definitionKind: "AGENT" | "AGENT_TEAM";
    28	  definitionId: string;
    29	}): ApplicationLaunchDefinitionValueSource => {
    30	  if (input.provenance === "PACKAGE") {
    31	    return input.definitionKind === "AGENT"
    32	      ? { kind: "PACKAGE_AGENT_DEFAULT", agentDefinitionId: input.definitionId }
    33	      : { kind: "PACKAGE_TEAM_DEFAULT", teamDefinitionId: input.definitionId };
    34	  }
    35	  return input.definitionKind === "AGENT"
    36	    ? { kind: "SELECTED_RESOURCE_AGENT_DEFAULT", agentDefinitionId: input.definitionId }
    37	    : { kind: "SELECTED_RESOURCE_TEAM_DEFAULT", teamDefinitionId: input.definitionId };
    38	};
