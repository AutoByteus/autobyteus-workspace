   108	    cachedAppDataMigrationRegistry = new AppDataMigrationRegistry();
   109	  }
   110	  return cachedAppDataMigrationRegistry;
   130	export const transformTeamRunExecutionTreeV1ToV2 = (
   131	  tree: TeamRunExecutionTreeFileV1,
   132	): TeamRunExecutionTreeFileV2 => {
   133	  const root: RootConfiguredTeamExecutionNode = {
   134	    address: "/",
   135	    teamDefinitionId: tree.rootTeam.teamDefinitionId,
   136	    teamDefinitionName: tree.rootTeam.teamDefinitionName,
   137	    teamRunId: tree.rootTeam.teamRunId,
   138	    coordinatorAddress: tree.rootTeam.coordinatorAddress,
   139	    defaultLaunchConfiguration: launchConfiguration(directCoordinator(tree.rootTeam).launchConfiguration),
   140	    members: tree.rootTeam.members.map(configuredNode),
   141	    taskExecutions: structuredClone(tree.rootTeam.taskExecutions),
   142	  };
   143	  return validateTeamRunExecutionTreePayload({
   144	    schemaVersion: 2,
   145	    createdAt: tree.createdAt,
   146	    archivedAt: tree.archivedAt,
   147	    applicationBinding: tree.applicationBinding ? structuredClone(tree.applicationBinding) : null,
   148	    handoffs: structuredClone(tree.handoffs),
   149	    rootTeam: root,
   150	  }, tree.rootTeam.teamRunId);
   151	};
