   172	  async execute(): Promise<AppDataMigrationExecutionResult> {
   173	    this.dispositions.clear();
   174	    this.scannedCount = 0;
   175	    let entries: import("node:fs").Dirent[];
   176	    try {
   177	      entries = await fs.readdir(this.layout.getTeamRootDirPath(), { withFileTypes: true });
   178	    } catch (error) {
   179	      if ((error as NodeJS.ErrnoException).code === "ENOENT") return this.result();
   180	      throw error;
   181	    }
   182	    for (const entry of entries.sort((left, right) => left.name.localeCompare(right.name))) {
   183	      this.scannedCount += 1;
   184	      const rootPath = path.join(this.layout.getTeamRootDirPath(), entry.name);
   185	      if (!entry.isDirectory()) {
   186	        this.record("FAILED_UNSUPPORTED_ENTRY", rootPath);
   187	        continue;
   188	      }
   189	      await this.migrateRoot(entry.name, rootPath);
   190	    }
   191	    return this.result();
   192	  }
   193
   194	  private async migrateRoot(rootTeamRunId: string, rootPath: string): Promise<void> {
   195	    const filePath = getTeamRunExecutionTreePath(rootPath);
   196	    let raw: unknown;
   197	    try {
   198	      const stat = await fs.lstat(filePath);
   199	      if (!stat.isFile()) {
   200	        this.record("FAILED_UNSUPPORTED_ENTRY", filePath);
   201	        return;
   202	      }
   203	      raw = JSON.parse(await fs.readFile(filePath, "utf8")) as unknown;
   204	    } catch (error) {
   205	      if ((error as NodeJS.ErrnoException).code === "ENOENT") {
   206	        this.record("SKIPPED_MISSING", filePath);
   207	        return;
   208	      }
   209	      this.record("FAILED_INVALID_OR_UNSUPPORTED_PAYLOAD", filePath);
   210	      return;
   211	    }
   212
   213	    try {
   214	      validateTeamRunExecutionTreePayload(raw, rootTeamRunId);
   215	      this.record("SKIPPED_ALREADY_CURRENT", filePath);
   216	      return;
   217	    } catch {
   218	      // Exact V1 classification is attempted next inside the migration boundary.
   219	    }
   220
   221	    let target: TeamRunExecutionTreeFileV2;
   222	    try {
   223	      target = transformTeamRunExecutionTreeV1ToV2(validateV1(raw, rootTeamRunId));
   224	    } catch (error) {
   225	      const schemaVersion = raw && typeof raw === "object"
   226	        ? (raw as Record<string, unknown>).schemaVersion
   227	        : null;
   228	      this.record(
   229	        schemaVersion === 1 ? "FAILED_TRANSFORMATION" : "FAILED_INVALID_OR_UNSUPPORTED_PAYLOAD",
   230	        filePath,
   231	      );
   232	      return;
   233	    }
   234
   235	    const write = await this.writer.write({ file: "execution_tree", filePath, payload: target });
   236	    if (write.outcome === "not_renamed") {
   237	      this.record("FAILED_CURRENT_VALIDATION", filePath);
   238	      return;
   239	    }
   240	    try {
   241	      const reread = JSON.parse(await fs.readFile(filePath, "utf8")) as unknown;
   242	      validateTeamRunExecutionTreePayload(reread, rootTeamRunId);
   243	      this.record(
   244	        write.outcome === "committed" ? "MIGRATED" : "MIGRATED_WITH_FINALIZATION_WARNING",
   245	        filePath,
   246	      );
   247	    } catch {
   248	      this.record("FAILED_CURRENT_VALIDATION", filePath);
   249	    }
   250	  }
   251
   252	  private record(disposition: Disposition, examplePath: string): void {
   253	    const current = this.dispositions.get(disposition) ?? { count: 0, examples: [] };
   254	    current.count += 1;
   255	    current.examples.push(path.relative(this.memoryDir, examplePath).split(path.sep).join("/") || ".");
   256	    current.examples.sort();
   257	    current.examples.splice(5);
   258	    this.dispositions.set(disposition, current);
   259	  }
   260
   261	  private result(): AppDataMigrationExecutionResult {
   262	    let migratedCount = 0;
   263	    let skippedCount = 0;
   264	    let failedCount = 0;
   265	    const details: AppDataMigrationItemDetail[] = [];
   266	    for (const [disposition, value] of [...this.dispositions.entries()]
   267	      .sort(([left], [right]) => left.localeCompare(right))) {
   268	      const status = statusFor(disposition);
   269	      if (status === "MIGRATED") migratedCount += value.count;
   270	      else if (status === "FAILED") failedCount += value.count;

