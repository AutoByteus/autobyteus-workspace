    38	const required = (value: string, field: string): string => {
    39	  const result = value.trim();
    40	  if (!result) throw new Error(`${field} is required.`);
    41	  return result;
    42	};
    43	const skillMode = (value: SkillAccessMode | string | null | undefined): SkillAccessMode => {
    44	  if (value == null || value === SkillAccessMode.PRELOADED_ONLY) return SkillAccessMode.PRELOADED_ONLY;
    45	  if (value === SkillAccessMode.NONE) return SkillAccessMode.NONE;
    46	  throw new Error(`Unsupported skillAccessMode '${value}'.`);
    47	};
    48	const collectRunIds = (binding: ApplicationAgentBindingRecord): string[] => binding.runtime.subject === "AGENT_RUN"
    49	  ? [binding.runtime.agentRunId]
    50	  : [binding.runtime.teamRunId, ...binding.runtime.members.map((member) => member.agentRunId)];
    51	const configuredAgents = (members: readonly ConfiguredExecutionNode[]): ConfiguredAgentExecutionNode[] => {
    52	  const result: ConfiguredAgentExecutionNode[] = [];
    53	  for (const member of members) {
    54	    if ("agentRunId" in member) result.push(member);
    55	    else result.push(...configuredAgents(member.members));
    56	  }
    57	  return result;
    58	};
