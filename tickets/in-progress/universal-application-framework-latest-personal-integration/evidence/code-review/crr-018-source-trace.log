    13
    14	const hasOwn = (record: object | null | undefined, key: string): boolean =>
    15	  Boolean(record) && Object.prototype.hasOwnProperty.call(record, key);
    16
    17	const cloneConfig = (
    18	  value: Record<string, unknown> | null | undefined,
    19	): Record<string, unknown> | null => value ? structuredClone(value) : null;
    20
    21	const memberSource = (memberAddress: string): ApplicationLaunchValueSource => ({
    22	  kind: "HOST_MEMBER_OVERRIDE",
    23	  memberAddress,
    24	});
    25	const slotSource = (): ApplicationLaunchValueSource => ({ kind: "HOST_SLOT_OVERRIDE" });
    26
    27	export class ApplicationLaunchOverrideResolutionError extends Error {
    28	  constructor(message: string) {
    29	    super(message);
    30	    this.name = "ApplicationLaunchOverrideResolutionError";
    31	  }
    32	}
    33
    34	const requireValue = (
    35	  value: string | null,
    36	  source: ApplicationLaunchValueSource | null,
    37	  label: string,
    38	): { value: string; source: ApplicationLaunchValueSource } => {
    39	  if (!value?.trim() || !source) {
    40	    throw new ApplicationLaunchOverrideResolutionError(`${label} is not configured.`);
    41	  }
    42	  return { value: value.trim(), source: structuredClone(source) };
    43	};
    44
    45	const applyAgentOverride = (input: {
    46	  leaf: ApplicationResolvedLaunchBaselineLeaf;
    47	  override: Extract<ApplicationLaunchOverride, { kind: "AGENT" }> | null;
    48	  workspaceRootPath: string;
    49	}): ApplicationEffectiveLeafLaunchProfile => {
    50	  const { leaf, override } = input;
    51	  const changesRuntime = Boolean(override?.runtimeKind?.trim());
    52	  const changesModel = Boolean(override?.llmModelIdentifier?.trim());
    53	  const llmConfigExplicit = hasOwn(override, "llmConfig");
    54	  const runtime = requireValue(
    55	    override?.runtimeKind?.trim() || leaf.runtimeKind,
    56	    changesRuntime ? slotSource() : leaf.provenance.runtimeKind,
    57	    `Agent '${leaf.agentDefinitionId}' runtimeKind`,
    58	  );
    59	  const model = requireValue(
    60	    override?.llmModelIdentifier?.trim() || leaf.llmModelIdentifier,
    61	    changesModel ? slotSource() : leaf.provenance.llmModelIdentifier,
    62	    `Agent '${leaf.agentDefinitionId}' llmModelIdentifier`,
    63	  );
    64	  return {
    65	    memberAddress: leaf.memberAddress,
    66	    displayName: leaf.displayName,
    67	    agentDefinitionId: leaf.agentDefinitionId,
    68	    runtimeKind: runtime.value,
    69	    llmModelIdentifier: model.value,
    70	    llmConfig: llmConfigExplicit
    71	      ? cloneConfig(override?.llmConfig)
    72	      : changesRuntime || changesModel
    73	        ? null
    74	        : cloneConfig(leaf.llmConfig),
    75	    workspaceRootPath: override?.workspaceRootPath?.trim() || input.workspaceRootPath,
    76	    provenance: {
    77	      runtimeKind: runtime.source,
    78	      llmModelIdentifier: model.source,
    79	      llmConfig: llmConfigExplicit
    80	        ? slotSource()
    81	        : changesRuntime || changesModel
    82	          ? null
    83	          : structuredClone(leaf.provenance.llmConfig),
    84	      workspaceRootPath: override?.workspaceRootPath?.trim()
    85	        ? "HOST_OVERRIDE"
    86	        : "APPLICATION_RUNTIME",
    87	    },
    88	  };
    89	};
    90
    91	const applyTeamLeafOverride = (input: {
    92	  leaf: ApplicationResolvedLaunchBaselineLeaf;
    93	  defaults: ApplicationTeamLaunchOverrideDefaults | null;
    94	  member: ApplicationTeamMemberLaunchOverride | null;
    95	  workspaceRootPath: string;
    96	}): ApplicationEffectiveLeafLaunchProfile => {
    97	  const { leaf, defaults, member } = input;
    98	  const memberRuntime = member?.runtimeKind?.trim() || null;
    99	  const defaultRuntime = defaults?.runtimeKind?.trim() || null;
   100	  const memberModel = member?.llmModelIdentifier?.trim() || null;
   101	  const defaultModel = defaults?.llmModelIdentifier?.trim() || null;
   102	  const changesRuntime = Boolean(memberRuntime || defaultRuntime);
   103	  const changesModel = Boolean(memberModel || defaultModel);
   104	  const memberLlmConfigExplicit = hasOwn(member, "llmConfig");
   105	  const defaultLlmConfigExplicit = hasOwn(defaults, "llmConfig");
   106	  const memberOverridesLowerConfig = Boolean(memberRuntime || memberModel);
   107	  const memberAddress = leaf.memberAddress ?? member?.memberAddress ?? "";
   108	  const runtime = requireValue(
   109	    memberRuntime || defaultRuntime || leaf.runtimeKind,
   110	    memberRuntime
   111	      ? memberSource(memberAddress)
   112	      : defaultRuntime
   113	        ? slotSource()
   114	        : leaf.provenance.runtimeKind,
   115	    `Team member '${memberAddress}' runtimeKind`,
   116	  );
   117	  const model = requireValue(
   118	    memberModel || defaultModel || leaf.llmModelIdentifier,
   119	    memberModel
   120	      ? memberSource(memberAddress)
   121	      : defaultModel
   122	        ? slotSource()
   123	        : leaf.provenance.llmModelIdentifier,
   124	    `Team member '${memberAddress}' llmModelIdentifier`,
   125	  );
   126
   127	  let llmConfig = cloneConfig(leaf.llmConfig);
   128	  let llmConfigSource = structuredClone(leaf.provenance.llmConfig) as ApplicationLaunchValueSource | null;
   129	  if (memberLlmConfigExplicit) {
   130	    llmConfig = cloneConfig(member?.llmConfig);
   131	    llmConfigSource = memberSource(memberAddress);
   132	  } else if (defaultLlmConfigExplicit && !memberOverridesLowerConfig) {
   133	    llmConfig = cloneConfig(defaults?.llmConfig);
   134	    llmConfigSource = slotSource();
   135	  } else if (changesRuntime || changesModel) {
   136	    llmConfig = null;
   137	    llmConfigSource = null;
   138	  }
   139
   140	  return {
   141	    memberAddress: leaf.memberAddress,
   142	    displayName: leaf.displayName,
   143	    agentDefinitionId: leaf.agentDefinitionId,
   144	    runtimeKind: runtime.value,
   145	    llmModelIdentifier: model.value,
   146	    llmConfig,
   147	    workspaceRootPath: defaults?.workspaceRootPath?.trim() || input.workspaceRootPath,
   148	    provenance: {
   149	      runtimeKind: runtime.source,
   150	      llmModelIdentifier: model.source,
   151	      llmConfig: llmConfigSource,
   152	      workspaceRootPath: defaults?.workspaceRootPath?.trim()
   153	        ? "HOST_OVERRIDE"
   154	        : "APPLICATION_RUNTIME",
   155	    },
   156	  };
   157	};
   158
   159	const applyTeamScopeOverride = (input: {
   160	  scope: ApplicationResolvedTeamLaunchBaselineScope;
   161	  defaults: ApplicationTeamLaunchOverrideDefaults | null;
   162	  workspaceRootPath: string;
   163	}): ApplicationEffectiveTeamLaunchProfile => {
   164	  const { scope, defaults } = input;
   165	  const defaultRuntime = defaults?.runtimeKind?.trim() || null;
   166	  const defaultModel = defaults?.llmModelIdentifier?.trim() || null;
   167	  const changesRuntime = Boolean(defaultRuntime);
   168	  const changesModel = Boolean(defaultModel);
   169	  const llmConfigExplicit = hasOwn(defaults, "llmConfig");
   170	  const runtime = requireValue(
   171	    defaultRuntime || scope.runtimeKind,
   172	    defaultRuntime ? slotSource() : scope.provenance.runtimeKind,
   173	    `Team '${scope.teamAddress}' runtimeKind`,
   174	  );
   175	  const model = requireValue(
   176	    defaultModel || scope.llmModelIdentifier,
   177	    defaultModel ? slotSource() : scope.provenance.llmModelIdentifier,
   178	    `Team '${scope.teamAddress}' llmModelIdentifier`,
   179	  );
   180	  return {
   181	    teamAddress: scope.teamAddress,
   182	    displayName: scope.displayName,
   183	    teamDefinitionId: scope.teamDefinitionId,
   184	    runtimeKind: runtime.value,
   185	    llmModelIdentifier: model.value,
   186	    llmConfig: llmConfigExplicit
   187	      ? cloneConfig(defaults?.llmConfig)
   188	      : changesRuntime || changesModel
   189	        ? null
   190	        : cloneConfig(scope.llmConfig),
   191	    workspaceRootPath: defaults?.workspaceRootPath?.trim() || input.workspaceRootPath,
   192	    provenance: {
   193	      runtimeKind: runtime.source,
   194	      llmModelIdentifier: model.source,
   195	      llmConfig: llmConfigExplicit
   196	        ? slotSource()
   197	        : changesRuntime || changesModel
   198	          ? null
   199	          : structuredClone(scope.provenance.llmConfig),
   200	      workspaceRootPath: defaults?.workspaceRootPath?.trim()
   201	        ? "HOST_OVERRIDE"
   202	        : "APPLICATION_RUNTIME",
   203	    },
   204	  };
   205	};
   206
   207	export const applyApplicationLaunchOverride = (input: {
   208	  baseline: ApplicationResolvedResourceLaunchBaseline;
   209	  launchOverride: ApplicationLaunchOverride | null;
   210	  workspaceRootPath: string;
   211	}): ApplicationEffectiveLaunchConfiguration => {
   212	  if (input.baseline.resourceKind === "AGENT") {
   213	    if (input.launchOverride?.kind === "AGENT_TEAM" || input.baseline.leaves.length !== 1) {
   214	      throw new ApplicationLaunchOverrideResolutionError(
   215	        "Agent launch override does not match its selected resource.",
   216	      );
   217	    }
   218	    return {
   219	      ...structuredClone(input.baseline),
   220	      leaves: [applyAgentOverride({
   221	        leaf: input.baseline.leaves[0]!,
   222	        override: input.launchOverride,
   223	        workspaceRootPath: input.workspaceRootPath,
   224	      })],
   225	    };
   226	  }
   227	  if (input.launchOverride?.kind === "AGENT") {
   228	    throw new ApplicationLaunchOverrideResolutionError(
   229	      "Team launch override does not match its selected resource.",
   230	    );
   231	  }
   232	  const defaults = input.launchOverride?.defaults ?? null;
   233	  const memberByAddress = new Map(
   234	    (input.launchOverride?.memberProfiles ?? []).map((member) => [member.memberAddress, member]),
   235	  );
   236	  return {
   237	    ...structuredClone(input.baseline),
   238	    teamScopes: input.baseline.teamScopes.map((scope) => applyTeamScopeOverride({
   239	      scope,
   240	      defaults,
   241	      workspaceRootPath: input.workspaceRootPath,
   242	    })),
   243	    leaves: input.baseline.leaves.map((leaf) => applyTeamLeafOverride({
   244	      leaf,
   245	      defaults,
   246	      member: memberByAddress.get(leaf.memberAddress ?? "") ?? null,
   247	      workspaceRootPath: input.workspaceRootPath,
   248	    })),
   249	  };
   250	};

