   219	    teamDefinitionId: string,
   220	    teamConfigsInput: readonly ApplicationTeamScopeLaunchConfig[],
   221	    memberConfigsInput: readonly ApplicationTeamMemberLaunchConfig[],
   222	    applicationBinding: { applicationId: string; bindingId: string },
   223	  ) {
   224	    const teamConfigs = teamConfigsInput.map((config) => this.explicitTeamConfig(config));
   225	    const memberConfigs = memberConfigsInput.map((config) => this.explicitMemberConfig(config));
   226	    for (const config of [...teamConfigs, ...memberConfigs]) {
   227	      await this.requireCurrentSelection(config);
   228	    }
   229	    return this.teams.createTeamRun({
   230	      teamDefinitionId,
   231	      teamConfigs,
   232	      memberConfigs,
   233	      applicationBinding,
   234	    });
   235	  }
   236
   237	  private explicitRootConfig(input: ApplicationTeamRunPreset) {
   238	    return {
   239	      workspaceRootPath: required(input.workspaceRootPath, "launchPreset.workspaceRootPath"),
   240	      llmModelIdentifier: required(input.llmModelIdentifier, "launchPreset.llmModelIdentifier"),
   241	      autoExecuteTools: Boolean(input.autoExecuteTools),
   242	      skillAccessMode: skillMode(input.skillAccessMode),
   243	      runtimeKind: this.requireNormalizedRuntimeKind(input.runtimeKind),
   244	      llmConfig: input.llmConfig ?? null,
   245	    };
   246	  }
   247
   248	  private explicitTeamConfig(input: ApplicationTeamScopeLaunchConfig): TeamRunTeamConfigInput {
   249	    return {
   250	      teamAddress: required(input.teamAddress, "teamConfig.teamAddress"),
   251	      llmModelIdentifier: required(input.llmModelIdentifier, "teamConfig.llmModelIdentifier"),
   252	      autoExecuteTools: Boolean(input.autoExecuteTools),
   253	      skillAccessMode: skillMode(input.skillAccessMode),
   254	      workspaceRootPath: required(input.workspaceRootPath, "teamConfig.workspaceRootPath"),
   255	      llmConfig: input.llmConfig ?? null,
   256	      runtimeKind: this.requireNormalizedRuntimeKind(input.runtimeKind),
   257	    };
   258	  }
   259
   260	  private explicitMemberConfig(input: ApplicationTeamMemberLaunchConfig): TeamRunMemberConfigInput {
   261	    return {
   262	      memberAddress: required(input.memberAddress, "memberConfig.memberAddress"),
   263	      agentDefinitionId: required(input.agentDefinitionId, "memberConfig.agentDefinitionId"),
   264	      llmModelIdentifier: required(input.llmModelIdentifier, "memberConfig.llmModelIdentifier"),
   265	      autoExecuteTools: Boolean(input.autoExecuteTools),
   266	      skillAccessMode: skillMode(input.skillAccessMode),
   267	      workspaceRootPath: required(input.workspaceRootPath, "memberConfig.workspaceRootPath"),
   268	      llmConfig: input.llmConfig ?? null,
   269	      runtimeKind: this.requireNormalizedRuntimeKind(input.runtimeKind),
   270	    };
   271	  }
   272
   273	  private requireNormalizedRuntimeKind(value: unknown): RuntimeKind {
   274	    const runtimeKind = this.currentModels.normalizeRuntimeKind(value);
   275	    if (!runtimeKind) {
   276	      throw new Error(`Unsupported application runtimeKind '${String(value)}'.`);
   277	    }
   278	    return runtimeKind;
   279	  }
   280
   281	  private async requireCurrentSelection(input: {
   282	    runtimeKind: unknown;
   283	    llmModelIdentifier: string;
   284	  }): Promise<void> {
   285	    await this.currentModels.requireCurrentSelection({
   286	      runtimeKind: input.runtimeKind,
   287	      llmModelIdentifier: input.llmModelIdentifier,
   288	    });
   289	  }
   290
   291	  private async persist(
   292	    binding: ApplicationAgentBindingRecord,
   293	  ): Promise<ApplicationAgentBindingRecord> {
   294	    await this.bindings.persistBinding(binding);
   295	    this.lookups.replaceBindingLookups(
   296	      binding.applicationId,
   297	      binding.bindingId,
   298	      collectRunIds(binding),
   299	    );
   300	    return binding;
   301	  }
   302	}

