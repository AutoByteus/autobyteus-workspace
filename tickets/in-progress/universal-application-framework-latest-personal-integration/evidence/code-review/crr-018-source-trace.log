     1	import type {
     2	  ApplicationEffectiveLaunchConfiguration,
     3	  ApplicationEffectiveLeafLaunchProfile,
     4	  ApplicationEffectiveTeamLaunchProfile,
     5	  ApplicationLaunchOverride,
     6	  ApplicationLaunchValueSource,
     7	  ApplicationResolvedLaunchBaselineLeaf,
     8	  ApplicationResolvedResourceLaunchBaseline,
