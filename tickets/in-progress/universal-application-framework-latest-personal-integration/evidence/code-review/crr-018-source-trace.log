   105	    canonicalAddress(member.address, `${label}.address`);
   106	    required(member.agentDefinitionId, `${label}.agentDefinitionId`);
   107	    nullableString(member.role, `${label}.role`);
   108	    nullableString(member.description, `${label}.description`);
   109	    required(member.agentRunId, `${label}.agentRunId`);
