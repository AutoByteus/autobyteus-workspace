   296	export const validateTeamRunExecutionTreePayload = (
   297	  value: unknown,
   298	  expectedRootTeamRunId?: string,
   299	): TeamRunExecutionTreeFileV2 => {
   300	  const payload = record(value, "TeamRun execution tree");
   301	  exactKeys(payload, [
   302	    "schemaVersion", "createdAt", "archivedAt", "applicationBinding", "handoffs", "rootTeam",
   303	  ], "TeamRun execution tree");
   304	  if (payload.schemaVersion !== 2) throw new Error("TeamRun execution tree schemaVersion must be 2.");
   305	  timestamp(payload.createdAt, "createdAt");
   306	  if (payload.archivedAt !== null) timestamp(payload.archivedAt, "archivedAt");
   307	  if (payload.applicationBinding !== null) {
   308	    const binding = record(payload.applicationBinding, "applicationBinding");
   309	    exactKeys(binding, ["applicationId", "bindingId"], "applicationBinding");
   310	    required(binding.applicationId, "applicationBinding.applicationId");
   311	    required(binding.bindingId, "applicationBinding.bindingId");
   312	  }
   313	  const handoffs = normalizeCollaborationHandoffs(payload.handoffs);
   314	  validateRootTeam(payload.rootTeam);
   315	  const cloned = structuredClone({ ...payload, handoffs }) as unknown as TeamRunExecutionTreeFileV2;
   316	  if (expectedRootTeamRunId && cloned.rootTeam.teamRunId !== expectedRootTeamRunId) {
   317	    throw new Error(`Execution tree root '${cloned.rootTeam.teamRunId}' does not match '${expectedRootTeamRunId}'.`);
   318	  }
   319	  validateTreeInvariants(cloned);
   320	  return deepFreeze(cloned);
   321	};
