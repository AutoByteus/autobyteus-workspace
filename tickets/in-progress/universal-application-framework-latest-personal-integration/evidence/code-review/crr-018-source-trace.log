     7
     8	export const APPLICATION_HOST_MANAGED_SKILL_ACCESS_MODE =
     9	  "PRELOADED_ONLY" as const satisfies ApplicationSkillAccessMode;
    10
    11	const normalizeSkillAccessMode = (
    12	  value: ApplicationSkillAccessMode | null | undefined,
    13	): ApplicationSkillAccessMode => value ?? APPLICATION_HOST_MANAGED_SKILL_ACCESS_MODE;
    14
    15	const requireWorkspaceRootPath = (
    16	  value: string | null,
    17	  label: string,
    18	): string => {
    19	  const normalized = value?.trim() ?? "";
    20	  if (!normalized) throw new Error(`workspaceRootPath is required for ${label}.`);
    21	  return normalized;
    22	};
    23
    24	const requireMemberAddress = (value: string | null): string => {
    25	  const normalized = value?.trim() ?? "";
    26	  if (!normalized) throw new Error("memberAddress is required for an effective team leaf.");
    27	  return normalized;
    28	};
    29
    30	export const buildEffectiveAgentRunLaunch = (input: {
    31	  configuration: ApplicationEffectiveLaunchConfiguration;
    32	  skillAccessMode?: ApplicationSkillAccessMode | null;
    33	}): ApplicationAgentRunLaunch => {
    34	  if (input.configuration.resourceKind !== "AGENT" || input.configuration.leaves.length !== 1) {
    35	    throw new Error("Runnable AGENT configuration must contain exactly one effective leaf.");
    36	  }
    37	  const leaf = input.configuration.leaves[0]!;
    38	  return {
    39	    kind: "AGENT",
    40	    workspaceRootPath: requireWorkspaceRootPath(leaf.workspaceRootPath, leaf.agentDefinitionId),
    41	    llmModelIdentifier: leaf.llmModelIdentifier,
    42	    autoExecuteTools: true,
    43	    skillAccessMode: normalizeSkillAccessMode(input.skillAccessMode),
    44	    runtimeKind: leaf.runtimeKind,
    45	    ...(leaf.llmConfig === null ? {} : { llmConfig: structuredClone(leaf.llmConfig) }),
    46	  };
    47	};
    48
    49	export const buildEffectiveTeamRunLaunch = (input: {
    50	  configuration: ApplicationEffectiveLaunchConfiguration;
    51	  skillAccessMode?: ApplicationSkillAccessMode | null;
    52	}): ApplicationTeamRunLaunch => {
    53	  if (input.configuration.resourceKind !== "AGENT_TEAM") {
    54	    throw new Error("Runnable AGENT_TEAM configuration is required.");
    55	  }
    56	  const skillAccessMode = normalizeSkillAccessMode(input.skillAccessMode);
    57	  return {
    58	    kind: "AGENT_TEAM",
    59	    mode: "memberConfigs",
    60	    teamConfigs: input.configuration.teamScopes.map((scope) => ({
    61	      teamAddress: scope.teamAddress,
    62	      workspaceRootPath: requireWorkspaceRootPath(scope.workspaceRootPath, scope.displayName),
    63	      llmModelIdentifier: scope.llmModelIdentifier,
    64	      autoExecuteTools: true,
    65	      skillAccessMode,
    66	      runtimeKind: scope.runtimeKind,
    67	      ...(scope.llmConfig === null ? {} : { llmConfig: structuredClone(scope.llmConfig) }),
    68	    })),
    69	    memberConfigs: input.configuration.leaves.map((leaf) => ({
    70	      memberAddress: requireMemberAddress(leaf.memberAddress),
    71	      displayName: leaf.displayName,
    72	      agentDefinitionId: leaf.agentDefinitionId,
    73	      workspaceRootPath: requireWorkspaceRootPath(leaf.workspaceRootPath, leaf.displayName),
    74	      llmModelIdentifier: leaf.llmModelIdentifier,
    75	      autoExecuteTools: true,
    76	      skillAccessMode,
    77	      runtimeKind: leaf.runtimeKind,
    78	      ...(leaf.llmConfig === null ? {} : { llmConfig: structuredClone(leaf.llmConfig) }),
    79	    })),
    80	  };
    81	};

