    58	const canonicalAddress = (value: unknown, label: string): AgentTeamAddress => {
    59	  const address = assertAgentTeamAddress(required(value, label));
    60	  if (address === "/") throw new Error(`${label} must be a non-root address.`);
    61	  return address;
    62	};
    63
    64	const array = (value: unknown, label: string): unknown[] => {
    65	  if (!Array.isArray(value)) throw new Error(`${label} must be an array.`);
    66	  return value;
    67	};
