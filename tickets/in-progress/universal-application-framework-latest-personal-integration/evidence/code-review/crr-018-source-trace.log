    73	    "llmModelIdentifier",
    74	    "llmConfig",
    75	    "autoExecuteTools",
    76	    "skillAccessMode",
    77	    "workspaceRootPath",
    78	  ], label);
    79	  if (!["autobyteus", "claude_agent_sdk", "codex_app_server"].includes(String(launch.runtimeKind))) {
    80	    throw new Error(`${label}.runtimeKind is unsupported.`);
    81	  }
    82	  required(launch.llmModelIdentifier, `${label}.llmModelIdentifier`);
