   114	  private async startAgent(
   115	    seed: BindingSeed,
   116	    ref: ApplicationExecutionResourceRef,
   117	    resource: ResolvedApplicationExecutionResource,
   118	    launch: ApplicationAgentRunLaunch,
   119	  ): Promise<ApplicationAgentBindingRecord> {
   120	    const runtimeKind = await this.currentModels.requireCurrentSelection({
   121	      runtimeKind: launch.runtimeKind,
   122	      llmModelIdentifier: launch.llmModelIdentifier,
   123	    });
   124	    const definition = await this.definitions.getAgentDefinitionById(resource.definitionId);
   125	    const displayName = definition?.name?.trim() || resource.name;
   126	    const run = await this.agents.createAgentRun({
   127	      agentDefinitionId: resource.definitionId,
   128	      workspaceRootPath: launch.workspaceRootPath,
   129	      workspaceId: launch.workspaceId ?? null,
   130	      llmModelIdentifier: launch.llmModelIdentifier,
   131	      autoExecuteTools: Boolean(launch.autoExecuteTools),
   132	      llmConfig: launch.llmConfig ?? null,
   133	      skillAccessMode: skillMode(launch.skillAccessMode),
   134	      runtimeKind,
   135	      applicationBinding: {
   136	        applicationId: seed.applicationId,
   137	        bindingId: seed.bindingId,
   138	        displayName,
   139	        runtimeKind: "AGENT",
   140	      },
   141	    });
   142	    const now = new Date().toISOString();
   143	    return this.persist({
   144	      ...seed,
   145	      status: "ATTACHED",
   146	      executionResourceRef: structuredClone(ref),
   147	      runtime: {
   148	        subject: "AGENT_RUN",
   149	        agentRunId: run.runId,
   150	        definitionId: resource.definitionId,
   151	        members: [],
   152	      },
   153	      createdAt: now,
   154	      updatedAt: now,
   155	      terminatedAt: null,
   156	      lastErrorMessage: null,
   157	    });
   158	  }
