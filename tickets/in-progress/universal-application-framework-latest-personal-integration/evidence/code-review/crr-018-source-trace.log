    84	  async startAgentRunBinding(
    85	    applicationId: string,
    86	    input: ApplicationStartAgentInput,
    87	  ): Promise<ApplicationAgentBindingRecord> {
    88	    if (input.launch.kind !== "AGENT") throw new Error("startAgent requires launch.kind 'AGENT'.");
    89	    const resource = await this.resolver.resolveExecutionResource(applicationId, input.executionResourceRef);
    90	    if (resource.kind !== "AGENT") throw new Error("startAgent requires an 'AGENT' execution resource.");
    91	    const seed = {
    92	      applicationId,
    93	      bindingId: randomUUID(),
    94	      launchRequestId: required(input.launchRequestId, "launchRequestId"),
    95	    };
    96	    return this.startAgent(seed, input.executionResourceRef, resource, input.launch);
    97	  }
