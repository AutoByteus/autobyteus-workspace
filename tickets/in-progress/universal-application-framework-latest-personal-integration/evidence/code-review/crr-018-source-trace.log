    36	export type TeamDefinitionTopologyPlan = Readonly<{
    37	  teamDefinitionName: string;
    38	  hasSubTeams: boolean;
    39	  config: TeamRunConfig;
    40	  agentLaunchSettings: readonly TeamAgentLaunchSettings[];
    41	}>;
    42
    43	type TeamDefinitionLookup = Pick<AgentTeamDefinitionService, "getDefinitionById">;
    44	type AgentIdAllocator = Pick<AgentRunIdentityAllocator, "allocateForAgentDefinition">;
    45	type TeamIdAllocator = Pick<TeamRunIdentityAllocator, "allocateForTeamDefinitionName">;
    46	type AgentGraphMember = Extract<ResolvedTeamDefinitionMember, { kind: "agent" }>;
    47	type GraphIndex = Readonly<{
    48	  teams: ReadonlyMap<AgentTeamAddress, ResolvedTeamDefinitionGraph>;
    49	  agents: ReadonlyMap<AgentTeamAddress, AgentGraphMember>;
    50	}>;
    51
    52	const required = (value: string, fieldName: string): string => {
    53	  const normalized = value.trim();
    54	  if (!normalized) throw new Error(`${fieldName} is required.`);
    55	  return normalized;
    56	};
    57
    58	const launchValue = (value: AgentLaunchConfiguration): AgentLaunchConfiguration => ({
    59	  runtimeKind: value.runtimeKind,
    60	  llmModelIdentifier: value.llmModelIdentifier,
    61	  llmConfig: value.llmConfig,
    62	  autoExecuteTools: value.autoExecuteTools,
    63	  skillAccessMode: value.skillAccessMode,
    64	  workspaceRootPath: value.workspaceRootPath,
    65	});
    66
    67	export class TeamDefinitionTopologyPlanner {
    68	  constructor(
    69	    private readonly teamDefinitionService: TeamDefinitionLookup,
    70	    private readonly teamRunIdentityAllocator: TeamIdAllocator,
    71	    private readonly agentRunIdentityAllocator: AgentIdAllocator,
    72	  ) {}
    73
    74	  async buildPlan(input: {
    75	    teamDefinitionId: string;
    76	    teamConfigs: readonly TeamScopeLaunchInput[];
    77	    memberConfigs: readonly TeamAgentLaunchInput[];
    78	    applicationBinding?: TeamRunApplicationBinding | null;
    79	  }): Promise<TeamDefinitionTopologyPlan> {
    80	    const { definition, graph } = await this.resolveGraph(input.teamDefinitionId);
    81	    const index = this.indexGraph(graph);
    82	    const teamConfigs = this.validateTeamConfigs(input.teamConfigs, index);
    83	    const memberConfigs = this.validateMemberConfigs(input.memberConfigs, index);
    84	    this.validateRootInheritedSkillAccess(teamConfigs, memberConfigs);
    85
    86	    // Exact subject and coverage validation finishes before any run identity allocation.
    87	    const rootTeam = await this.compileTeamNode(
    88	      graph,
    89	      createAgentTeamAddress([]),
    90	      this.teamRunIdentityAllocator.allocateForTeamDefinitionName(definition.name),
    91	      teamConfigs,
    92	      memberConfigs,
    93	    );
    94	    const config = new TeamRunConfig({
    95	      teamBackendKind: TeamBackendKind.MIXED,
    96	      rootTeam,
    97	      handoffs: new TeamHandoffCompiler().compile(graph),
    98	      applicationBinding: input.applicationBinding ?? null,
    99	    });
   100	    return Object.freeze({
   101	      teamDefinitionName: definition.name,
   102	      hasSubTeams: [...index.teams.keys()].some((address) => address !== "/"),
   103	      config,
   104	      agentLaunchSettings: Object.freeze(projectAgentLaunchSettings(config.rootTeam)),
   105	    });
   106	  }
   107
   108	  async buildRootLaunchInputs(input: {
   109	    teamDefinitionId: string;
   110	    rootConfig: AgentLaunchConfiguration;
   111	    memberConfigs?: readonly TeamAgentLaunchInput[] | null;
   112	  }): Promise<Readonly<{
   113	    teamConfigs: readonly TeamScopeLaunchInput[];
   114	    memberConfigs: readonly TeamAgentLaunchInput[];
   115	  }>> {
   116	    const { graph } = await this.resolveGraph(input.teamDefinitionId);
   117	    const index = this.indexGraph(graph);
   118	    const teamConfigs = Object.freeze([...index.teams.keys()].map((teamAddress) => Object.freeze({
   119	      teamAddress,
   120	      ...launchValue(input.rootConfig),
   121	    })));
   122	    const memberConfigs = input.memberConfigs
   123	      ? Object.freeze(input.memberConfigs.map((value) => Object.freeze({ ...value })))
   124	      : Object.freeze([...index.agents.entries()].map(([memberAddress, member]) => Object.freeze({
   125	          memberAddress,
   126	          agentDefinitionId: member.agentDefinitionId,
   127	          ...launchValue(input.rootConfig),
   128	        })));
   129	    return Object.freeze({ teamConfigs, memberConfigs });
   130	  }
   131
   132	  private async resolveGraph(teamDefinitionIdInput: string) {
   133	    const teamDefinitionId = required(teamDefinitionIdInput, "teamDefinitionId");
   134	    const definition = await this.teamDefinitionService.getDefinitionById(teamDefinitionId);
   135	    if (!definition) throw new Error(`AgentTeamDefinition with ID ${teamDefinitionId} not found.`);
   136	    const graph = await new TeamDefinitionGraphResolver().resolve({
   137	      rootDefinition: definition,
   138	      rootDefinitionId: teamDefinitionId,
   139	      lookup: { getTeamById: (id) => this.teamDefinitionService.getDefinitionById(id) },
   140	    });
   141	    return { definition, graph };
   142	  }
   143
   144	  private indexGraph(root: ResolvedTeamDefinitionGraph): GraphIndex {
   145	    const teams = new Map<AgentTeamAddress, ResolvedTeamDefinitionGraph>();
   146	    const agents = new Map<AgentTeamAddress, AgentGraphMember>();
   147	    const visit = (team: ResolvedTeamDefinitionGraph, address: AgentTeamAddress): void => {
   148	      teams.set(address, team);
   149	      for (const member of team.members) {
   150	        const memberAddress = createAgentTeamAddress(member.absolutePath);
   151	        if (member.kind === "agent") agents.set(memberAddress, member);
   152	        else visit(member.team, memberAddress);
   153	      }
   154	    };
   155	    visit(root, createAgentTeamAddress([]));
   156	    return Object.freeze({ teams, agents });
   157	  }
   158
   159	  private validateTeamConfigs(
   160	    values: readonly TeamScopeLaunchInput[],
   161	    index: GraphIndex,
   162	  ): ReadonlyMap<AgentTeamAddress, TeamScopeLaunchInput> {
   163	    const result = new Map<AgentTeamAddress, TeamScopeLaunchInput>();
   164	    for (const value of values) {
   165	      const address = assertAgentTeamAddress(value.teamAddress);
   166	      if (result.has(address)) throw new Error(`Duplicate Team launch settings for '${address}'.`);
   167	      if (index.agents.has(address)) throw new Error(`Team launch settings reference Agent placement '${address}'.`);
   168	      if (!index.teams.has(address)) throw new Error(`Team launch settings reference unknown Team '${address}'.`);
   169	      result.set(address, value);
   170	    }
   171	    const missing = [...index.teams.keys()].find((address) => !result.has(address));
   172	    if (missing) throw new Error(`Launch settings for Team '${missing}' were not provided.`);
   173	    return result;
   174	  }
   175
   176	  private validateMemberConfigs(
   177	    values: readonly TeamAgentLaunchInput[],
   178	    index: GraphIndex,
   179	  ): ReadonlyMap<AgentTeamAddress, TeamAgentLaunchInput> {
   180	    const result = new Map<AgentTeamAddress, TeamAgentLaunchInput>();
   181	    for (const value of values) {
   182	      const address = assertAgentTeamAddress(value.memberAddress);
   183	      if (address === "/") throw new Error("Agent launch settings cannot reference root Team '/'.");
   184	      if (result.has(address)) throw new Error(`Duplicate Agent launch settings for '${address}'.`);
   185	      if (index.teams.has(address)) throw new Error(`Agent launch settings reference Team placement '${address}'.`);
   186	      const member = index.agents.get(address);
   187	      if (!member) throw new Error(`Agent launch settings reference unknown Team member '${address}'.`);
   188	      if (value.agentDefinitionId && value.agentDefinitionId !== member.agentDefinitionId) {
   189	        throw new Error(`Launch settings for '${address}' reference the wrong Agent definition.`);
   190	      }
   191	      result.set(address, value);
   192	    }
   193	    const missing = [...index.agents.keys()].find((address) => !result.has(address));
   194	    if (missing) throw new Error(`Launch settings for Team member '${missing}' were not provided.`);
   195	    return result;
   196	  }
   197
   198	  private validateRootInheritedSkillAccess(
   199	    teamConfigs: ReadonlyMap<AgentTeamAddress, TeamScopeLaunchInput>,
   200	    memberConfigs: ReadonlyMap<AgentTeamAddress, TeamAgentLaunchInput>,
   201	  ): void {
   202	    const rootMode = teamConfigs.get("/" as AgentTeamAddress)!.skillAccessMode;
   203	    const divergentTeam = [...teamConfigs.entries()].find(([, config]) => config.skillAccessMode !== rootMode);
   204	    if (divergentTeam) throw new Error(`Team '${divergentTeam[0]}' cannot override root skillAccessMode.`);
   205	    const divergentAgent = [...memberConfigs.entries()].find(([, config]) => config.skillAccessMode !== rootMode);
   206	    if (divergentAgent) throw new Error(`Agent '${divergentAgent[0]}' cannot override root skillAccessMode.`);
   207	  }
   208
   209	  private async compileTeamNode(
   210	    graph: ResolvedTeamDefinitionGraph,
   211	    address: AgentTeamAddress,
   212	    teamRunId: string,
   213	    teamConfigs: ReadonlyMap<AgentTeamAddress, TeamScopeLaunchInput>,
   214	    memberConfigs: ReadonlyMap<AgentTeamAddress, TeamAgentLaunchInput>,
   215	  ): Promise<TeamRunAgentTeamNode> {
   216	    const placement = address === "/" ? {} : { role: null, description: null };
   217	    return {
   218	      kind: "agent_team",
   219	      address,
   220	      teamDefinitionId: graph.definitionId,
   221	      teamRunId,
   222	      coordinatorAddress: createAgentTeamAddress(graph.coordinator.absolutePath),
   223	      defaultLaunchConfiguration: launchValue(teamConfigs.get(address)!),
   224	      ...placement,
   225	      children: await Promise.all(graph.members.map((member) =>
   226	        this.compileMember(member, teamConfigs, memberConfigs))),
   227	    };
   228	  }
   229
   230	  private async compileMember(
   231	    member: ResolvedTeamDefinitionMember,
   232	    teamConfigs: ReadonlyMap<AgentTeamAddress, TeamScopeLaunchInput>,
   233	    memberConfigs: ReadonlyMap<AgentTeamAddress, TeamAgentLaunchInput>,
   234	  ): Promise<TeamRunNode> {
   235	    const address = createAgentTeamAddress(member.absolutePath);
   236	    if (member.kind === "agent_team") {
   237	      return this.compileTeamNode(
   238	        member.team,
   239	        address,
   240	        this.teamRunIdentityAllocator.allocateForTeamDefinitionName(member.team.definition.name),
   241	        teamConfigs,
   242	        memberConfigs,
   243	      );
   244	    }
   245	    const launch = memberConfigs.get(address)!;
   246	    const agentRunId = await this.agentRunIdentityAllocator.allocateForAgentDefinition(member.agentDefinitionId);
   247	    return {
   248	      kind: "agent",
   249	      address,
   250	      agentDefinitionId: member.agentDefinitionId,
   251	      agentRunId,
   252	      platformAgentRunId: null,
   253	      role: null,
   254	      description: null,
   255	      ...launchValue(launch),
   256	    };
   257	  }
   258	}

