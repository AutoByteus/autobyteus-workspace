    94	  private async classifyStandalone(
    95	    locations: Map<string, RuntimeMemoryLocation>,
    96	    blockedPaths: Set<string>,
    97	    diagnostics: RuntimeMemoryLocationDiagnostic[],
    98	  ): Promise<void> {
    99	    const rootDir = this.layout.getStandaloneRootDirPath();
   100	    const runIds = await this.listDirectories(rootDir, diagnostics);
   101	    for (const runId of runIds) {
   102	      const metadataPath = this.runMetadataStore.getMetadataPath(runId);
   103	      try {
   104	        const metadata = await this.runMetadataStore.readMetadata(runId);
   105	        if (!metadata) {
   106	          const present = await pathExists(metadataPath);
   107	          diagnostics.push({
   108	            itemId: `agents/${runId}:metadata`,
   109	            filePath: metadataPath,
   110	            status: present ? "FAILED" : "SKIPPED",
   111	            reasonCode: present ? "metadata_invalid" : "metadata_missing",
   112	            message: present
   113	              ? "Standalone metadata exists but is not valid current run metadata."
   114	              : "Standalone run has no current metadata and was not classified.",
   115	          });
   116	          continue;
   117	        }
   118	        if (metadata.runId !== runId) {
   119	          throw new Error(`Metadata runId '${metadata.runId}' does not match directory '${runId}'.`);
   120	        }
   121	        const exact = this.locationService.getStandaloneLocation({
   122	          agentRunId: runId,
   123	        });
   124	        this.registerLocation(locations, blockedPaths, diagnostics, {
   125	          itemId: `agents/${runId}`,
   126	          memoryDir: path.resolve(exact.memoryDir),
   127	          workingContextSnapshotPath: path.resolve(
   128	            exact.memoryDir,
   129	            WORKING_CONTEXT_SNAPSHOT_FILE_NAME,
   130	          ),
   131	          runtimeKind: runtimeKindFromString(metadata.runtimeKind),
   132	          snapshotAgentId: runId,
   133	          subject: { kind: "standalone", runId },
   134	        });
   135	      } catch (error) {
   136	        diagnostics.push({
   137	          itemId: `agents/${runId}:metadata`,
   138	          filePath: metadataPath,
   139	          status: "FAILED",
   140	          reasonCode: "metadata_invalid",
   141	          message: `Could not classify standalone run metadata: ${messageFromError(error)}`,
   142	        });
   143	      }
   144	    }
   145	  }
