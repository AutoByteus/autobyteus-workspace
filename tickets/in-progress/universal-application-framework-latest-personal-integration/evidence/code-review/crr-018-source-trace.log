   288	const deepFreeze = <T>(value: T): T => {
   289	  if (value && typeof value === "object" && !Object.isFrozen(value)) {
   290	    Object.freeze(value);
   291	    Object.values(value as Record<string, unknown>).forEach(deepFreeze);
   292	  }
   293	  return value;
   294	};
