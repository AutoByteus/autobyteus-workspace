    40	export class ApplicationLaunchResourceBaselineError extends Error {
    41	  constructor(
    42	    readonly code:
    43	      | "PACKAGE_DEFAULT_MISSING"
    44	      | "PACKAGE_RESOURCE_UNAVAILABLE"
    45	      | "PACKAGE_RESOURCE_NOT_ALLOWED"
    46	      | "PACKAGE_DEFAULT_INCOMPLETE"
    47	      | "PACKAGE_TEAM_TOPOLOGY_INVALID",
    48	    message: string,
    49	  ) {
    50	    super(message);
    51	    this.name = "ApplicationLaunchResourceBaselineError";
    52	  }
    53	}
    54
    55	const cloneConfig = (
    56	  value: Record<string, unknown> | null,
    57	): Record<string, unknown> | null => value ? structuredClone(value) : null;
    58
    59	const resolveStringValue = (
    60	  layers: LaunchLayer[],
    61	  field: "runtimeKind" | "llmModelIdentifier",
    62	): { value: string; source: ApplicationLaunchDefinitionValueSource } | null => {
    63	  for (const layer of layers) {
    64	    const value = layer.config?.[field]?.trim();
    65	    if (value) return { value, source: structuredClone(layer.source) };
    66	  }
    67	  return null;
    68	};
    69
    70	const resolveAtomicLlmConfig = (input: {
    71	  layers: LaunchLayer[];
    72	  runtimeKind: string;
    73	  llmModelIdentifier: string;
    74	}): { value: Record<string, unknown> | null; source: ApplicationLaunchDefinitionValueSource | null } => {
    75	  const layer = input.layers.find((candidate) => candidate.config?.llmConfig != null) ?? null;
    76	  if (!layer?.config?.llmConfig) return { value: null, source: null };
    77	  const configuredRuntime = layer.config.runtimeKind?.trim() || null;
    78	  const configuredModel = layer.config.llmModelIdentifier?.trim() || null;
    79	  if (
    80	    (configuredRuntime && configuredRuntime !== input.runtimeKind)
    81	    || (configuredModel && configuredModel !== input.llmModelIdentifier)
    82	  ) {
    83	    return { value: null, source: null };
    84	  }
    85	  return {
    86	    value: cloneConfig(layer.config.llmConfig),
    87	    source: structuredClone(layer.source),
    88	  };
    89	};
    90
    91	const buildBaselineLeaf = (input: {
    92	  memberAddress: string | null;
    93	  displayName: string;
    94	  agentDefinitionId: string;
    95	  layers: LaunchLayer[];
    96	}): ApplicationResolvedLaunchBaselineLeaf => {
    97	  const runtime = resolveStringValue(input.layers, "runtimeKind");
    98	  const model = resolveStringValue(input.layers, "llmModelIdentifier");
    99	  const llmConfig = runtime && model
   100	    ? resolveAtomicLlmConfig({
   101	        layers: input.layers,
   102	        runtimeKind: runtime.value,
   103	        llmModelIdentifier: model.value,
   104	      })
   105	    : { value: null, source: null };
   106	  return {
   107	    memberAddress: input.memberAddress,
   108	    displayName: input.displayName,
   109	    agentDefinitionId: input.agentDefinitionId,
   110	    runtimeKind: runtime?.value ?? null,
   111	    llmModelIdentifier: model?.value ?? null,
   112	    llmConfig: llmConfig.value,
   113	    provenance: {
   114	      runtimeKind: runtime?.source ?? null,
   115	      llmModelIdentifier: model?.source ?? null,
   116	      llmConfig: llmConfig.source,
   117	    },
   118	  };
   119	};
