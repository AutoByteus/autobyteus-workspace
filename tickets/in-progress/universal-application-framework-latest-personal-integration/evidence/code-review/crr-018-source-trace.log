   192	          itemId: `agent_teams/${teamRunId}:metadata`,
   193	          filePath: metadataPath,
   194	          status: "FAILED",
   195	          reasonCode: "metadata_invalid",
   196	          message: `Could not classify TeamRun execution tree: ${messageFromError(error)}`,
   197	        });
   198	      }
   199	    }
   200	  }
