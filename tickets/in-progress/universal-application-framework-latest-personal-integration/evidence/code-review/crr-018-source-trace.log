   155
   156	export class ApplicationLaunchResourceBaselineBuilder {
   157	  constructor(private readonly dependencies: {
   158	    executionResourceResolver: ApplicationExecutionResourceResolver;
   159	    agentDefinitionService: AgentDefinitionService;
   160	    agentTeamDefinitionService: AgentTeamDefinitionService;
   161	  }) {}
   162
   163	  async build(input: {
   164	    applicationId: string;
   165	    slot: ApplicationExecutionResourceSlotDeclaration;
   166	    executionResourceRef: ApplicationExecutionResourceRef;
   167	    provenance: "PACKAGE" | "SELECTED_RESOURCE";
   168	  }): Promise<ApplicationResolvedResourceLaunchBaseline> {
   169	    this.assertSelectionAllowed(input.slot, input.executionResourceRef);
   170	    let resource;
   171	    try {
   172	      resource = await this.dependencies.executionResourceResolver.resolveExecutionResource(
   173	        input.applicationId,
   174	        input.executionResourceRef,
   175	      );
   176	    } catch (error) {
   177	      throw new ApplicationLaunchResourceBaselineError(
   178	        "PACKAGE_RESOURCE_UNAVAILABLE",
   179	        error instanceof Error ? error.message : String(error),
   180	      );
   181	    }
   182	    if (resource.kind === "AGENT") {
   183	      const leaves = [await this.buildAgentLeaf({
   184	          agentDefinitionId: resource.definitionId,
   185	          memberAddress: null,
   186	          displayName: resource.name,
   187	          parentLayers: [],
   188	          provenance: input.provenance,
   189	        })];
   190	      return {
   191	        slotKey: input.slot.slotKey,
   192	        executionResourceRef: structuredClone(input.executionResourceRef),
   193	        resourceDefinitionId: resource.definitionId,
   194	        resourceKind: "AGENT",
   195	        leaves,
   196	      };
   197	    }
   198	    const topology = await this.buildTeamTopology({
   199	      teamDefinitionId: resource.definitionId,
   200	      memberPath: [],
   201	      displayName: resource.name,
   202	      parentLayers: [],
   203	      provenance: input.provenance,
   204	      visited: new Set(),
   205	    });
   206	    if (topology.leaves.length === 0) {
   207	      throw new ApplicationLaunchResourceBaselineError(
   208	        "PACKAGE_TEAM_TOPOLOGY_INVALID",
   209	        `Application slot '${input.slot.slotKey}' selected team has no leaf agents.`,
   210	      );
   211	    }
   212	    return {
   213	      slotKey: input.slot.slotKey,
   214	      executionResourceRef: structuredClone(input.executionResourceRef),
   215	      resourceDefinitionId: resource.definitionId,
   216	      resourceKind: "AGENT_TEAM",
   217	      teamScopes: topology.teamScopes.sort((left, right) =>
   218	        left.teamAddress.localeCompare(right.teamAddress)),
   219	      leaves: topology.leaves.sort((left, right) =>
   220	        (left.memberAddress ?? "").localeCompare(right.memberAddress ?? "")),
   221	    };
   222	  }
   223
   224	  private assertSelectionAllowed(
   225	    slot: ApplicationExecutionResourceSlotDeclaration,
   226	    ref: ApplicationExecutionResourceRef,
   227	  ): void {
   228	    if (!slot.allowedExecutionResourceKinds.includes(ref.kind)) {
   229	      throw new ApplicationLaunchResourceBaselineError(
   230	        "PACKAGE_RESOURCE_NOT_ALLOWED",
   231	        `Application slot '${slot.slotKey}' does not allow resource kind '${ref.kind}'.`,
   232	      );
   233	    }
   234	    const allowedSources = slot.allowedExecutionResourceSources ?? ["bundle", "shared"];
   235	    if (!allowedSources.includes(ref.source)) {
   236	      throw new ApplicationLaunchResourceBaselineError(
   237	        "PACKAGE_RESOURCE_NOT_ALLOWED",
   238	        `Application slot '${slot.slotKey}' does not allow resource source '${ref.source}'.`,
   239	      );
   240	    }
   241	  }
   242
   243	  private async buildAgentLeaf(input: {
   244	    agentDefinitionId: string;
   245	    memberAddress: string | null;
   246	    displayName: string;
   247	    parentLayers: LaunchLayer[];
   248	    provenance: "PACKAGE" | "SELECTED_RESOURCE";
   249	  }): Promise<ApplicationResolvedLaunchBaselineLeaf> {
   250	    const definition = await this.dependencies.agentDefinitionService
   251	      .getAgentDefinitionById(input.agentDefinitionId);
   252	    if (!definition) {
   253	      throw new ApplicationLaunchResourceBaselineError(
   254	        "PACKAGE_TEAM_TOPOLOGY_INVALID",
   255	        `Agent definition '${input.agentDefinitionId}' was not found.`,
   256	      );
   257	    }
   258	    return buildBaselineLeaf({
   259	      ...input,
   260	      displayName: input.displayName || definition.name,
   261	      layers: [
   262	        ...input.parentLayers,
   263	        {
   264	          config: definition.defaultLaunchConfig,
   265	          source: definitionValueSource({
   266	            provenance: input.provenance,
   267	            definitionKind: "AGENT",
   268	            definitionId: input.agentDefinitionId,
   269	          }),
   270	        },
   271	      ],
   272	    });
   273	  }
   274
   275	  private async buildTeamTopology(input: {
   276	    teamDefinitionId: string;
   277	    memberPath: string[];
   278	    displayName: string;
   279	    parentLayers: LaunchLayer[];
   280	    provenance: "PACKAGE" | "SELECTED_RESOURCE";
   281	    visited: Set<string>;
   282	  }): Promise<TeamBaselineTopology> {
   283	    if (input.visited.has(input.teamDefinitionId)) {
   284	      throw new ApplicationLaunchResourceBaselineError(
   285	        "PACKAGE_TEAM_TOPOLOGY_INVALID",
   286	        `Circular team topology includes '${input.teamDefinitionId}'.`,
   287	      );
   288	    }
   289	    const visited = new Set(input.visited).add(input.teamDefinitionId);
   290	    const team = await this.dependencies.agentTeamDefinitionService
   291	      .getDefinitionById(input.teamDefinitionId);
   292	    if (!team) {
   293	      throw new ApplicationLaunchResourceBaselineError(
   294	        "PACKAGE_TEAM_TOPOLOGY_INVALID",
   295	        `Team definition '${input.teamDefinitionId}' was not found.`,
   296	      );
   297	    }
   298	    const teamLayers: LaunchLayer[] = [
   299	      {
   300	        config: team.defaultLaunchConfig,
   301	        source: definitionValueSource({
   302	          provenance: input.provenance,
   303	          definitionKind: "AGENT_TEAM",
   304	          definitionId: input.teamDefinitionId,
   305	        }),
   306	      },
   307	      ...input.parentLayers,
   308	    ];
   309	    const resolutionContext = buildScopedMemberResolutionContext(team, input.teamDefinitionId);
   310	    const teamScopes: ApplicationResolvedTeamLaunchBaselineScope[] = [buildBaselineTeamScope({
   311	      teamAddress: createAgentTeamAddress(input.memberPath),
   312	      displayName: input.displayName || team.name,
   313	      teamDefinitionId: input.teamDefinitionId,
   314	      layers: teamLayers,
   315	    })];
   316	    const leaves: ApplicationResolvedLaunchBaselineLeaf[] = [];
   317	    for (const member of team.nodes) {
   318	      const memberPath = [...input.memberPath, member.memberName.trim()];
   319	      if (member.refType === "agent") {
   320	        leaves.push(await this.buildAgentLeaf({
   321	          agentDefinitionId: resolveScopedAgentMemberRef(resolutionContext, member),
   322	          memberAddress: createAgentTeamAddress(memberPath),
   323	          displayName: member.memberName.trim(),
   324	          parentLayers: teamLayers,
   325	          provenance: input.provenance,
   326	        }));
   327	      } else {
   328	        const nested = await this.buildTeamTopology({
   329	          teamDefinitionId: resolveScopedTeamMemberRef(resolutionContext, member),
   330	          memberPath,
   331	          displayName: member.memberName.trim(),
   332	          parentLayers: teamLayers,
   333	          provenance: input.provenance,
   334	          visited,
   335	        });
   336	        teamScopes.push(...nested.teamScopes);
   337	        leaves.push(...nested.leaves);
   338	      }
   339	    }
   340	    return { teamScopes, leaves };
   341	  }
   342	}

