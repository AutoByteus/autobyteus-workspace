    57	/** Application-facing root TeamRun lifecycle service. */
    58	export class TeamRunService {
    59	  private readonly definitions: AgentTeamDefinitionService;
    60	  private readonly manager: AgentTeamRunManager;
    61	  private readonly catalog: TeamRunHistoryCatalogService;
    62	  private readonly workspaces: WorkspaceManager;
    63	  private readonly agentIdentityAllocator: Pick<AgentRunIdentityAllocator, "allocateForAgentDefinition">;
    64	  private readonly teamIdentityAllocator: Pick<TeamRunIdentityAllocator, "allocateForTeamDefinitionName">;
    65	  private readonly tokenUsageReadiness: Pick<TokenUsageMigrationReadiness,
    66	    "assertCurrentSchemaReady" | "assertExistingRunRestoreReady">;
    67
    68	  constructor(options: {
    69	    agentTeamRunManager?: AgentTeamRunManager;
    70	    teamDefinitionService?: AgentTeamDefinitionService;
    71	    teamRunHistoryCatalogService?: TeamRunHistoryCatalogService;
    72	    workspaceManager?: WorkspaceManager;
    73	    memoryDir?: string;
    74	    memoryLocationService?: AgentMemoryLocationService;
    75	    agentRunIdentityAllocator?: Pick<AgentRunIdentityAllocator, "allocateForAgentDefinition">;
    76	    teamRunIdentityAllocator?: Pick<TeamRunIdentityAllocator, "allocateForTeamDefinitionName">;
    77	    tokenUsageReadiness?: Pick<TokenUsageMigrationReadiness,
    78	      "assertCurrentSchemaReady" | "assertExistingRunRestoreReady">;
    79	  } = {}) {
    80	    this.manager = options.agentTeamRunManager ?? AgentTeamRunManager.getInstance();
    81	    this.definitions = options.teamDefinitionService ?? AgentTeamDefinitionService.getInstance();
    82	    this.catalog = options.teamRunHistoryCatalogService ?? getTeamRunHistoryCatalogService();
    83	    this.workspaces = options.workspaceManager ?? getWorkspaceManager();
    84	    void (options.memoryLocationService ?? (options.memoryDir ? new AgentMemoryLocationService({ memoryDir: options.memoryDir }) : getAgentMemoryLocationService()));
    85	    this.agentIdentityAllocator = options.agentRunIdentityAllocator ?? new AgentRunIdentityAllocator({
    86	      memoryDir: options.memoryDir ?? appConfigProvider.config.getMemoryDir(),
    87	    });
    88	    this.teamIdentityAllocator = options.teamRunIdentityAllocator ?? new TeamRunIdentityAllocator();
    89	    this.tokenUsageReadiness = options.tokenUsageReadiness ?? new TokenUsageMigrationReadiness();
    90	  }
    91
    92	  async createTeamRun(input: CreateTeamRunInput): Promise<RootTeamRun> {
    93	    this.tokenUsageReadiness.assertCurrentSchemaReady();
    94	    const workspaces = new Map<string, Promise<string>>();
    95	    const activateWorkspace = async (requestedPath: string | null | undefined): Promise<string | null> => {
    96	      const requested = requestedPath?.trim() || null;
    97	      if (!requested) return null;
    98	      const canonical = canonicalizeWorkspaceRootPath(requested);
    99	      let activation = workspaces.get(canonical);
   100	      if (!activation) {
   101	        activation = this.workspaces.ensureWorkspaceByRootPath(canonical)
   102	          .then((workspace) => workspace.getBasePath?.() ?? canonical);
   103	        workspaces.set(canonical, activation);
   104	      }
   105	      return activation;
   106	    };
   107	    const normalizedTeamConfigs = input.teamConfigs.map((team, index) => ({
   108	      ...team,
   109	      runtimeKind: resolveRequiredRuntimeKind(team.runtimeKind, `teamConfigs[${index}].runtimeKind`),
   110	      llmConfig: team.llmConfig ?? null,
   111	    }));
   112	    const normalizedMemberConfigs = input.memberConfigs.map((member, index) => ({
   113	      ...member,
   114	      runtimeKind: resolveRequiredRuntimeKind(member.runtimeKind, `memberConfigs[${index}].runtimeKind`),
   115	      llmConfig: member.llmConfig ?? null,
   116	    }));
   117	    const teamConfigs: TeamScopeLaunchInput[] = await Promise.all(normalizedTeamConfigs.map(async (team) => ({
   118	      ...team,
   119	      workspaceRootPath: await activateWorkspace(team.workspaceRootPath),
   120	    })));
   121	    const memberConfigs: TeamAgentLaunchInput[] = await Promise.all(normalizedMemberConfigs.map(async (member) => ({
   122	      ...member,
   123	      workspaceRootPath: await activateWorkspace(member.workspaceRootPath),
   124	    })));
   125	    const plan = await this.planner.buildPlan({
   126	      teamDefinitionId: input.teamDefinitionId,
   127	      teamConfigs,
   128	      memberConfigs,
   129	      applicationBinding: input.applicationBinding ?? null,
   130	    });
   131	    const root = await this.manager.createTeamRun({ config: plan.config, teamDefinitionName: plan.teamDefinitionName });
   132	    try {
   133	      await this.catalog.recordTeamRunCreated({ tree: root.getExecutionTreeSnapshot(), summary: "" });
   134	      return root;
   135	    } catch (error) {
   136	      await this.safeTerminate(root.teamRunId);
   137	      throw error;
   138	    }
   139	  }
   140
   141	  async createTeamRunFromRootConfig(input: {
   142	    teamDefinitionId: string;
   143	    rootConfig: TeamRunPresetInput;
   144	    memberConfigs?: TeamRunMemberConfigInput[] | null;
   145	    applicationBinding?: { applicationId: string; bindingId: string } | null;
   146	  }): Promise<RootTeamRun> {
   147	    const rootConfig = normalizePreset(input.rootConfig);
   148	    const expanded = await this.planner.buildRootLaunchInputs({
   149	      teamDefinitionId: required(input.teamDefinitionId, "teamDefinitionId"),
   150	      rootConfig,
   151	      memberConfigs: input.memberConfigs?.map((member) => ({
   152	        ...member,
   153	        runtimeKind: resolveRequiredRuntimeKind(member.runtimeKind, "memberConfigs.runtimeKind"),
   154	        workspaceRootPath: member.workspaceRootPath?.trim() || null,
   155	        llmConfig: member.llmConfig ?? null,
   156	      })),
   157	    });
   158	    return this.createTeamRun({
   159	      teamDefinitionId: input.teamDefinitionId,
   160	      applicationBinding: input.applicationBinding,
   161	      teamConfigs: [...expanded.teamConfigs],
   162	      memberConfigs: [...expanded.memberConfigs],
   163	    });
   164	  }
   165
   166	  async restoreTeamRun(teamRunId: string): Promise<RootTeamRun> {
   167	    const normalized = required(teamRunId, "teamRunId");
   168	    if (this.manager.hasManagedTeamRun(normalized)) throw new Error(`Team run '${normalized}' is already managed and cannot be restored.`);
   169	    this.tokenUsageReadiness.assertExistingRunRestoreReady();
   170	    const root = await this.manager.restoreTeamRun(normalized);
   171	    try {
   172	      await this.catalog.recordTeamRunRestored({ tree: root.getExecutionTreeSnapshot() });
   173	      return root;
   174	    } catch (error) {
   175	      await this.safeTerminate(normalized);
   176	      throw error;
   177	    }
   178	  }
   179
   180	  getActiveTeamRun(teamRunId: string): RootTeamRun | null {
   181	    return this.manager.getActiveTeamRun(required(teamRunId, "teamRunId"));
   182	  }
   183	  getManagedTeamRun(teamRunId: string): RootTeamRun | null {
   184	    return this.manager.getManagedTeamRun(required(teamRunId, "teamRunId"));
   185	  }
   186	  async resolveActiveTeamRun(teamRunId: string): Promise<RootTeamRun | null> {
   187	    const normalized = required(teamRunId, "teamRunId");
   188	    const active = this.getActiveTeamRun(normalized);
   189	    if (active || this.manager.hasManagedTeamRun(normalized)) return active;
   190	    return this.restoreTeamRun(normalized).catch(() => null);
   191	  }
   192	  async resolveManagedTeamRun(teamRunId: string): Promise<RootTeamRun | null> {
   193	    const normalized = required(teamRunId, "teamRunId");
   194	    return this.getManagedTeamRun(normalized) ?? this.restoreTeamRun(normalized).catch(() => null);
   195	  }
   196	  recordRunActivity(run: RootTeamRun, input: { summary?: string | null } = {}): Promise<void> {
   197	    return this.catalog.recordTeamRunSummary({ teamRunId: run.teamRunId, summary: input.summary });
   198	  }
   199	  async terminateTeamRun(teamRunId: string): Promise<boolean> {
   200	    const success = await this.manager.terminateTeamRun(teamRunId);
   201	    if (success) await this.catalog.recordTeamRunTerminated({ teamRunId });
   202	    return success;
   203	  }
   204	  async observeTeamRunLifecycle(teamRunId: string, listener: (event: ObservedRunLifecycleEvent) => void): Promise<(() => void) | null> {
   205	    const root = await this.resolveActiveTeamRun(teamRunId);
   206	    if (!root) return null;
   207	    listener({ runtimeSubject: "TEAM_RUN", runId: root.teamRunId, phase: "ATTACHED", occurredAt: new Date().toISOString() });
   208	    const offLifecycle = this.manager.subscribeToLifecycle(root.teamRunId, (snapshot) => {
   209	      if (!snapshot.isActive) listener({ runtimeSubject: "TEAM_RUN", runId: root.teamRunId, phase: "TERMINATED", occurredAt: new Date().toISOString() });
   210	    });
   211	    const offEvents = root.subscribeToEvents(({ event }) => {
   212	      if (event.eventSourceType === TeamRunEventSourceType.AGENT && event.payload.eventType === "ERROR") {
   213	        listener({ runtimeSubject: "TEAM_RUN", runId: root.teamRunId, phase: "FAILED", occurredAt: new Date().toISOString(), errorMessage: event.payload.details.message });
   214	      }
   215	    });
   216	    return () => { offEvents(); offLifecycle(); };
   217	  }
   218
   219	  private safeTerminate(teamRunId: string): Promise<void> {
   220	    return this.manager.terminateTeamRun(teamRunId).then(() => undefined).catch(() => undefined);
   221	  }
   222	  private get planner(): TeamDefinitionTopologyPlanner {
   223	    return new TeamDefinitionTopologyPlanner(
   224	      this.definitions,
   225	      this.teamIdentityAllocator,
   226	      this.agentIdentityAllocator,
   227	    );
   228	  }
   229	}
   230
   231	let cached: TeamRunService | null = null;
   232	export const getTeamRunService = (): TeamRunService => cached ??= new TeamRunService();
   233	const required = (value: string, field: string): string => {
   234	  const normalized = value.trim();
   235	  if (!normalized) throw new Error(`${field} is required.`);
   236	  return normalized;
   237	};
   238	const resolveRequiredRuntimeKind = (value: unknown, field: string): RuntimeKind => {
   239	  if (typeof value !== "string" || !value.trim()) throw new Error(`${field} is required.`);
   240	  const resolved = runtimeKindFromString(value, null);
   241	  if (!resolved) throw new Error(`[INVALID_RUNTIME_KIND] Unsupported ${field} '${value}'.`);
   242	  return resolved;
   243	};
   244	const normalizePreset = (value: TeamRunPresetInput): AgentLaunchConfiguration => ({
   245	  workspaceRootPath: required(value.workspaceRootPath, "teamLaunchPreset.workspaceRootPath"),
   246	  llmModelIdentifier: required(value.llmModelIdentifier, "teamLaunchPreset.llmModelIdentifier"),
   247	  runtimeKind: resolveRequiredRuntimeKind(value.runtimeKind, "teamLaunchPreset.runtimeKind"),
   248	  autoExecuteTools: Boolean(value.autoExecuteTools),
   249	  skillAccessMode: value.skillAccessMode,
   250	  llmConfig: value.llmConfig ?? null,
   251	});

