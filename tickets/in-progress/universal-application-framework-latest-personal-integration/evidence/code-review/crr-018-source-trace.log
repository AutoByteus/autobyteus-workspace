   194	type ConfiguredPlacement = ConfiguredExecutionNode;
   195
   196	const validateTreeInvariants = (tree: TeamRunExecutionTreeFileV2): void => {
   197	  const configured = new Map<AgentTeamAddress, ConfiguredPlacement>();
   198	  const agentRuns = new Set<string>();
   199	  const teamRuns = new Set<string>();
   200
   201	  const addAgentRun = (runId: string): void => {
   202	    if (agentRuns.has(runId)) throw new Error(`Duplicate AgentRun ID '${runId}'.`);
   203	    agentRuns.add(runId);
   204	  };
   205	  const addTeamRun = (runId: string): void => {
   206	    if (teamRuns.has(runId)) throw new Error(`Duplicate TeamRun ID '${runId}'.`);
   207	    teamRuns.add(runId);
   208	  };
   209
   210	  const visitConfigured = (
   211	    member: ConfiguredExecutionNode,
   212	    parentAddress: AgentTeamAddress | "/",
   213	  ): void => {
   214	    if (getParentAgentTeamAddress(member.address) !== parentAddress) {
   215	      throw new Error(`Configured placement '${member.address}' is not a direct child of '${parentAddress}'.`);
   216	    }
   217	    if (configured.has(member.address)) throw new Error(`Duplicate configured address '${member.address}'.`);
   218	    configured.set(member.address, member);
   219	    if ("agentRunId" in member) {
   220	      addAgentRun(member.agentRunId);
   221	      return;
   222	    }
   223	    addTeamRun(member.teamRunId);
   224	    const coordinator = member.members.find((child) =>
   225	      "agentRunId" in child && child.address === member.coordinatorAddress);
   226	    if (!coordinator) throw new Error(`Configured Team '${member.address}' has no direct coordinator Agent.`);
   227	    member.members.forEach((child) => visitConfigured(child, member.address));
   228	  };
   229
   230	  addTeamRun(tree.rootTeam.teamRunId);
   231	  tree.rootTeam.members.forEach((member) => visitConfigured(member, "/"));
   232	  const rootCoordinator = tree.rootTeam.members.find((member) =>
   233	    "agentRunId" in member && member.address === tree.rootTeam.coordinatorAddress);
   234	  if (!rootCoordinator) throw new Error("rootTeam has no direct coordinator Agent.");
   235
   236	  const visitTaskTeamMember = (
   237	    member: TaskTeamMemberExecution,
   238	    sourceTeam: ConfiguredTeamExecutionNode | RootConfiguredTeamExecutionNode,
   239	  ): void => {
   240	    const source = sourceTeam.members.find((candidate) => candidate.address === member.address);
   241	    if (!source || ("agentRunId" in source) !== ("agentRunId" in member)) {
   242	      throw new Error(`Task-Team member '${member.address}' does not match a direct configured member.`);
   243	    }
   244	    if ("agentRunId" in member) {
   245	      addAgentRun(member.agentRunId);
   246	      return;
   247	    }
   248	    addTeamRun(member.teamRunId);
   249	    const configuredTeam = source as ConfiguredTeamExecutionNode;
   250	    member.members.forEach((child) => visitTaskTeamMember(child, configuredTeam));
   251	    member.taskExecutions.forEach((task) => visitTask(task, member.teamRunId));
   252	  };
   253
   254	  const visitTask = (task: TaskExecution, ownerTeamRunId: string): void => {
   255	    void ownerTeamRunId;
   256	    const source = configured.get(task.address);
   257	    if (!source || ("agentRunId" in source) !== ("agentRunId" in task)) {
   258	      throw new Error(`Task execution '${task.address}' does not match a configured placement.`);
   259	    }
   260	    if ("agentRunId" in task) {
   261	      addAgentRun(task.agentRunId);
   262	      return;
   263	    }
   264	    addTeamRun(task.teamRunId);
   265	    const configuredTeam = source as ConfiguredTeamExecutionNode;
   266	    task.members.forEach((member) => visitTaskTeamMember(member, configuredTeam));
   267	    task.taskExecutions.forEach((child) => visitTask(child, task.teamRunId));
   268	  };
   269
   270	  const visitOwnedTasks = (team: RootConfiguredTeamExecutionNode | ConfiguredTeamExecutionNode): void => {
   271	    team.taskExecutions.forEach((task) => visitTask(task, team.teamRunId));
   272	    team.members.forEach((member) => {
   273	      if ("teamRunId" in member) visitOwnedTasks(member);
   274	    });
   275	  };
   276	  visitOwnedTasks(tree.rootTeam);
   277
   278	  for (const handoff of tree.handoffs) {
   279	    const from = assertAgentTeamAddress(handoff.from);
   280	    const to = assertAgentTeamAddress(handoff.to);
   281	    if (!(configured.get(from) && "agentRunId" in configured.get(from)!)) {
   282	      throw new Error(`Handoff sender '${from}' is not a configured Agent.`);
   283	    }
   284	    if (!configured.has(to)) throw new Error(`Handoff recipient '${to}' is not configured.`);
   285	  }
   286	};
