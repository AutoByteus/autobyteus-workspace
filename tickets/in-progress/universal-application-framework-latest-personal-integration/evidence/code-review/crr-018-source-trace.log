    68	export class RuntimeMemoryLocationClassifier {
    69	  private readonly layout: AgentMemoryLayout;
    70	  private readonly runMetadataStore: AgentRunMetadataStore;
    71	  private readonly locationService: AgentMemoryLocationService;
    72
    73	  constructor(private readonly memoryDir: string) {
    74	    this.layout = new AgentMemoryLayout(memoryDir);
    75	    this.runMetadataStore = new AgentRunMetadataStore(memoryDir);
    76	    this.locationService = new AgentMemoryLocationService({
