   117	  ], label);
   118	  canonicalAddress(member.address, `${label}.address`);
   119	  required(member.teamDefinitionId, `${label}.teamDefinitionId`);
   120	  nullableString(member.role, `${label}.role`);
   121	  nullableString(member.description, `${label}.description`);
   122	  required(member.teamRunId, `${label}.teamRunId`);
   123	  canonicalAddress(member.coordinatorAddress, `${label}.coordinatorAddress`);
