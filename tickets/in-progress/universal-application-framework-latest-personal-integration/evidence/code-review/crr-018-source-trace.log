   150	    diagnostics: RuntimeMemoryLocationDiagnostic[],
   151	  ): Promise<void> {
   152	    const rootDir = this.layout.getTeamRootDirPath();
   153	    const teamRunIds = await this.listDirectories(rootDir, diagnostics);
   154	    for (const teamRunId of teamRunIds) {
   155	      const metadataPath = getTeamRunExecutionTreePath(
   156	        this.layout.getTeamDirPath({ rootTeamRunId: teamRunId, ancestorTeamRunIds: [] }),
   157	      );
