   149	const validateTaskExecution = (value: unknown, label: string): void => {
   150	  const execution = record(value, label);
   151	  if ("agentRunId" in execution) {
   152	    exactKeys(execution, [
   153	      "address", "agentRunId", "platformAgentRunId", "startedAt", "settledAt",
