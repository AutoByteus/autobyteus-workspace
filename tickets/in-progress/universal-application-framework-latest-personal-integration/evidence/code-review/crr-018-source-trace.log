   153	export class TeamRunExecutionTreeV2AppDataMigration implements AppDataMigrationDefinition {
   154	  readonly id = TEAM_RUN_EXECUTION_TREE_V2_MIGRATION_ID;
   155	  readonly displayName = "Upgrade TeamRun execution trees to V2";
   156	  readonly description = "Materializes a complete effective launch default on every configured TeamRun.";
   157	  readonly requiredOnStartup = true;
   158	  readonly executionPolicy = "ANYTIME" as const;
