    22	export class AppDataMigrationRegistry {
    23	  private readonly definitions: AppDataMigrationDefinition[];
    24
    25	  constructor(definitions?: AppDataMigrationDefinition[]) {
    26	    this.definitions = definitions ?? [
    27	      new CustomProviderV1AppDataMigration(),
    28	      new RemoveGlobalSkillDiscoveryModeMigration(
    29	        appConfigProvider.config.getMemoryDir(),
    30	        appConfigProvider.config.getAppDataDir(),
    31	      ),
    32	      new TeamRunMetadataMemberTreeMigration(appConfigProvider.config.getMemoryDir()),
    33	      new TeamRunExecutionTreeV1AppDataMigration(
    34	        appConfigProvider.config.getMemoryDir(),
    35	        appConfigProvider.config.getAppDataDir(),
    36	      ),
    37	      new TeamAgentMemoryLayoutAppDataMigration(
    38	        appConfigProvider.config.getMemoryDir(),
    39	      ),
    40	      new TeamRunExecutionTreeV2AppDataMigration(
    41	        appConfigProvider.config.getMemoryDir(),
    42	      ),
    43	      new RemoveExternalRuntimeWorkingContextSnapshotsMigration(
    44	        appConfigProvider.config.getMemoryDir(),
    45	      ),
    46	      // Native snapshot conversion resolves provenance through the current raw-trace layout.
    47	      new RawTraceRotationLayoutMigration(appConfigProvider.config.getMemoryDir()),
    48	      new RawTraceActiveFileNameMigration(appConfigProvider.config.getMemoryDir()),
    49	      new MigrateNativeWorkingContextSnapshotsV5Migration(
    50	        appConfigProvider.config.getMemoryDir(),
    51	      ),
    52	      new TeamCommunicationProjectionAddressMigration(appConfigProvider.config.getMemoryDir()),
    53	      new TokenUsageCustomProviderModelValueBackfillMigration(),
    54	      new TokenUsageProviderNameSnapshotBackfillMigration(),
    55	      new TokenUsageRunRecordsV1AppDataMigration(),
    56	      new RemoveSelfEvolutionRunMetadataMigration(appConfigProvider.config.getMemoryDir()),
    57	      new TeamRunHistoryIndexV2AppDataMigration(appConfigProvider.config.getMemoryDir()),
    58	      new RunHistoryIndexV2AppDataMigration(appConfigProvider.config.getMemoryDir()),
    59	      new CustomProviderReadableIdAppDataMigration(),
    60	    ];
    61	    this.validateDefinitions();
    62	  }
    63
    64	  listDefinitions(): AppDataMigrationDefinition[] {
    65	    return [...this.definitions];
    66	  }
    67
    68	  getDefinition(migrationId: string): AppDataMigrationDefinition | null {
    69	    const normalized = migrationId.trim();
    70	    return this.definitions.find((definition) => definition.id === normalized) ?? null;
    71	  }
    72
    73	  private validateDefinitions(): void {
    74	    const seen = new Set<string>();
    75	    for (const definition of this.definitions) {
    76	      if (!definition.id.trim()) {
    77	        throw new Error("App data migration ID is required.");
    78	      }
    79	      if (seen.has(definition.id)) {
    80	        throw new Error(`Duplicate app data migration ID '${definition.id}'.`);
    81	      }
    82	      const uniquePrerequisites = new Set<string>();
    83	      for (const prerequisiteId of definition.prerequisiteMigrationIds ?? []) {
    84	        if (!prerequisiteId.trim()) {
    85	          throw new Error(`App data migration '${definition.id}' has an empty prerequisite ID.`);
    86	        }
    87	        if (uniquePrerequisites.has(prerequisiteId)) {
    88	          throw new Error(
    89	            `App data migration '${definition.id}' repeats prerequisite '${prerequisiteId}'.`,
    90	          );
    91	        }
    92	        if (!seen.has(prerequisiteId)) {
    93	          throw new Error(
    94	            `App data migration '${definition.id}' prerequisite '${prerequisiteId}' must be registered earlier.`,
    95	          );
    96	        }
    97	        uniquePrerequisites.add(prerequisiteId);
    98	      }
    99	      seen.add(definition.id);
   100	    }
   101	  }
   102	}
