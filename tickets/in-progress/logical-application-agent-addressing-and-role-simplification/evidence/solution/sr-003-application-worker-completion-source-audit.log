     1	import readline from "node:readline";
     2	import { ApplicationWorkerHostBridgeClient } from "./application-worker-host-bridge-client.js";
     3	import { ApplicationBackendHost } from "./application-backend-host.js";
     4	import { JsonLineFrameWriter } from "../runtime/json-line-frame-writer.js";
     5	import {
     6	  APPLICATION_ENGINE_METHOD_EXECUTE_GRAPHQL,
     7	  APPLICATION_ENGINE_METHOD_GET_STATUS,
     8	  APPLICATION_ENGINE_METHOD_INVOKE_ARTIFACT_HANDLER,
     9	  APPLICATION_ENGINE_METHOD_INVOKE_COMMAND,
    10	  APPLICATION_ENGINE_METHOD_INVOKE_EVENT_HANDLER,
    11	  APPLICATION_ENGINE_METHOD_INVOKE_QUERY,
    12	  APPLICATION_ENGINE_METHOD_LOAD_DEFINITION,
    13	  APPLICATION_ENGINE_METHOD_ROUTE_REQUEST,
    14	  APPLICATION_ENGINE_METHOD_STOP,
    15	  APPLICATION_ENGINE_NOTIFICATION_METHOD,
    16	  APPLICATION_ENGINE_METHOD_OPEN_WEBSOCKET,
    17	  APPLICATION_ENGINE_METHOD_WEBSOCKET_MESSAGE,
    18	  APPLICATION_ENGINE_METHOD_CLOSE_WEBSOCKET,
    19	  APPLICATION_ENGINE_NOTIFICATION_AGENT_STREAM_EVENT,
    20	  APPLICATION_ENGINE_NOTIFICATION_AGENT_STREAM_ERROR,
    21	  APPLICATION_ENGINE_NOTIFICATION_AGENT_STREAM_CLOSED,
    22	  type ApplicationWorkerNotificationParams,
    23	} from "../runtime/protocol.js";
    24
    25	type JsonRpcRequest = {
    26	  jsonrpc?: string;
    27	  id?: string | number | null;
    28	  method?: string;
    29	  params?: Record<string, unknown>;
    30	  result?: unknown;
    31	  error?: { message?: string };
    32	};
    33
    34	const frameWriter = new JsonLineFrameWriter(process.stdout);
    35	const writeFrame = (frame: Record<string, unknown>): Promise<void> => frameWriter.write(frame);
    36
    37	const hostBridgeClient = new ApplicationWorkerHostBridgeClient(writeFrame);
    38	const runtime = new ApplicationBackendHost(
    39	  async (params: ApplicationWorkerNotificationParams) => {
    40	    await writeFrame({
    41	      jsonrpc: "2.0",
    42	      method: APPLICATION_ENGINE_NOTIFICATION_METHOD,
    43	      params,
    44	    });
    45	  },
    46	  async (input) => hostBridgeClient.invokeContextCapability(input),
    47	  async (input) => hostBridgeClient.invokeWebSocketAction(input),
    48	);
    49
    50	const respondSuccess = async (id: string | number | null, result: unknown): Promise<void> => {
    51	  await writeFrame({ jsonrpc: "2.0", id, result });
    52	};
    53
    54	const respondError = async (id: string | number | null, message: string): Promise<void> => {
    55	  await writeFrame({
    56	    jsonrpc: "2.0",
    57	    id,
    58	    error: { message },
    59	  });
    60	};
    61
    62	const rl = readline.createInterface({
    63	  input: process.stdin,
    64	  crlfDelay: Infinity,
    65	});
    66
    67	rl.on("line", async (line) => {
    68	  if (!line.trim()) {
    69	    return;
    70	  }
    71
    72	  let request: JsonRpcRequest;
    73	  try {
    74	    request = JSON.parse(line) as JsonRpcRequest;
    75	  } catch (error) {
    76	    await respondError(null, `Invalid JSON request: ${String(error)}`);
    77	    return;
    78	  }
    79
    80	  if (!request.method && hostBridgeClient.handleResponse(request as Record<string, unknown>)) {
    81	    return;
    82	  }
    83
    84	  const id = request.id ?? null;
    85	  const method = request.method ?? "";
    86	  const params = request.params ?? {};
    87
    88	  if (id === null) {
    89	    if (method === APPLICATION_ENGINE_NOTIFICATION_AGENT_STREAM_EVENT) runtime.dispatchAgentStreamEvent(params);
    90	    if (method === APPLICATION_ENGINE_NOTIFICATION_AGENT_STREAM_ERROR) runtime.dispatchAgentStreamError(params);
    91	    if (method === APPLICATION_ENGINE_NOTIFICATION_AGENT_STREAM_CLOSED) runtime.dispatchAgentStreamClosed(params);
    92	    return;
    93	  }
    94
    95	  try {
    96	    switch (method) {
    97	      case APPLICATION_ENGINE_METHOD_LOAD_DEFINITION:
    98	        await respondSuccess(id, await runtime.loadDefinition(params as never));
    99	        break;
   100	      case APPLICATION_ENGINE_METHOD_GET_STATUS:
   101	        await respondSuccess(id, runtime.getStatus());
   102	        break;
   103	      case APPLICATION_ENGINE_METHOD_INVOKE_QUERY:
   104	        await respondSuccess(id, await runtime.invokeQuery(params as never));
   105	        break;
   106	      case APPLICATION_ENGINE_METHOD_INVOKE_COMMAND:
   107	        await respondSuccess(id, await runtime.invokeCommand(params as never));
   108	        break;
   109	      case APPLICATION_ENGINE_METHOD_ROUTE_REQUEST:
   110	        await respondSuccess(id, await runtime.routeRequest(params as never));
   111	        break;
   112	      case APPLICATION_ENGINE_METHOD_EXECUTE_GRAPHQL:
   113	        await respondSuccess(id, await runtime.executeGraphql(params as never));
   114	        break;
   115	      case APPLICATION_ENGINE_METHOD_INVOKE_EVENT_HANDLER:
   116	        await respondSuccess(id, await runtime.invokeEventHandler(params as never));
   117	        break;
   118	      case APPLICATION_ENGINE_METHOD_INVOKE_ARTIFACT_HANDLER:
   119	        await respondSuccess(id, await runtime.invokeArtifactHandler(params as never));
   120	        break;
   121	      case APPLICATION_ENGINE_METHOD_OPEN_WEBSOCKET:
   122	        await runtime.openWebSocket(params as never);
   123	        await respondSuccess(id, { opened: true });
   124	        break;
   125	      case APPLICATION_ENGINE_METHOD_WEBSOCKET_MESSAGE:
   126	        await runtime.deliverWebSocketMessage(params as never);
   127	        await respondSuccess(id, { delivered: true });
   128	        break;
   129	      case APPLICATION_ENGINE_METHOD_CLOSE_WEBSOCKET:
   130	        await runtime.closeWebSocket(params as never);
   131	        await respondSuccess(id, { closed: true });
   132	        break;
   133	      case APPLICATION_ENGINE_METHOD_STOP:
   134	        await runtime.stop();
   135	        await respondSuccess(id, { stopped: true });
   136	        process.exit(0);
   137	        break;
   138	      default:
   139	        await respondError(id, `Unsupported worker method '${method}'.`);
   140	        break;
   141	    }
   142	  } catch (error) {
   143	    await respondError(id, error instanceof Error ? error.message : String(error));
   144	  }
   145	});
   146
   147	rl.on("close", () => {
   148	  void runtime.stop().finally(() => {
   149	    process.exit(0);
   150	  });
   151	});

