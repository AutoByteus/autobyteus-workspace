   112	    const supervisor = new ApplicationWorkerSupervisor();
   113	    const childProcess = supervisor.start({
   114	      cwd: bundle.applicationRootPath,
   115	      stdoutLogPath: layout.workerStdoutLogPath,
   116	      stderrLogPath: layout.workerStderrLogPath,
   117	    });
   118	    const client = new ApplicationEngineClient();
   119	    client.attach(childProcess);
   120	    const handle: ApplicationEngineRuntimeHandle = Object.freeze({
   121	      supervisor,
   122	      client,
   123	    });
   124	    client.registerRequestHandler(
   125	      APPLICATION_ENGINE_METHOD_CONTEXT_CAPABILITY,
   126	      async (params) => this.contextCapabilityHandler.handle(
   127	        applicationId,
   128	        params as unknown as ApplicationWorkerContextCapabilityInput,
   129	        client,
   130	      ),
   131	    );
   132	    client.registerRequestHandler(
   133	      APPLICATION_ENGINE_METHOD_WEBSOCKET_ACTION,
   134	      async (params) => this.dependencies.controller.publishWebSocketAction(
   135	        applicationId,
   136	        params as unknown as ApplicationWorkerWebSocketActionInput,
   137	      ),
   138	    );
   139	    client.onNotification((message) =>
   140	      this.dependencies.controller.publishNotification(applicationId, message));
   141	    client.onClose((error) => {
   142	      if (!this.dependencies.controller.detachIfCurrent(applicationId, handle)) {
   143	        return;
   144	      }
   145	      this.dependencies.agentStreamingService.stopApplication(applicationId);
   146	      this.dependencies.controller.publishWorkerClose(applicationId, error);
   147	      this.dependencies.controller.updateStatus(applicationId, {
   148	        ...createApplicationEngineBaseStatus(applicationId),
   149	        state: error ? "failed" : "stopped",
   150	        lastFailure: error ? error.message : null,
   151	      });
   152	    });
   153	    supervisor.onExit(({ expected, code, signal }) => {
   154	      if (expected || !this.dependencies.controller.detachIfCurrent(applicationId, handle)) {
   155	        return;
   156	      }
   157	      const error = new Error(
   158	        `Application worker exited unexpectedly (code=${String(code)}, signal=${String(signal)}).`,
   159	      );
   160	      this.dependencies.agentStreamingService.stopApplication(applicationId);
   161	      this.dependencies.controller.publishWorkerClose(applicationId, error);
   162	      this.dependencies.controller.updateStatus(applicationId, {
   163	        ...createApplicationEngineBaseStatus(applicationId),
   164	        state: "failed",
   165	        lastFailure: error.message,
   166	      });
   167	    });
   168	    this.dependencies.controller.attach(applicationId, handle);
   169
   170	    try {
   171	      const definition = await client.request<ApplicationWorkerLoadDefinitionResult>(
   172	        APPLICATION_ENGINE_METHOD_LOAD_DEFINITION,
   173	        {
   174	          applicationId,
   175	          entryModulePath: bundle.backend.entryModulePath,
   176	          supportedExposures: bundle.backend.supportedExposures,
   177	          storage: {
   178	            rootPath: layout.rootPath,
   179	            runtimePath: layout.runtimeDir,
   180	            logsPath: layout.logsDir,
   181	            appDatabasePath: layout.appDatabasePath,
   182	            appDatabaseUrl: `file:${layout.appDatabasePath}`,
   183	            assetsPath: bundle.backend.assetsDirPath,
   184	          },
   185	        },
   186	      );
   187	      const status: ApplicationEngineStatus = {
   188	        applicationId,
   189	        state: "ready",
   190	        ready: true,
   191	        startedAt: new Date().toISOString(),
   192	        lastFailure: null,
   193	        exposures: definition.exposures,
   194	      };
   195	      this.dependencies.controller.updateStatus(
   196	        applicationId,
   197	        status,
   198	        layout.engineStatusPath,
   199	      );
   200	      return status;
   201	    } catch (error) {
   202	      this.dependencies.controller.detachIfCurrent(applicationId, handle);
   203	      await client.close();
   204	      await supervisor.stop();
   205	      const failureStatus: ApplicationEngineStatus = {
   206	        ...createApplicationEngineBaseStatus(applicationId),
   207	        state: "failed",
   208	        lastFailure: error instanceof Error ? error.message : String(error),
   209	      };
   210	      this.dependencies.controller.updateStatus(
   211	        applicationId,
   212	        failureStatus,
   213	        layout.engineStatusPath,
   214	      );
   215	      throw error;
   216	    }
   217	  }
