    12	} from "./application-backend-route-handlers.js";
    13
    14	const APPLICATION_BACKEND_ROUTE_BASE = "/applications/:applicationId/backend";
    15
    16	export async function registerApplicationBackendRoutes(
    17	  app: FastifyInstance,
    18	  dependencies: {
    19	    gateway: ApplicationBackendRestContract;
    20	    lifecycle: ApplicationPlatformLifecycleReadiness;
    21	  },
    22	): Promise<void> {
    23	  app.post<{
    24	    Params: { applicationId: string; queryName: string };
    25	    Body: { requestContext?: unknown; input?: unknown };
    26	  }>(`${APPLICATION_BACKEND_ROUTE_BASE}/queries/:queryName`, async (request, reply) => {
    27	    try {
    28	      await dependencies.lifecycle.awaitReady();
    29	      const result = await invokeApplicationQuery({
    30	        gateway: dependencies.gateway,
    31	        applicationId: request.params.applicationId,
    32	        queryName: request.params.queryName,
    33	        value: request.body?.input ?? null,
    34	      });
    35	      return reply.send({ result });
    36	    } catch (error) {
    37	      return sendApplicationRouteError(reply, error);
    38	    }
    39	  });
    40
    41	  app.post<{
    42	    Params: { applicationId: string; commandName: string };
    43	    Body: { requestContext?: unknown; input?: unknown };
    44	  }>(`${APPLICATION_BACKEND_ROUTE_BASE}/commands/:commandName`, async (request, reply) => {
    45	    try {
    46	      await dependencies.lifecycle.awaitReady();
    47	      const result = await invokeApplicationCommand({
    48	        gateway: dependencies.gateway,
    49	        applicationId: request.params.applicationId,
    50	        commandName: request.params.commandName,
    51	        value: request.body?.input ?? null,
    52	      });
    53	      return reply.send({ result });
    54	    } catch (error) {
    55	      return sendApplicationRouteError(reply, error);
    56	    }
    57	  });
    58
    59	  app.post<{
    60	    Params: { applicationId: string };
    61	    Body: { requestContext?: unknown; request: ApplicationGraphqlRequest };
    62	  }>(`${APPLICATION_BACKEND_ROUTE_BASE}/graphql`, async (request, reply) => {
    63	    try {
    64	      await dependencies.lifecycle.awaitReady();
    65	      const result = await invokeApplicationGraphql({
    66	        gateway: dependencies.gateway,
    67	        applicationId: request.params.applicationId,
    68	        request: request.body.request,
    69	      });
    70	      return reply.send({ result });
    71	    } catch (error) {
    72	      return sendApplicationRouteError(reply, error);
    73	    }
    74	  });
    75
    76	  app.route<{
    77	    Params: { applicationId: string } & Record<string, string>;
    78	  }>({
    79	    method: ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
    80	    url: `${APPLICATION_BACKEND_ROUTE_BASE}/routes/*`,
    81	    handler: async (request, reply) => {
    82	      const routePath = `/${request.params["*"] ?? ""}`.replace(/\/+/g, "/");
    83	      const applicationId = request.params.applicationId;
    84	      try {
    85	        await dependencies.lifecycle.awaitReady();
    86	        const result = await invokeApplicationRoute({
    87	          gateway: dependencies.gateway,
    88	          applicationId,
    89	          routePath,
    90	          request,
    91	        });
    92
    93	        const routeResponse = result as { status?: number; headers?: Record<string, string>; body?: unknown };
    94	        if (routeResponse.headers) {
    95	          for (const [key, value] of Object.entries(routeResponse.headers)) {
    96	            reply.header(key, value);
    97	          }
    98	        }
    99	        reply.code(routeResponse.status ?? 200);
   100	        return reply.send(routeResponse.body ?? null);
   101	      } catch (error) {
   102	        return sendApplicationRouteError(reply, error);
   103	      }
   104	    },
   105	  });
   106	}
