   226	    if (method && id !== null) {
   227	      void this.handleWorkerRequest(id, method, (envelope.params ?? {}) as Record<string, unknown>);
   228	      return;
   229	    }
   230
   231	    if (id === null) {
   232	      return;
   233	    }
   234
   235	    const pending = this.pendingRequests.get(id);
   236	    if (!pending) {
   237	      return;
   238	    }
   239	    this.pendingRequests.delete(id);
   240
   241	    if (Object.prototype.hasOwnProperty.call(envelope, "error")) {
   242	      const errorPayload = envelope.error as Record<string, unknown> | undefined;
   243	      const message =
   244	        errorPayload && typeof errorPayload.message === "string"
   245	          ? errorPayload.message
   246	          : "Application worker request failed.";
   247	      pending.reject(new Error(message));
   248	      return;
   249	    }
