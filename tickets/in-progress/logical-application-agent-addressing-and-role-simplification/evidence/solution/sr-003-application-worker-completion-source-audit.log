    90	  async stop(): Promise<void> {
    91	    const current = this.process;
    92	    if (!current) {
    93	      return;
    94	    }
    95	    this.expectedExitProcess = current;
    96	    await new Promise<void>((resolve) => {
    97	      let closed = false;
    98	      const cleanup = () => {
    99	        closed = true;
   100	        current.removeListener("close", cleanup);
   101	        resolve();
   102	      };
   103	      current.once("close", cleanup);
   104	      current.kill("SIGTERM");
   105	      setTimeout(() => {
   106	        if (!closed) {
   107	          current.kill("SIGKILL");
   108	        }
   109	      }, 5_000).unref();
   110	    });
   111	  }
