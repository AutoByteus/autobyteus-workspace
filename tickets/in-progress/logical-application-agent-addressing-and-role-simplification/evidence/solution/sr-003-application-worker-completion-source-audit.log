   209	      return;
   210	    }
   211	    const envelope = payload as Record<string, unknown>;
   212	    const method = typeof envelope.method === "string" ? envelope.method : null;
   213	    const id = typeof envelope.id === "number" || typeof envelope.id === "string" ? envelope.id : null;
