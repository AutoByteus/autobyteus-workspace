   254	  private async handleWorkerRequest(
   255	    id: JsonRpcId,
   256	    method: string,
   257	    params: Record<string, unknown>,
   258	  ): Promise<void> {
   259	    const handler = this.requestHandlers.get(method);
   260	    if (!handler) {
   261	      await this.writeFrame({
   262	        jsonrpc: "2.0",
   263	        id,
   264	        error: { message: `Unsupported worker request '${method}'.` },
   265	      });
   266	      return;
   267	    }
   268
   269	    try {
   270	      const handled = await handler(params);
   271	      const result = handled instanceof ApplicationEngineResponseAfterWrite ? handled.result : handled;
   272	      await this.writeFrame({ jsonrpc: "2.0", id, result });
   273	      if (handled instanceof ApplicationEngineResponseAfterWrite) handled.afterWrite();
   274	    } catch (error) {
   275	      const streamError = error instanceof ApplicationAgentEventStreamSubscribeError ? error : null;
   276	      await this.writeFrame({
   277	        jsonrpc: "2.0",
   278	        id,
   279	        error: {
   280	          message: error instanceof Error ? error.message : String(error),
   281	          ...(streamError ? { code: streamError.code, recoverable: streamError.recoverable } : {}),
   282	        },
   283	      });
   284	    }
   285	  }

