     1	import type { FastifyInstance } from "fastify";
     2	import type {
     3	  ApplicationGraphqlRequest,
     4	} from "@autobyteus/application-sdk-contracts";
     5	import type { ApplicationBackendRestContract, ApplicationPlatformLifecycleReadiness } from "../../application-platform/runtime/application-platform-runtime-contracts.js";
     6	import { sendApplicationRouteError } from "./application-route-error.js";
     7	import {
     8	  invokeApplicationCommand,
     9	  invokeApplicationGraphql,
