   167	  }
   168
   169	  invokeApplicationEventHandler(
   170	    applicationId: string,
   171	    input: ApplicationWorkerInvokeEventHandlerInput,
   172	  ): Promise<ApplicationExecutionEventDispatchResult> {
   173	    return this.request(
   174	      applicationId,
   175	      APPLICATION_ENGINE_METHOD_INVOKE_EVENT_HANDLER,
   176	      input,
   177	    );
   178	  }
   179
   180	  invokeApplicationArtifactHandler(
   181	    applicationId: string,
   182	    input: { event: ApplicationPublishedArtifactEvent },
   183	  ): Promise<ApplicationExecutionEventDispatchResult> {
   184	    return this.request(
   185	      applicationId,
   186	      APPLICATION_ENGINE_METHOD_INVOKE_ARTIFACT_HANDLER,
   187	      input as ApplicationWorkerInvokeArtifactHandlerInput,
   188	    );
   189	  }
   190
   191	  async stopAttachedEngine(applicationId: string): Promise<void> {
   192	    const handle = this.state.getAttachedHandle(applicationId);
   193	    if (!handle) {
   194	      return;
   195	    }
   196	    this.updateStatus(applicationId, {
   197	      ...this.getStatus(applicationId),
   198	      state: "stopping",
   199	      ready: false,
   200	    });
   201	    try {
   202	      await handle.client.request(APPLICATION_ENGINE_METHOD_STOP, {});
   203	    } catch {
   204	      // The worker may already have exited.
   205	    }
   206	    await handle.client.close();
   207	    await handle.supervisor.stop();
   208	    this.detachIfCurrent(applicationId, handle);
   209	    this.updateStatus(applicationId, createApplicationEngineBaseStatus(applicationId));
   210	  }
   211
   212	  clearListeners(): void {
   213	    this.state.clearListeners();
   214	  }
   215
   216	  private request<T>(
   217	    applicationId: string,
   218	    method: string,
   219	    input: unknown,
   220	  ): Promise<T> {
   221	    const handle = this.state.getAttachedHandle(applicationId);
   222	    if (!handle) {
   223	      throw new Error(`Application engine '${applicationId}' is not running.`);
   224	    }
   225	    return handle.client.request<T>(
   226	      method,
   227	      input as Record<string, unknown>,
   228	    );
   229	  }
   230	}

