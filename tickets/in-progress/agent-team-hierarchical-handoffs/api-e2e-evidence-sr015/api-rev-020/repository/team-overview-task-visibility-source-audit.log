FILTER_OWNER:
   123	export const deriveDelegatedTaskEntries = (
   124	  team: AgentTeamContext,
   125	  records: readonly TaskDelegationRecord[] = [],
   126	  focusedAddress?: TeamExecutionAddress | null,
   127	): DelegatedTaskEntry[] => {
   128	  const liveNodes = collectLiveTaskNodes(team.rootTeam.children);
   129	  const byTaskId = new Map(liveNodes.flatMap((node) => node.taskId ? [[node.taskId, node] as const] : []));
   130	  const consumed = new Set<TeamMemberNode>();
   131	  const persisted = records.filter((record) => recordVisible(record, focusedAddress)).map((record) => {
   132	    const node = byTaskId.get(record.taskId) ?? null;
   133	    if (node) consumed.add(node);
   134	    return node ? liveEntry(team, node, record) : persistedEntry(team, record);
   135	  });
   136	  const live = liveNodes.filter((node) => !consumed.has(node)).filter((node) => {
   137	    if (focusedAddress === undefined) return true;
   138	    return addressKey(node.executionAddress) === addressKey(focusedAddress);
   139	  }).map((node) => liveEntry(team, node, null));
   140	  return [...persisted, ...live];
   141	};
