    82	export const buildWorkspaceTeamExecutionDisplayRows = ({ team, teamContext }: BuildWorkspaceTeamExecutionDisplayRowsParams): WorkspaceTeamExecutionDisplayRow[] => {
    83	  const stableSourceRows = team.rootTeam.children.length > 0 ? team.rootTeam.children : team.members;
    84	  if (!teamContext || teamContext.rootTeam.children.length === 0) return flattenStableRows(stableSourceRows);
    85	  const stableRowsByAddress = indexStableRows(stableSourceRows);
    86	  const visit = (nodes: readonly TeamMemberNode[], depth = 0): WorkspaceTeamExecutionDisplayRow[] => nodes.flatMap((node) => {
    87	    if (node.isTaskExecution) {
    88	      return [buildTransientRow(teamContext, node, depth), ...(node.kind === 'agent_team' ? visit(node.children, depth + 1) : [])];
    89	    }
    90	    const stableRow = stableRowsByAddress.get(node.address);
    91	    return [
    92	      ...(stableRow ? [{
    93	        rowKind: 'stable_member' as const,
    94	        teamRunId: stableRow.teamRunId,
    95	        memberAddress: stableRow.memberAddress,
    96	        executionAddress: stableExecution(stableRow.teamRunId, stableRow.memberAddress),
    97	        memberKind: stableRow.kind,
    98	        displayName: stableRow.displayName || stableRow.memberAddress,
    99	        depth,
   100	        row: stableRow,
   101	      }] : []),
   102	      ...(node.kind === 'agent_team' ? visit(node.children, depth + 1) : []),
   103	    ];
   104	  });
   105	  return visit(teamContext.rootTeam.children);
   106	};

