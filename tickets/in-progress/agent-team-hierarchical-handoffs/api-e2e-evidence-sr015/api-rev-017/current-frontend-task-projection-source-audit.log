     8	export type TaskExecutionProjectionMessageResult =
     9	  | { outcome: 'continue'; taskAgentIdentity?: TaskAgentStreamIdentity | null }
    10	  | { outcome: 'handled'; taskAgentIdentity?: TaskAgentStreamIdentity | null; cleanupTaskTeamRunId?: string | null }
    11	  | { outcome: 'drop'; reason: string }
    12	  | { outcome: 'memberContext'; context: AgentContext; taskAgentIdentity?: TaskAgentStreamIdentity | null; cleanupTaskTeamRunId?: string | null };
