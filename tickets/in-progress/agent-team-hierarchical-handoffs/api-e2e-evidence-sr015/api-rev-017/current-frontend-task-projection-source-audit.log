    14	export const handleTaskExecutionProjectionMessage = (
    15	  team: AgentTeamContext,
    16	  message: ServerMessage,
    17	): TaskExecutionProjectionMessageResult => {
    18	  const raw = 'payload' in message && message.payload && typeof message.payload === 'object'
    19	    ? (message.payload as { execution_address?: unknown }).execution_address
    20	    : null;
    21	  if (!raw) return message.type === 'TASK_DELEGATION_EVENT' ? { outcome: 'handled' } : { outcome: 'continue' };
    22	  let address;
    23	  try { address = createTeamExecutionAddress(raw as never); }
    24	  catch { return { outcome: 'drop', reason: 'Team event contains an invalid execution_address.' }; }
    25	  if (address.rootTeamRunId !== team.teamRunId) return { outcome: 'drop', reason: 'Team event execution_address selects another root TeamRun.' };
    26	  const taskAgentIdentity = extractTaskAgentIdentity(message);
    27	  if (taskAgentIdentity) {
    28	    const context = ensureTaskAgentContext(team, taskAgentIdentity);
    29	    return message.type === 'TASK_DELEGATION_EVENT'
    30	      ? { outcome: 'handled', taskAgentIdentity }
    31	      : { outcome: 'memberContext', context, taskAgentIdentity };
    32	  }
    33	  if (address.taskTeamRunIds.length) {
    34	    const context = ensureTaskTeamMemberExecutionContext(team, address);
    35	    if (!context) return message.type === 'TASK_DELEGATION_EVENT' ? { outcome: 'handled' } : { outcome: 'drop', reason: `No Agent exists at '${address.memberAddress}'.` };
    36	    return message.type === 'TASK_DELEGATION_EVENT' ? { outcome: 'handled' } : { outcome: 'memberContext', context };
    37	  }
    38	  return message.type === 'TASK_DELEGATION_EVENT' ? { outcome: 'handled' } : { outcome: 'continue' };
    39	};
