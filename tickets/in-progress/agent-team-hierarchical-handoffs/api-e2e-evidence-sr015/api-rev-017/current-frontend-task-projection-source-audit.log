    34	const update = (value: unknown): TaskDelegationUpdate | null => {
    35	  const item = object(value);
    36	  if (!item) return null;
    37	  const sender = (() => { try { return parseTeamExecutionAddress(item.senderAddress); } catch { return null; } })();
    38	  const receiver = (() => { try { return parseTeamExecutionAddress(item.receiverAddress); } catch { return null; } })();
    39	  const referenceFiles = references(item.referenceFiles);
    40	  const createdAt = text(item.createdAt);
    41	  if (!sender || !receiver || !referenceFiles || !createdAt) return null;
    42	  if (item.kind === 'submission') {
    43	    const submissionId = text(item.submissionId);
    44	    const content = text(item.content);
    45	    return submissionId && content ? {
    46	      kind: 'submission', submissionId, senderAddress: sender, receiverAddress: receiver,
    47	      content, referenceFiles, createdAt,
    48	    } satisfies TaskDelegationSubmissionUpdate : null;
    49	  }
    50	  if (item.kind === 'review') {
    51	    const reviewId = text(item.reviewId);
    52	    const reviewedSubmissionId = text(item.reviewedSubmissionId);
    53	    const decision = item.decision;
    54	    return reviewId && reviewedSubmissionId && (decision === 'accept' || decision === 'request_revision') ? {
    55	      kind: 'review', reviewId, senderAddress: sender, receiverAddress: receiver,
    56	      reviewedSubmissionId, decision, content: text(item.content), referenceFiles, createdAt,
    57	    } satisfies TaskDelegationReviewUpdate : null;
    58	  }
    59	  return null;
    60	};
