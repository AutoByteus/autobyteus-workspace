    94	export const useTaskDelegationStore = defineStore('taskDelegation', {
    95	  state: (): TaskDelegationState => ({ recordsByTeam: new Map() }),
    96	  getters: {
    97	    getRecordsForTeam: (state) => (teamRunId: string): TaskDelegationRecord[] =>
    98	      [...(state.recordsByTeam.get(teamRunId) ?? [])].sort((a, b) => b.createdAt.localeCompare(a.createdAt) || a.taskId.localeCompare(b.taskId)),
    99	  },
   100	  actions: {
   101	    replaceRecords(teamRunId: string, records: unknown[]) {
   102	      this.recordsByTeam.set(teamRunId, records.map(normalizeTaskDelegationRecord).filter((record): record is TaskDelegationRecord => Boolean(record)));
   103	    },
   104	  },
   105	});

