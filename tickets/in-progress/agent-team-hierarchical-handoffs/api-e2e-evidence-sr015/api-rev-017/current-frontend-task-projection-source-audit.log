    62	export const normalizeTaskDelegationRecord = (value: unknown): TaskDelegationRecord | null => {
    63	  const item = object(value);
    64	  if (!item || !Array.isArray(item.updates)) return null;
    65	  const taskId = text(item.taskId);
    66	  const status = text(item.status) as TaskDelegationStatus | null;
    67	  const receiverTargetKind = item.receiverTargetKind;
    68	  const content = text(item.content);
    69	  const referenceFiles = references(item.referenceFiles);
    70	  const createdAt = text(item.createdAt);
    71	  const updates = item.updates.map(update);
    72	  let senderAddress;
    73	  let receiverAddress;
    74	  try {
    75	    senderAddress = parseTeamExecutionAddress(item.senderAddress);
    76	    receiverAddress = parseTeamExecutionAddress(item.receiverAddress);
    77	  } catch { return null; }
    78	  if (!taskId || !status || !['active', 'awaiting_review', 'accepted'].includes(status) ||
    79	    (receiverTargetKind !== 'agent' && receiverTargetKind !== 'agent_team') || !content || !referenceFiles ||
    80	    !createdAt || updates.some((entry) => !entry)) return null;
    81	  let taskRun = null;
    82	  if (item.taskRun !== null) {
    83	    const rawTaskRun = object(item.taskRun);
    84	    const startedAt = text(rawTaskRun?.startedAt);
    85	    if (!rawTaskRun || !startedAt) return null;
    86	    try { taskRun = { address: parseTeamExecutionAddress(rawTaskRun.address), startedAt }; } catch { return null; }
    87	  }
    88	  return {
    89	    taskId, status, senderAddress, receiverAddress, receiverTargetKind, content,
    90	    referenceFiles, taskRun, updates: updates as TaskDelegationUpdate[], createdAt,
    91	  };
    92	};
