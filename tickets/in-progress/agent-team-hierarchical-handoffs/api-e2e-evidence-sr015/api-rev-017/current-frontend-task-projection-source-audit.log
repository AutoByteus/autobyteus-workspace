    46	export const parseTeamExecutionAddress = (value: unknown): TeamExecutionAddress => {
    47	  if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('TeamExecutionAddress object required.');
    48	  const record = value as Record<string, unknown>;
    49	  const keys = ['rootTeamRunId', 'taskTeamRunIds', 'memberAddress', 'taskAgentRunId'];
    50	  if (Object.keys(record).length !== keys.length || !keys.every((key) => Object.hasOwn(record, key))) {
    51	    throw new Error('TeamExecutionAddress must contain exactly rootTeamRunId, taskTeamRunIds, memberAddress, and taskAgentRunId.');
    52	  }
    53	  if (typeof record.rootTeamRunId !== 'string' || !Array.isArray(record.taskTeamRunIds) ||
    54	    !record.taskTeamRunIds.every((item) => typeof item === 'string') || typeof record.memberAddress !== 'string' ||
    55	    (record.taskAgentRunId !== null && typeof record.taskAgentRunId !== 'string')) {
    56	    throw new Error('Invalid TeamExecutionAddress field types.');
    57	  }
    58	  return createTeamExecutionAddress(record as unknown as TeamExecutionAddress);
    59	};
    60	
    61	export const serializeTeamExecutionAddress = (address: TeamExecutionAddress): string =>
    62	  JSON.stringify(createTeamExecutionAddress(address));
    63	
    64	export const sameTeamExecutionAddress = (left: TeamExecutionAddress, right: TeamExecutionAddress): boolean =>
    65	  serializeTeamExecutionAddress(left) === serializeTeamExecutionAddress(right);
    66	
    67	export const memberAddressBasename = (address: string): string =>
    68	  address === '/' ? '/' : address.split('/').filter(Boolean).at(-1) ?? address;

