     8	export interface TaskTeamExecutionProjectionIdentity { executionAddress: TeamExecutionAddress }
     9	export const extractTaskTeamIdentity = (message: ServerMessage): TaskTeamExecutionProjectionIdentity | null => {
    10	  const raw = 'payload' in message && message.payload && typeof message.payload === 'object'
    11	    ? (message.payload as { execution_address?: unknown }).execution_address
    12	    : null;
    13	  if (!raw) return null;
    14	  try {
    15	    const executionAddress = createTeamExecutionAddress(raw as never);
    16	    return executionAddress.taskTeamRunIds.length ? { executionAddress } : null;
    17	  } catch { return null; }
    18	};
    19	export const ensureTaskTeamMemberExecutionContext = (team: AgentTeamContext, address: TeamExecutionAddress): AgentContext | null => {
    20	  const key = serializeTeamExecutionAddress(address);
    21	  const existing = team.agentExecutionsByKey.get(key); if (existing) return existing;
    22	  const node = team.memberNodesByAddress.get(address.memberAddress);
    23	  if (!node || node.kind !== 'agent') return null;
    24	  let base: AgentContext | null = null;
    25	  for (const [candidateKey, context] of team.agentExecutionsByKey) {
    26	    try { if ((JSON.parse(candidateKey) as TeamExecutionAddress).memberAddress === address.memberAddress) { base = context; break; } }
    27	    catch { /* exact keys only */ }
    28	  }
    29	  if (!base) return null;
    30	  const now = new Date().toISOString();
    31	  const conversation: Conversation = {
    32	    id: key, messages: [], createdAt: now, updatedAt: now,
    33	    agentDefinitionId: base.config.agentDefinitionId, agentName: base.config.agentDefinitionName,
    34	    llmModelIdentifier: base.config.llmModelIdentifier,
    35	  };
    36	  const context = new AgentContext({ ...base.config, isLocked: true }, new AgentRunState(key, conversation));
    37	  context.isSubscribed = true; team.agentExecutionsByKey = new Map(team.agentExecutionsByKey).set(key, context); return context;
    38	};
    39	export const ensureTaskTeamExecutionProjection = (team: AgentTeamContext, identity: TaskTeamExecutionProjectionIdentity): SubTeamMemberNode | null => {
    40	  const node = team.memberNodesByAddress.get(identity.executionAddress.memberAddress); return node?.kind === 'agent_team' ? node : null;
    41	};
    42	export const updateTaskTeamExecutionProjectionFromEvent = (team: AgentTeamContext, message: ServerMessage) => {
    43	  const identity = extractTaskTeamIdentity(message); const node = identity ? ensureTaskTeamExecutionProjection(team, identity) : null;
    44	  return node ? { node, shouldCleanup: false } : null;
    45	};
    46	export const removeTaskTeamExecutionProjection = (team: AgentTeamContext, taskTeamRunId: string): void => {
    47	  const next = new Map(team.agentExecutionsByKey);
    48	  for (const key of next.keys()) {
    49	    try { if ((JSON.parse(key) as TeamExecutionAddress).taskTeamRunIds.includes(taskTeamRunId)) next.delete(key); }
    50	    catch { /* exact keys only */ }
    51	  }
    52	  team.agentExecutionsByKey = next;
    53	};

