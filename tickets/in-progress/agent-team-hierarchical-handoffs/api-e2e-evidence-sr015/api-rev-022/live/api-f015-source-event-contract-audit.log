     1	import type { AgentContext } from '~/types/agent/AgentContext';
     2	import type { AgentTeamContext } from '~/types/agent/AgentTeamContext';
     3	import type { ServerMessage } from './protocol';
     4	import {
     5	  parseTeamExecutionAddress,
     6	  serializeTeamExecutionAddress,
     7	  type TeamExecutionAddress,
     8	} from '~/types/agent/TeamExecutionAddress';
     9	
    10	export interface TeamStreamMemberContextResolution {
    11	  context: AgentContext;
    12	  executionAddress: TeamExecutionAddress;
    13	}
    14	
    15	/** Read-only exact lookup after the task projection router has completed any ensure/repair. */
    16	export const resolveTeamStreamMemberContext = (
    17	  teamContext: AgentTeamContext,
    18	  message: ServerMessage,
    19	): TeamStreamMemberContextResolution | null => {
    20	  const payload = 'payload' in message && message.payload && typeof message.payload === 'object'
    21	    ? message.payload as { execution_address?: unknown }
    22	    : null;
    23	  if (!payload?.execution_address) return null;
    24	  try {
    25	    const executionAddress = parseTeamExecutionAddress(payload.execution_address);
    26	    if (executionAddress.rootTeamRunId !== teamContext.teamRunId) return null;
    27	    const context = teamContext.agentExecutionsByKey.get(serializeTeamExecutionAddress(executionAddress)) ?? null;
    28	    return context ? { context, executionAddress } : null;
    29	  } catch {
    30	    return null;
    31	  }
    32	};

