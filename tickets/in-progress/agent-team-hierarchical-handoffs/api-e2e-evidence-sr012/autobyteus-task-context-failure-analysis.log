     7	import type { TaskDelegationToolContext } from "./task-delegation-tool-contract.js";
     8	
     9	type NativeTeamContext = {
    10	  teamRunId?: unknown;
    11	  teamDefinitionId?: unknown;
    12	  teamName?: unknown;
    13	  memberAddress?: unknown;
    14	  agentRunId?: unknown;
    15	  coordinatorAddress?: unknown;
    16	  executionAddress?: TeamExecutionAddress | null;
    17	  addressing?: { rootTeamRunId?: unknown; memberAddress?: unknown };
    18	  taskAgentInstance?: TaskAgentInstanceIdentity | null;
    19	  taskTeamInstance?: TaskTeamInstanceIdentity | null;
    20	};
    21	export type NativeTaskDelegationToolExecutionContext = {
    22	  customData?: { teamContext?: NativeTeamContext };
    23	};
    24	const required = (value: unknown, field: string): string => {
    25	  const normalized = typeof value === "string" ? value.trim() : "";
    26	  if (!normalized) throw new TaskDelegationError("TEAM_RUN_CONTEXT_REQUIRED", `Task delegation tools require ${field} in team context.`);
    27	  return normalized;
    28	};
    29	const optional = (value: unknown): string | null => typeof value === "string" && value.trim() ? value.trim() : null;
    30	
    31	export const buildTaskDelegationToolContextFromNativeContext = (
    32	  context: NativeTaskDelegationToolExecutionContext,
    33	): TaskDelegationToolContext => {
    34	  const team = context.customData?.teamContext;
    35	  if (!team?.addressing || !team.executionAddress) {
    36	    throw new TaskDelegationError("TEAM_RUN_CONTEXT_REQUIRED", "Task delegation tools require an active Team collaboration context.");
    37	  }
    38	  const addressing = createMemberLogicalAddressContext({
    39	    rootTeamRunId: required(team.addressing.rootTeamRunId, "addressing.rootTeamRunId"),
    40	    memberAddress: required(team.addressing.memberAddress, "addressing.memberAddress"),
    41	  });
    42	  return {
    43	    teamRunId: required(team.teamRunId, "teamRunId"),
    44	    teamDefinitionId: optional(team.teamDefinitionId),
    45	    teamName: optional(team.teamName),
    46	    caller: {
    47	      executionAddress: createTeamExecutionAddress(team.executionAddress),
    48	      agentRunId: required(team.agentRunId, "agentRunId"),
    49	      taskAgentInstance: team.taskAgentInstance ? cloneTaskAgentInstanceIdentity(team.taskAgentInstance) : null,
    50	      taskTeamInstance: team.taskTeamInstance ? cloneTaskTeamInstanceIdentity(team.taskTeamInstance) : null,
    51	    },
    52	    coordinatorAddress: optional(team.coordinatorAddress) ? assertAgentTeamAddress(optional(team.coordinatorAddress)!) : null,
    53	    addressing,
    54	  };
    55	};
