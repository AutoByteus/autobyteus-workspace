+import { describe, expect, it } from "vitest";
+import { StreamEventType } from "autobyteus-ts";
+import { AutoByteusStreamEventConverter } from "../../../src/agent-execution/backends/autobyteus/events/autobyteus-stream-event-converter.js";
+import {
+  AgentRunEventType,
+  type AgentRunEvent,
+} from "../../../src/agent-execution/domain/agent-run-event.js";
+import { createTeamAgentExecutionBinding } from "../../../src/agent-team-execution/domain/team-agent-execution-binding.js";
+import { createTeamExecutionAddress } from "../../../src/agent-team-execution/domain/team-execution-address.js";
+import { TeamAgentEventAdapter } from "../../../src/agent-team-execution/services/team-agent-event-adapter.js";
+import { projectTeamAgentEventMessage } from "../../../src/services/agent-streaming/team-agent-event-websocket-projector.js";
+
+const executionAddress = createTeamExecutionAddress({
+  rootTeamRunId: "root-team-run",
+  taskTeamRunIds: [],
+  memberAddress: "/Teacher",
+  taskAgentRunId: null,
+});
+
+const execution = createTeamAgentExecutionBinding({
+  executionAddress,
+  agentRunId: "teacher-agent-run",
+});
+
+describe("AutoByteus Team segment admission", () => {
+  it.each([
+    {
+      nativeType: "SEGMENT_START",
+      eventType: AgentRunEventType.SEGMENT_START,
+      segmentId: "segment-start",
+      nestedPayload: { segment_type: "assistant_text", metadata: { role: "assistant" } },
+    },
+    {
+      nativeType: "SEGMENT_CONTENT",
+      eventType: AgentRunEventType.SEGMENT_CONTENT,
+      segmentId: "segment-content",
+      nestedPayload: { segment_type: "assistant_text", delta: "visible content" },
+    },
+    {
+      nativeType: "SEGMENT_END",
+      eventType: AgentRunEventType.SEGMENT_END,
+      segmentId: "segment-end",
+      nestedPayload: { interrupted: false, failed: false, metadata: { completed: true } },
+    },
+  ])(
+    "preserves $nativeType identity through converter, Team admission, and strict wire projection",
+    ({ nativeType, eventType, segmentId, nestedPayload }) => {
+      const converted = new AutoByteusStreamEventConverter("teacher-agent-run").convert({
+        event_type: StreamEventType.SEGMENT_EVENT,
+        data: {
+          event_type: nativeType,
+          segment_id: segmentId,
+          segment_type: "assistant_text",
+          turn_id: "turn-1",
+          payload: nestedPayload,
+        },
+      } as any);
+
+      expect(converted).toMatchObject({
+        runId: "teacher-agent-run",
+        eventType,
+        payload: { id: segmentId, turn_id: "turn-1" },
+      });
+      expect(converted?.payload).not.toHaveProperty("segment_id");
+      expect(converted?.payload).not.toHaveProperty("segmentId");
+
+      const admitted = new TeamAgentEventAdapter(() => executionAddress).adapt(converted!);
+      expect(admitted.kind).toBe("publish");
+      if (admitted.kind !== "publish") throw new Error(`Unexpected Team admission result: ${JSON.stringify(admitted)}`);
+      expect(admitted.event.details).toMatchObject({ segmentId });
+
+      const wire = projectTeamAgentEventMessage(execution, admitted.event);
+      expect(wire).toMatchObject({
+        type: eventType,
+        payload: {
+          segment_id: segmentId,
+          agent_execution: {
+            kind: "persistent_agent",
+            execution_address: {
+              root_team_run_id: "root-team-run",
+              task_team_run_ids: [],
+              member_address: "/Teacher",
+              task_agent_run_id: null,
+            },
+          },
+        },
+      });
+      expect(wire.payload).not.toHaveProperty("id");
+      expect(wire.payload).not.toHaveProperty("segmentId");
+    },
+  );
+
+  it.each([
+    ["snake_case", { segment_id: "alias-only" }],
