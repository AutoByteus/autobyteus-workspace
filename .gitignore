node_modules/
.DS_Store
tmp/
**/__pycache__/
*.pyc
.autobyteus/development/
.local/*
!.local/*.example

# Preserve saved personal Docker state after retiring its source harness.
docker/.runtime/

# Apple/iOS signing material and App Store Connect API credentials.
# Keep these under .local/ios-signing/ when needed locally; never commit them.
*.mobileprovision
*.p12
*.p8
*.cer
*.csr
ios_distribution_private_key.key
ios_distribution_certificate_p12_password.txt

# Secret-bearing local files. API keys and tokens live in .env files and
# runtime databases (server data folders, test.db); commit only *.example
# templates. Files tracked on purpose before this rule (non-secret defaults
# such as autobyteus-web/.env) stay tracked. To add a new one, first confirm it
# holds no secret, then use `git add -f`.
.env
.env.*
*.env
!*.example
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

autobyteus-server-ts/agents/
autobyteus-server-ts/applications/
autobyteus-server-ts/agent-teams/
autobyteus-server-ts/extensions/
autobyteus-server-ts/prisma/dev.db
autobyteus-web/dist-mobile/
autobyteus-android/.gradle/
autobyteus-android/local.properties
autobyteus-android/**/build/
# iOS local/generated artifacts
autobyteus-ios/AutoByteusMobile.xcodeproj/
autobyteus-ios/build/
autobyteus-ios/DerivedData/
autobyteus-ios/**/*.xcuserstate
autobyteus-ios/**/*.xcuserdata/
autobyteus-ios/**/*.xcresult/

# Ticket/evidence hygiene: keep durable summaries/logs/reports in git, not raw
# generated tool output or downloaded CI artifact drops.
*.xcresult/
tickets/**/*.xcresult/
tickets/**/github-run-*-artifacts/
tickets/**/github-run-*-artifacts/**/*.zip
tickets/**/github-run-*-artifacts/**/*.ipa
tickets/**/github-run-*-artifacts/**/*.app/
