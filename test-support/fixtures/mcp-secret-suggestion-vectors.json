    { "field": "env:client_secret", "value": "test-dummy", "expected": "NAME" },
    { "field": "env:DB_PASSWORD", "value": "test-dummy", "expected": "NAME" },
    { "field": "env:SMTP_PASS", "value": "test-dummy", "expected": "NAME" },
    { "field": "env:GOOGLE_CREDENTIALS", "value": "test-dummy", "expected": "NAME" },
    { "field": "header:X-Auth-Header", "value": "test-dummy", "expected": "NAME" },
    { "field": "header:X-Api-Key", "value": "test-dummy", "expected": "NAME" },
    { "field": "env:TOKEN_LIMIT", "value": "4096", "expected": "NAME" },
    { "field": "env:GH", "value": "github_pat_TESTDUMMY", "expected": "VALUE_PREFIX" },
